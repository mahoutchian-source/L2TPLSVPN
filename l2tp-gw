#!/bin/bash
# l2tp-gw - manage L2TP/IPsec client tunnels (this server -> MikroTik routers)
#
#   l2tp-gw setup          one-time server preparation (packages, NAT, forwarding)
#   l2tp-gw add            add or replace a site (asks questions)
#   l2tp-gw remove NAME    remove a site
#   l2tp-gw list           list sites (secrets are not shown)
#   l2tp-gw edit           edit the sites file, then apply
#   l2tp-gw apply          regenerate all config from the sites file and restart services
#   l2tp-gw status         show IPsec, ppp interfaces, routes and NAT rules
#   l2tp-gw check          health check of everything (services, IPsec, PPP, ESP, routes, NAT)
#   l2tp-gw mtu-test NAME|ADDRESS [IFACE]   measure the biggest packet that passes (a connected site, or any address)
#   l2tp-gw reconnect NAME reconnect ONE site (other tunnels are not touched)
#   l2tp-gw cut NAME       cut ONE connection so new settings are used (dial-in: disconnect, outgoing: reconnect)
#   l2tp-gw cut-all in|out cut all dial-in clients (in) or all outgoing sites (out), one after the other
#   l2tp-gw logs [NAME] [N] last N log lines (only lines about NAME if given)
#   l2tp-gw backup [FILE]  copy the sites file (default: /root/l2tp-gw-sites-DATE.conf)
#   l2tp-gw restore FILE   replace the sites file with FILE (checked first) and apply
#   l2tp-gw watch          run by a timer every minute: Telegram alerts + DDNS check
#   l2tp-gw notify-test    send a test alert
#   l2tp-gw notify TEXT    send TEXT as an alert (silent if alerts are not set up)
#   l2tp-gw timer          install the 1-minute watch timer (every apply does this too)
#   l2tp-gw dialin-sync    apply dial-in site changes (users, routes, NAT) WITHOUT restarting any service
#   l2tp-gw access-sync    rebuild what each dial-in client may reach (internet / other clients / outgoing sites)
#   l2tp-gw disconnect NAME  drop the live session of a dial-in site (the router dials in again if the site is enabled)
#   l2tp-gw version        show the version
#
# All site data lives in ONE file: /etc/l2tp-gw/sites.conf
# Keep a copy of it (it contains secrets). On a new server: paste it back, run "l2tp-gw apply".

set -euo pipefail

: "${CONF_DIR:=/etc/l2tp-gw}"
: "${IPSEC_CONF:=/etc/ipsec.conf}"
: "${IPSEC_D:=/etc/ipsec.d}"
: "${PPP_DIR:=/etc/ppp}"
: "${XL2TPD_CONF:=/etc/xl2tpd/xl2tpd.conf}"
: "${SECRETS:=/etc/ipsec.secrets}"
: "${NO_RESTART:=0}"
VERSION="1.4.4"
SITES="$CONF_DIR/sites.conf"
DIALIN="${DIALIN_FILE:-$CONF_DIR/dialin.conf}"      # settings of the dial-in server (see "dial-in" below)
TAG="# managed by l2tp-gw"
NAME_RE='^[a-z0-9][a-z0-9-]{0,10}$'

die() { echo "ERROR: $*" >&2; exit 1; }
need_root() { [ "$(id -u)" -eq 0 ] || die "Run as root (type: sudo -i)"; }

ike_service() {
  if systemctl cat strongswan-starter.service >/dev/null 2>&1; then
    echo strongswan-starter
  else
    echo strongswan
  fi
}

# ---------- sites file parsing ----------
reset_site() { S_NAME=""; S_HOST=""; S_PSK=""; S_USER=""; S_PASS=""; S_MPPE="no"; S_ROUTES=""; S_NAT="no"
  S_REC_EVERY=""; S_REC_AT=""; S_REC_WIN=""; S_QUOTA=""; S_QPERIOD="day"; S_QDIR="total"; S_QWARN="80"; S_IPSEC_MODE="heal"; S_LCP="on"; S_MTU=""; S_MTU_MIN=""; S_MTU_MAX=""; S_MTU_MARGIN=""; S_MTU_STEP=""; S_TEST_ADDR=""; S_PING_COUNT=""; S_TEST_EVERY=""; S_RTT_BASE=""; S_JIT_BASE=""
  S_POOR_LOSS=""; S_POOR_RTT=""; S_POOR_JITTER=""; S_POOR_ALERT_MIN=""; S_POOR_RECONNECT_MIN=""; S_POOR_COOLDOWN_MIN=""; S_POOR_MAX_DAY=""; S_POOR_WINDOW=""; S_POOR_OUTSIDE=""
  S_MODE="client"; S_IP=""; S_DISABLED="no"; S_ACC_INET="yes"; S_ACC_CLIENTS="yes"; S_ACC_SITES="yes"; }

trim() { sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

for_each_site() {   # calls function "$1" once per [site] block, vars in S_*
  local cb=$1 line key val
  reset_site
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      ''|'#'*|';'*) continue ;;
      \[*\])
        if [ -n "$S_NAME" ]; then "$cb"; fi
        reset_site
        S_NAME="${line#[}"; S_NAME="${S_NAME%]}"
        ;;
      *=*)
        key="$(printf '%s' "${line%%=*}" | trim)"
        val="$(printf '%s' "${line#*=}" | trim)"
        case "$key" in
          host) S_HOST=$val ;;
          psk)  S_PSK=$val ;;
          user) S_USER=$val ;;
          pass) S_PASS=$val ;;
          mppe) S_MPPE=$val ;;
          routes) S_ROUTES=$val ;;
          nat)    S_NAT=$val ;;
          reconnect_every)  S_REC_EVERY=$val ;;
          reconnect_at)     S_REC_AT=$val ;;
          reconnect_window) S_REC_WIN=$val ;;
          quota_gb)         S_QUOTA=$val ;;
          quota_period)     S_QPERIOD=$val ;;
          quota_dir)        S_QDIR=$val ;;
          quota_warn)       S_QWARN=$val ;;
          ipsec_mode)       S_IPSEC_MODE=$val ;;
          lcp_echo)         S_LCP=$val ;;
          mtu)              S_MTU=$val ;;
          mtu_min)          S_MTU_MIN=$val ;;
          mtu_max)          S_MTU_MAX=$val ;;
          mtu_margin)       S_MTU_MARGIN=$val ;;      # (old key, no longer used)
          mtu_step)         S_MTU_STEP=$val ;;      # (old key, no longer used)
          test_addr)        S_TEST_ADDR=$val ;;
          ping_count)       S_PING_COUNT=$val ;;
          test_every)       S_TEST_EVERY=$val ;;
          rtt_base)         S_RTT_BASE=$val ;;
          jit_base)         S_JIT_BASE=$val ;;
          poor_loss)          S_POOR_LOSS=$val ;;
          poor_rtt)           S_POOR_RTT=$val ;;
          poor_jitter)        S_POOR_JITTER=$val ;;
          poor_alert_min)     S_POOR_ALERT_MIN=$val ;;
          poor_reconnect_min) S_POOR_RECONNECT_MIN=$val ;;
          poor_cooldown_min)  S_POOR_COOLDOWN_MIN=$val ;;
          poor_max_day)       S_POOR_MAX_DAY=$val ;;
          poor_window)        S_POOR_WINDOW=$val ;;
          poor_outside)       S_POOR_OUTSIDE=$val ;;
          mode)             S_MODE=$val ;;
          ip)               S_IP=$val ;;
          disabled)         S_DISABLED=$val ;;
          access_internet)  S_ACC_INET=$val ;;
          access_clients)   S_ACC_CLIENTS=$val ;;
          access_sites)     S_ACC_SITES=$val ;;
        esac
        ;;
    esac
  done < "$SITES"
  if [ -n "$S_NAME" ]; then "$cb"; fi
}

# Routes for one site: "172.16.0.0/24 metric 2, 10.5.0.0/16"  (metric optional, default 100)
# Prints one "CIDR METRIC" line per route; stops with an error on bad input.
DEFAULT_METRIC=100
parse_routes() {
  local raw=$1 item cidr kw metric extra o i
  local -a oct
  [ -n "$raw" ] || return 0
  local IFS=','
  for item in $raw; do
    item="$(printf '%s' "$item" | tr -s ' \t' ' ' | trim)"
    [ -n "$item" ] || continue
    cidr=""; kw=""; metric=""; extra=""
    IFS=' ' read -r cidr kw metric extra <<< "$item" || true
    if [ -z "$kw" ]; then
      metric=$DEFAULT_METRIC
    elif [ "$kw" != metric ] || [ -z "$metric" ] || [ -n "$extra" ]; then
      die "Site '$S_NAME': bad route '$item' (write: 172.16.0.0/24 metric 2)"
    fi
    [[ "$cidr" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})/([0-9]{1,2})$ ]] \
      || die "Site '$S_NAME': bad network '$cidr' (write like 172.16.0.0/24)"
    oct=("${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}")
    for i in 0 1 2 3; do
      o=$((10#${oct[$i]}))
      [ "$o" -le 255 ] || die "Site '$S_NAME': bad network '$cidr' (number above 255)"
    done
    [ "$((10#${BASH_REMATCH[5]}))" -le 32 ] || die "Site '$S_NAME': bad network '$cidr' (prefix above 32)"
    [[ "$metric" =~ ^[0-9]{1,5}$ ]] && [ "$((10#$metric))" -le 65535 ] \
      || die "Site '$S_NAME': bad metric '$metric' (use a number 0-65535)"
    printf '%s %s\n' "$cidr" "$((10#$metric))"
  done
}

# Auto reconnect and traffic limit settings of one site (all optional).
#   reconnect_every = 6              hours of continuous uptime, then reconnect (0 or empty = off)
#   reconnect_at = 04:00             reconnect once a day at this time (server time zone setting)
#   reconnect_window = 03:00-05:00   the "every" reconnect only happens inside this window
#   quota_gb = 20                    traffic limit; quota_period = day|week|month
#   quota_dir = total|download|upload   quota_warn = 80 (percent for the first warning)
#   ipsec_mode = heal|allow|require  what to do when PPP is up but there is no IPsec SA (plain L2TP):
#       heal (default)  alert after 2 min and try to repair (reconnect: at most 3 times, 10 min apart)
#       allow           the tunnel may stay without IPsec: no alert, no repair (for peers that cannot do IPsec)
#       require         alert after 30 s and keep repairing every 2 min, never leave it plain; plain UDP 1701 from this
#                       router is also dropped by the firewall (chain L2TPGW-REQ)
#   mtu = 1300          the packet size of this tunnel, 576-1500: ONE fixed number, given to pppd as "mtu" and "mru" (the MRU is what we tell the
#                       far router: "do not send me more than this"; the router's own MRU limits what WE send). Nothing ever changes it while
#                       the tunnel is up: a change is made by disconnecting and connecting again (saving a connection does that).
#                       Empty = the default of Settings (outgoing sites: mtu_default_out). Dial-in clients have no number of their own:
#                       they all get the one number of Settings (mtu_default_in), the same for everybody.
#   mtu_min = 1250      the lowest size the tests go down to (below it only a warning label appears, nothing is cut). Empty = Settings.
#   test_addr = A.B.C.D  (optional) a second address that is tested besides the far end of the tunnel. It gets its own host route
#                       (metric 1) through this tunnel, so it always goes the way of this tunnel. Must be different for every connection.
#   ping_count = 10     pings per test (empty = Settings: ping_count_out / ping_count_in)
#   test_every = 1      minutes between two tests (empty = Settings: test_every_out / test_every_in)
#   rtt_base = 50       delay (ms) that counts as good; 2x orange, 4x red, 6x brown, more black (empty = Settings)
#   jit_base = 20       the same for the delay swing (jitter)
#                       Test by hand with:  l2tp-gw mtu-test NAME    or    l2tp-gw mtu-test ADDRESS INTERFACE
#   lcp_echo = on|off   (outgoing sites, default on) the server sends a PPP "are you alive" every 30 s and ends the
#                       tunnel after 6 missed answers (3 min), so a tunnel that died silently is redialled
validate_automation() {
  local hm='([01][0-9]|2[0-3]):[0-5][0-9]' w="Site '$S_NAME':"
  if [ -n "$S_REC_EVERY" ]; then
    [[ "$S_REC_EVERY" =~ ^[0-9]{1,4}$ ]] && [ "$((10#$S_REC_EVERY))" -le 8760 ] || die "$w reconnect_every must be a whole number of hours (0-8760)"
  fi
  if [ -n "$S_REC_AT" ]; then
    [[ "$S_REC_AT" =~ ^$hm$ ]] || die "$w reconnect_at must look like 04:00"
  fi
  if [ -n "$S_REC_WIN" ]; then
    [[ "$S_REC_WIN" =~ ^$hm-$hm$ ]] || die "$w reconnect_window must look like 03:00-05:00"
  fi
  if [ -n "$S_QUOTA" ]; then
    [[ "$S_QUOTA" =~ ^[0-9]+(\.[0-9]{1,3})?$ ]] && [[ "$S_QUOTA" =~ [1-9] ]] || die "$w quota_gb must be a number above 0 (example: 20 or 2.5)"
  fi
  case "$S_QPERIOD" in day|week|month) ;; *) die "$w quota_period must be day, week or month" ;; esac
  case "$S_QDIR" in total|download|upload) ;; *) die "$w quota_dir must be total, download or upload" ;; esac
  [[ "$S_QWARN" =~ ^[0-9]{1,2}$ ]] && [ "$((10#$S_QWARN))" -ge 1 ] || die "$w quota_warn must be a percent from 1 to 99"
  case "$S_IPSEC_MODE" in ''|heal|allow|require) ;; *) die "$w ipsec_mode must be heal, allow or require" ;; esac
  case "$S_LCP" in ''|on|off) ;; *) die "$w lcp_echo must be on or off" ;; esac
  if [ -n "$S_MTU" ] && [ "$S_MTU" != auto ]; then      # ("auto" of older versions is still read: it means the default of Settings)
    [[ "$S_MTU" =~ ^[0-9]{3,4}$ ]] && [ "$((10#$S_MTU))" -ge 576 ] && [ "$((10#$S_MTU))" -le 1500 ] || die "$w mtu must be a number from 576 to 1500 (empty = the default of Settings)"
  fi
  validate_mtu_range "$w" "$S_MTU_MIN" "" ""
  validate_test_settings "$w" "$S_PING_COUNT" "$S_TEST_EVERY" "$S_RTT_BASE" "$S_JIT_BASE" "$S_TEST_ADDR"
  validate_quality_settings "$w" "$S_POOR_LOSS" "$S_POOR_RTT" "$S_POOR_JITTER" "$S_POOR_ALERT_MIN" "$S_POOR_RECONNECT_MIN" "$S_POOR_COOLDOWN_MIN" "$S_POOR_MAX_DAY" "$S_POOR_WINDOW" "$S_POOR_OUTSIDE"
}

# ---------- dial-in (this server ACCEPTS L2TP/IPsec from routers that cannot be called: no public IP, behind NAT) ----------
# Settings (all in $CONF_DIR/dialin.conf, key = value):
#   enabled   = yes|no     (default no: nothing below is generated, the server behaves exactly as before)
#   public_ip = A.B.C.D    this server's public (static) address: the IKE identity the routers expect
#   psk       = ...        ONE IPsec secret shared by all dial-in routers (the router is unknown until PPP login)
#   pool      = 10.99.99.0/24   private range for the fixed addresses of the routers
#   local     = 10.99.99.1      this server's own address on every dial-in link (inside pool; default: first address)
# A dial-in site is a normal [site] block with   mode = server   and
#   user, pass, ip (fixed address inside pool), routes, nat, disabled = yes|no, quota_*
# Security: UDP 1701 is accepted ONLY when it arrived inside IPsec (iptables chain L2TPGW-IN), except from client-site
# routers whose ipsec_mode allows plain L2TP.
dialin_get() {   # dialin_get KEY [DEFAULT]
  local v=""
  if [ -f "$DIALIN" ]; then v=$(sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$DIALIN" | head -n1 | trim); fi
  printf '%s' "${v:-${2:-}}"
}
dialin_enabled() { [ "$(dialin_get enabled no)" = yes ]; }
ip2int() { local IFS=.; set -- $1; echo $(( ($1 << 24) + ($2 << 16) + ($3 << 8) + $4 )); }
valid_ipv4() {
  local o; is_ipv4 "$1" || return 1
  local IFS=.; for o in $1; do [ "$((10#$o))" -le 255 ] || return 1; done
}
valid_cidr() {   # valid_cidr A.B.C.D/N  (N from 8 to 30)
  local addr len
  [[ "$1" =~ ^([0-9.]+)/([0-9]{1,2})$ ]] || return 1
  addr=${BASH_REMATCH[1]}; len=$((10#${BASH_REMATCH[2]}))     # copied first: valid_ipv4 runs its own regex
  valid_ipv4 "$addr" && [ "$len" -ge 8 ] && [ "$len" -le 30 ]
}
in_cidr() {      # in_cidr IP CIDR
  local len=$((10#${2#*/})) mask
  mask=$(( (0xFFFFFFFF << (32 - len)) & 0xFFFFFFFF ))
  [ $(( $(ip2int "$1") & mask )) -eq $(( $(ip2int "${2%/*}") & mask )) ]
}
dialin_pool()  { dialin_get pool 10.99.99.0/24; }
dialin_local() {
  local l; l=$(dialin_get local)
  if [ -n "$l" ]; then printf '%s' "$l"; return; fi
  local base=${1:-$(dialin_pool)}; base=${base%/*}
  printf '%s.%s' "${base%.*}" "$(( ${base##*.} + 1 ))"
}
# check the settings (only when enabled): dies with a readable message
validate_dialin_settings() {
  local pool local_ip pub psk
  pool=$(dialin_pool); local_ip=$(dialin_local); pub=$(dialin_get public_ip); psk=$(dialin_get psk)
  valid_cidr "$pool" || die "dialin.conf: pool '$pool' is not a network like 10.99.99.0/24 (size /8 to /30)"
  valid_ipv4 "$local_ip" && in_cidr "$local_ip" "$pool" || die "dialin.conf: local '$local_ip' must be an address inside the pool $pool"
  if [ -n "$pub" ]; then valid_ipv4 "$pub" || die "dialin.conf: public_ip '$pub' is not an IPv4 address"; fi
  [ "${#psk}" -ge 8 ] || die "dialin.conf: psk is missing or shorter than 8 characters"
  case "$psk" in *'"'*|*'\'*|*[[:space:]]*) die "dialin.conf: psk must not contain a quote, a backslash or a space" ;; esac
}
# the pool must not touch anything this server already uses (own networks, other sites' routes)
check_pool_free() {
  local pool=$1 net a
  while read -r net; do
    [ -n "$net" ] || continue
    in_cidr "${pool%/*}" "$net" && die "dialin.conf: pool $pool overlaps the network $net that this server already uses"
    in_cidr "${net%/*}" "$pool" && die "dialin.conf: pool $pool overlaps the network $net that this server already uses"
  done < <({ ip -4 -o addr show 2>/dev/null | awk '$2 !~ /^ppp/ && $2 != "lo" {print $4}'
             cat "$CONF_DIR"/routes.d/* 2>/dev/null | awk '{print $1}'; } | while IFS= read -r a; do
             valid_cidr "$a" && printf '%s\n' "$a"; done)
  return 0
}
# interface that carries the peer address $1 right now ("" when nobody is connected with it)
ifc_by_peer() {
  ip -o -4 addr show 2>/dev/null | awk -v P="$1" '$2 ~ /^ppp/ { for (i = 1; i <= NF; i++) if ($i == "peer") { x = $(i + 1); sub("/.*", "", x); if (x == P) { print $2; exit } } }'
}
# interface that carries site $1 right now: client sites have ppp-NAME, dial-in sites have a ppp0/ppp1... found by their fixed address
site_ifc() {
  local f="$CONF_DIR/dialin-ip.d/$1"
  if [ -f "$f" ]; then ifc_by_peer "$(head -n1 "$f")"; else printf 'ppp-%s' "$1"; fi
}
validate_server_site() {
  local w="Site '$S_NAME' (dial-in):"
  [[ "$S_USER" =~ ^[A-Za-z0-9._@-]{1,32}$ ]] || die "$w user must be 1-32 characters: letters, digits and . _ @ -"
  [[ "$S_PASS" =~ ^[^\"\\[:space:]]{8,64}$ ]] || die "$w password must be 8-64 characters without a space, quote or backslash"
  valid_ipv4 "$S_IP" || die "$w ip '$S_IP' is not an IPv4 address"
  in_cidr "$S_IP" "$(dialin_pool)" || die "$w ip $S_IP is outside the pool $(dialin_pool)"
  [ "$S_IP" != "$(dialin_local)" ] || die "$w ip $S_IP is the server's own address"
  if [ "${DI_PASS_CHECK:-1}" = 1 ]; then
    [ -z "${DI_USER[$S_USER]+x}" ] || die "$w user '$S_USER' is already used by site ${DI_USER[$S_USER]}"
    [ -z "${DI_IP[$S_IP]+x}" ] || die "$w ip $S_IP is already used by site ${DI_IP[$S_IP]}"
    DI_USER[$S_USER]=$S_NAME; DI_IP[$S_IP]=$S_NAME
  fi
  case "$S_NAT" in yes|no) ;; *) die "$w nat must be yes or no" ;; esac
  local v; for v in "$S_ACC_INET" "$S_ACC_CLIENTS" "$S_ACC_SITES"; do
    case "$v" in yes|no) ;; *) die "$w access_internet / access_clients / access_sites must be yes or no" ;; esac
  done
  validate_automation
  parse_routes "$S_ROUTES" > /dev/null
}

declare -gA DI_USER=() DI_IP=()      # user / address -> site, to refuse duplicates (reset before every pass)

# the same checks for the limits of one connection and for the defaults in quality.conf (empty = not set)
validate_quality_settings() {
  local w=$1 loss=$2 rtt=$3 jit=$4 amin=$5 rmin=$6 cool=$7 maxd=$8 win=$9 out=${10}
  [ -z "$loss" ] || { [[ "$loss" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v v="$loss" 'BEGIN { exit !(v >= 0.5 && v <= 100) }' || die "$w poor_loss must be a percent from 0.5 to 100"; }
  [ -z "$rtt" ] || { [[ "$rtt" =~ ^[0-9]{2,5}$ ]] && [ "$((10#$rtt))" -ge 20 ] && [ "$((10#$rtt))" -le 60000 ] || die "$w poor_rtt must be a delay in ms from 20 to 60000"; }
  [ -z "$jit" ] || { [[ "$jit" =~ ^[0-9]{1,5}$ ]] && [ "$((10#$jit))" -ge 5 ] && [ "$((10#$jit))" -le 60000 ] || die "$w poor_jitter must be a delay swing in ms from 5 to 60000"; }
  [ -z "$amin" ] || { [[ "$amin" =~ ^[0-9]{1,4}$ ]] && [ "$((10#$amin))" -ge 1 ] && [ "$((10#$amin))" -le 1440 ] || die "$w poor_alert_min must be minutes from 1 to 1440"; }
  [ -z "$rmin" ] || { [[ "$rmin" =~ ^[0-9]{1,5}$ ]] && { [ "$((10#$rmin))" = 0 ] || { [ "$((10#$rmin))" -ge 10 ] && [ "$((10#$rmin))" -le 10080 ]; }; } || die "$w poor_reconnect_min must be 0 (off) or minutes from 10 to 10080"; }
  [ -z "$cool" ] || { [[ "$cool" =~ ^[0-9]{1,5}$ ]] && [ "$((10#$cool))" -ge 10 ] && [ "$((10#$cool))" -le 10080 ] || die "$w poor_cooldown_min must be minutes from 10 to 10080"; }
  [ -z "$maxd" ] || { [[ "$maxd" =~ ^[0-9]{1,2}$ ]] && [ "$((10#$maxd))" -ge 1 ] && [ "$((10#$maxd))" -le 48 ] || die "$w poor_max_day must be a number from 1 to 48"; }
  [ -z "$win" ] || [[ "$win" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]-([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "$w poor_window must look like 03:00-07:00"
  case "$out" in ''|yes|no) ;; *) die "$w poor_outside must be yes or no" ;; esac
}

validate_mtu_range() {
  local w=$1 mn=$2 mx=$3 mg=$4
  [ -z "$mn" ] || { [[ "$mn" =~ ^[0-9]{3,4}$ ]] && [ "$((10#$mn))" -ge 576 ] && [ "$((10#$mn))" -le 1500 ] || die "$w mtu_min must be a number from 576 to 1500"; }
  [ -z "$mx" ] || { [[ "$mx" =~ ^[0-9]{3,4}$ ]] && [ "$((10#$mx))" -ge 576 ] && [ "$((10#$mx))" -le 1500 ] || die "$w mtu_max must be a number from 576 to 1500"; }
  [ -z "$mg" ] || { [[ "$mg" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$mg))" -ge 5 ] && [ "$((10#$mg))" -le 200 ] || die "$w mtu_step must be a number from 5 to 200 (bytes)"; }
  if [ -n "$mn" ] && [ -n "$mx" ] && [ "$((10#$mn))" -gt "$((10#$mx))" ]; then die "$w mtu_min must not be bigger than mtu_max"; fi      # (mtu_max is an old key: only checked when still present)
  return 0
}

# the numbers of the tests (one connection, or the defaults of Settings; empty = not set). ADDR: the extra test address
validate_test_settings() {
  local w=$1 cnt=$2 ev=$3 rb=$4 jb=$5 addr=${6:-}
  [ -z "$cnt" ] || { [[ "$cnt" =~ ^[0-9]{1,3}$ ]] && [ "$((10#$cnt))" -ge 3 ] && [ "$((10#$cnt))" -le 30 ] || die "$w ping_count must be a number from 3 to 30 (more would not fit in the minute)"; }
  [ -z "$ev" ] || { [[ "$ev" =~ ^[0-9]{1,4}$ ]] && [ "$((10#$ev))" -ge 1 ] && [ "$((10#$ev))" -le 1440 ] || die "$w test_every must be minutes from 1 to 1440"; }
  [ -z "$rb" ] || { [[ "$rb" =~ ^[0-9]{1,4}$ ]] && [ "$((10#$rb))" -ge 1 ] && [ "$((10#$rb))" -le 5000 ] || die "$w rtt_base must be a delay in ms from 1 to 5000"; }
  [ -z "$jb" ] || { [[ "$jb" =~ ^[0-9]{1,4}$ ]] && [ "$((10#$jb))" -ge 1 ] && [ "$((10#$jb))" -le 5000 ] || die "$w jit_base must be a delay swing in ms from 1 to 5000"; }
  if [ -n "$addr" ]; then
    valid_ipv4 "$addr" || die "$w test_addr '$addr' is not an IPv4 address"
    case "$addr" in 0.*|127.*|255.*|22[4-9].*|23[0-9].*) die "$w test_addr '$addr' cannot be tested (not a normal host address)" ;; esac
    if [ "${DI_PASS_CHECK:-1}" = 1 ]; then
      [ -z "${TA_USED[$addr]+x}" ] || die "$w test_addr $addr is already the test address of connection ${TA_USED[$addr]}: every connection needs its own (a second route to the same address would be unclear)"
      TA_USED[$addr]=$S_NAME
    fi
  fi
}
declare -gA TA_USED=()      # test address -> connection, to refuse duplicates (reset with DI_USER before every pass)

validate_site() {
  [[ "$S_NAME" =~ $NAME_RE ]] || die "Bad site name '$S_NAME' (use a-z 0-9 -, max 11 chars)"
  [ "$S_NAME" != dialin ] || die "The site name 'dialin' is reserved"
  case "$S_MODE" in client|server) ;; *) die "Site '$S_NAME': mode must be client or server" ;; esac
  case "$S_DISABLED" in yes|no) ;; *) die "Site '$S_NAME': disabled must be yes or no" ;; esac
  if [ "$S_MODE" = server ]; then validate_server_site; return 0; fi
  if [ -z "$S_HOST" ] || [ -z "$S_PSK" ] || [ -z "$S_USER" ] || [ -z "$S_PASS" ]; then
    die "Site '$S_NAME' is missing host / psk / user / pass"
  fi
  [[ "$S_HOST" =~ ^[A-Za-z0-9.-]+$ ]] || die "Site '$S_NAME': bad host '$S_HOST'"
  case "$S_PSK$S_PASS" in
    *'"'*|*'\'*) die "Site '$S_NAME': psk/password must not contain a double quote or backslash" ;;
  esac
  case "$S_MPPE" in yes|no) ;; *) die "Site '$S_NAME': mppe must be yes or no" ;; esac
  case "$S_NAT" in yes|no) ;; *) die "Site '$S_NAME': nat must be yes or no" ;; esac
  validate_automation
  parse_routes "$S_ROUTES" > /dev/null
}

# ---------- generation ----------
# One dial-in site: its login line, its routes, its fixed address, its NAT. No per-site IPsec/xl2tpd block exists:
# all dial-in routers share one IPsec connection and one xl2tpd [lns] section (see dialin_emit).
gen_server_site() {
  echo "$S_NAME" >> "$KEEP"
  mkdir -p "$CONF_DIR/routes.d" "$CONF_DIR/dialin-ip.d"
  parse_routes "$S_ROUTES" > "$CONF_DIR/routes.d/$S_NAME"
  # line 1 = fixed address (everything that reads this file uses only line 1), line 2 = what this client may reach
  printf '%s\n%s %s %s\n' "$S_IP" "$S_ACC_INET" "$S_ACC_CLIENTS" "$S_ACC_SITES" > "$CONF_DIR/dialin-ip.d/$S_NAME"
  if [ "$S_DISABLED" != yes ]; then
    printf '"%s" * "%s" %s\n' "$S_USER" "$S_PASS" "$S_IP" >> "$TMP_CHAP"       # no line = the login is refused
    echo "$S_IP" >> "$TMP_ALLOWED"
    if [ "$S_NAT" = yes ]; then parse_routes "$S_ROUTES" | awk '{print $1}' >> "$TMP_NATD"; fi
  fi
}

gen_site() {
  validate_site
  if [ "$S_MODE" = server ]; then gen_server_site; return 0; fi
  # a switched-off client site gets no IPsec/xl2tpd/PPP/route/NAT entry at all (its old files are removed like those of a deleted site)
  if [ "$S_DISABLED" = yes ]; then return 0; fi
  echo "$S_NAME" >> "$KEEP"
  echo "$S_NAME $S_HOST" >> "${TMP_ACTIVE:-/dev/null}"        # (site-sync compares this list with what was configured before)
  if [ "$S_NAT" = yes ]; then echo "$S_NAME" >> "$TMP_NAT"; fi
  # what this outgoing site may reach (internet, outgoing sites, dial-in clients); read by apply_client_access
  mkdir -p "$CONF_DIR/site-acc.d"
  printf '%s %s %s\n' "$S_ACC_INET" "$S_ACC_SITES" "$S_ACC_CLIENTS" > "$CONF_DIR/site-acc.d/$S_NAME"
  # routers that may talk plain L2TP (no IPsec): the dial-in firewall must not drop their UDP 1701
  if [ "${S_IPSEC_MODE:-heal}" != require ]; then echo "$S_HOST" >> "$TMP_PLAIN"; else echo "$S_HOST" >> "${TMP_REQ:-/dev/null}"; fi
  if [ "${LIGHT:-0}" = 1 ]; then return 0; fi      # dialin-sync: only the lists above are needed, no files are touched

  # IPsec connection. A hostname peer identifies itself by IP, so accept any ID.
  {
    echo "$TAG"
    echo "conn $S_NAME"
    echo "    type=transport"
    echo "    authby=secret"
    echo "    keyexchange=ikev1"
    echo "    left=%defaultroute"
    echo "    leftprotoport=17/1701"
    echo "    right=$S_HOST"
    if ! [[ "$S_HOST" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      echo "    rightid=%any"
    fi
    echo "    rightprotoport=17/1701"
    echo "    ike=aes256-sha1-modp1024,aes128-sha1-modp1024,aes256-sha1-modp2048,3des-sha1-modp1024"
    echo "    esp=aes256-sha1,aes128-sha1,3des-sha1"
    echo "    auto=start"
    echo "    dpdaction=restart"
    echo "    dpddelay=30s"
  } > "$IPSEC_D/$S_NAME.conf"

  # PPP options (username / password)
  local ccp="noccp"
  if [ "$S_MPPE" = yes ]; then ccp="require-mppe-128"; fi
  {
    echo "$TAG"
    echo "name $S_USER"
    echo "password \"$S_PASS\""
    echo "ifname ppp-$S_NAME"
    echo "ipparam $S_NAME"
    echo "noauth"
    echo "refuse-eap"
    echo "$ccp"
    echo "noipdefault"
    echo "nodefaultroute"
    echo "ipcp-accept-local"
    echo "ipcp-accept-remote"
    echo "mtu $(mtu_offer)"
    echo "mru $(mtu_offer)"
    echo "connect-delay 5000"
    if [ "${S_LCP:-on}" != off ]; then echo "lcp-echo-interval 30"; echo "lcp-echo-failure 6"; fi
  } > "$PPP_DIR/options.l2tpd.$S_NAME"
  chmod 600 "$PPP_DIR/options.l2tpd.$S_NAME"

  # routes that are added when this site's ppp link comes up (and removed when it goes down)
  parse_routes "$S_ROUTES" > "$CONF_DIR/routes.d/$S_NAME"

  # IPsec secret
  printf '%%any %s : PSK "%s"\n' "$S_HOST" "$S_PSK" >> "$TMP_SECRETS"

  # xl2tpd block
  {
    echo "[lac $S_NAME]"
    echo "lns = $S_HOST"
    echo "pppoptfile = $PPP_DIR/options.l2tpd.$S_NAME"
    echo "length bit = yes"
    echo "autodial = yes"
    echo "redial = yes"
    echo "redial timeout = 15"
    echo "max redials = 9999"
    echo
  } >> "$TMP_XL"
}

# NAT toward tunnels: one own chain (L2TPGW-NAT) in the nat table, rebuilt on every apply,
# so a site that is changed to nat=no or removed loses its rule automatically.
apply_nat() {
  local ipt=${IPT:-iptables} n
  if ! command -v "$ipt" >/dev/null 2>&1; then
    echo "WARNING: iptables not found - NAT rules not changed." >&2
    return 0
  fi
  "$ipt" -t nat -N L2TPGW-NAT 2>/dev/null || true
  "$ipt" -t nat -C POSTROUTING -j L2TPGW-NAT 2>/dev/null || "$ipt" -t nat -A POSTROUTING -j L2TPGW-NAT
  "$ipt" -t nat -F L2TPGW-NAT
  while read -r n; do
    if [ -n "$n" ]; then "$ipt" -t nat -A L2TPGW-NAT -o "ppp-$n" -j MASQUERADE; fi
  done < "$TMP_NAT"
  # dial-in sites: their ppp interface has no fixed name, so the rule matches the destination (the networks behind the router)
  if [ -s "${TMP_NATD:-/dev/null}" ]; then
    while read -r n; do
      if [ -n "$n" ]; then "$ipt" -t nat -A L2TPGW-NAT -d "$n" -o 'ppp+' -j MASQUERADE; fi
    done < <(sort -u "$TMP_NATD")
  fi
  if [ "$NO_RESTART" != 1 ] && command -v netfilter-persistent >/dev/null 2>&1; then
    netfilter-persistent save >/dev/null
  fi
}

# pppd runs ip-up / ip-down scripts when a link comes up / goes down (see pppd(8)).
# On Debian/Ubuntu /etc/ppp/ip-up runs every script in /etc/ppp/ip-up.d.
# The hooks only call "l2tp-gw routes-sync", which rebuilds ALL site routes at once:
# one up tunnel -> plain route, several up tunnels with the same network+metric -> one
# multipath route (traffic is shared between the tunnels), none up -> route removed.
write_route_hooks() {
  local d f gw
  gw=$(readlink -f "$0" 2>/dev/null || echo /usr/local/bin/l2tp-gw)
  mkdir -p "$PPP_DIR/ip-up.d" "$PPP_DIR/ip-down.d"
  for d in up down; do
    f="$PPP_DIR/ip-$d.d/l2tp-gw"
    {
      echo '#!/bin/sh'
      echo "$TAG"
      echo '# pppd gives: interface, tty, speed, local ip, remote ip, ipparam (= site name)'
      echo 'IFACE="${PPP_IFACE:-${IFNAME:-$1}}"'
      echo "CONF_DIR=\"$CONF_DIR\" \"$gw\" routes-sync \"\$IFACE\" $d || true"
      if [ "$d" = up ]; then echo "CONF_DIR=\"$CONF_DIR\" \"$gw\" mtu-apply \"\$IFACE\" >/dev/null 2>&1 || true"; fi
      if [ "$d" = down ]; then
        echo '# a late ip-down of an old session must not remove routes of a tunnel that is already back:'
        echo "( sleep 3; CONF_DIR=\"$CONF_DIR\" \"$gw\" routes-sync \"\$IFACE\" up ) >/dev/null 2>&1 &"
      fi
      echo 'exit 0'
    } > "$f"
    chmod 755 "$f"
  done
  # warn (do not fail) if this system's ppp would not run the hook directories
  if [ ! -f "$PPP_DIR/ip-up" ] || ! grep -q 'ip-up.d' "$PPP_DIR/ip-up"; then
    echo "WARNING: $PPP_DIR/ip-up does not run $PPP_DIR/ip-up.d - per-site routes will NOT be added automatically." >&2
  fi
  if [ ! -f "$PPP_DIR/ip-down" ] || ! grep -q 'ip-down.d' "$PPP_DIR/ip-down"; then
    echo "WARNING: $PPP_DIR/ip-down does not run $PPP_DIR/ip-down.d - routes will only be removed with the interface." >&2
  fi
}

# true when interface $1 exists and is UP (a half-created ppp interface does not count)
iface_up() {
  ip -o link show dev "$1" 2>/dev/null | grep -qE '<([^>]*,)?UP(,[^>]*)?>'
}

# routes-sync [IFACE up|down]  (called by the ppp hooks; also safe to run by hand)
cmd_routes_sync() {
  local iface=${1:-} mode=${2:-up} excl="" f site ifc net metric key i
  local -A members=()
  local -a order=() args=()
  if [ "$mode" = down ]; then excl=$iface; fi
  mkdir -p "$CONF_DIR"
  exec 9>"$CONF_DIR/.routes.lock"
  flock 9
  for f in "$CONF_DIR"/routes.d/*; do
    [ -f "$f" ] || continue
    site=$(basename "$f"); ifc=$(site_ifc "$site")      # dial-in sites: "" while not connected
    while read -r net metric; do
      [ -n "$net" ] || continue
      key="$net $metric"
      if [ -z "${members[$key]+x}" ]; then members[$key]=""; order+=("$key"); fi
      # a tunnel counts only when its interface exists AND is up (it may be half-created)
      if [ -n "$ifc" ] && [ "$ifc" != "$excl" ] && iface_up "$ifc"; then
        members[$key]+="$ifc "
      fi
    done < "$f"
  done
  for key in "${order[@]}"; do
    read -r net metric <<< "$key"
    set -- ${members[$key]}
    if [ "$#" -eq 0 ]; then
      ip route del "$net" metric "$metric" 2>/dev/null || true
      routes_log "$mode $iface: $net metric $metric -> removed (no tunnel up)"
    elif [ "$#" -eq 1 ]; then
      if out=$(ip route replace "$net" dev "$1" metric "$metric" 2>&1); then
        routes_log "$mode $iface: $net metric $metric -> $1"
      else
        routes_log "$mode $iface: $net metric $metric via $1 FAILED: $out"
      fi
    else
      args=()
      for i in "$@"; do args+=(nexthop dev "$i" weight 1); done
      if out=$(ip route replace "$net" metric "$metric" "${args[@]}" 2>&1); then
        routes_log "$mode $iface: $net metric $metric -> multipath $*"
      else
        routes_log "$mode $iface: $net metric $metric multipath $* FAILED: $out"
      fi
    fi
  done
  sync_peers "$excl"
  # a dial-in session (ppp0, ppp1 ...) came or went: rebuild who-may-reach-what (the interface going down is skipped)
  case "$iface" in ppp[0-9]*) apply_client_access "$excl" || true ;; esac
}

# Several tunnels to the same router often get the SAME peer address (e.g. 172.17.192.3).
# Linux then has one host route per tunnel, but uses only one of them, so every reply goes
# through that single tunnel. With 2+ tunnels up we replace them by ONE multipath route.
sync_peers() {
  local excl=$1 f site ifc peer cur n i
  local -A peers=()
  local -a porder=()
  for f in "$CONF_DIR"/routes.d/*; do
    [ -f "$f" ] || continue
    site=$(basename "$f"); ifc="ppp-$site"
    if [ -f "$CONF_DIR/dialin-ip.d/$site" ]; then continue; fi     # dial-in sites have private fixed peers, nothing is shared
    if [ "$ifc" = "$excl" ] || ! iface_up "$ifc"; then continue; fi
    peer=$(ip -o addr show dev "$ifc" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="peer"){sub("/.*","",$(i+1)); print $(i+1); exit}}')
    [ -n "$peer" ] || continue
    if [ -z "${peers[$peer]+x}" ]; then peers[$peer]=""; porder+=("$peer"); fi
    peers[$peer]+="$ifc "
  done
  for peer in "${porder[@]}"; do
    set -- ${peers[$peer]}
    n=$#
    cur=$(ip route show "$peer/32" 2>/dev/null || true)
    if [ "$n" -ge 2 ]; then
      if [ "$(printf '%s\n' "$cur" | grep -c nexthop)" -eq "$n" ]; then continue; fi
      for i in 1 2 3 4 5 6; do ip route del "$peer/32" 2>/dev/null || break; done
      local -a args=()
      for i in "$@"; do args+=(nexthop dev "$i" weight 1); done
      if out=$(ip route add "$peer/32" scope link "${args[@]}" 2>&1); then
        routes_log "peer $peer shared by $* -> multipath"
      else
        routes_log "peer $peer multipath $* FAILED: $out"
      fi
    else
      # one tunnel left: make sure it has a plain host route (the multipath one is gone)
      if [ -z "$cur" ] || printf '%s' "$cur" | grep -q nexthop; then
        for i in 1 2 3 4 5 6; do ip route del "$peer/32" 2>/dev/null || break; done
        ip route add "$peer/32" dev "$1" scope link 2>/dev/null && routes_log "peer $peer -> $1"
      fi
    fi
  done
}

# last 200 lines of what the ppp hooks did: $CONF_DIR/routes.log
routes_log() {
  local f="$CONF_DIR/routes.log"
  echo "$(date '+%F %T') $*" >> "$f"
  if [ "$(wc -l < "$f")" -gt 200 ]; then tail -n 200 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; fi
}

# ---------- dial-in: shared pieces (one IPsec connection, one xl2tpd [lns], one pppd options file, one secrets block) ----------
# strongSwan answers any peer address (right=%any) with the shared PSK; the router is identified later, by its PPP login.
# xl2tpd must NOT hand out addresses (assign ip = no): pppd takes the fixed address of the login from chap-secrets.
dialin_emit() {
  local pool lip pub psk
  mkdir -p "$IPSEC_D" "$PPP_DIR"
  if ! dialin_enabled; then
    rm -f "$IPSEC_D/l2tp-gw-dialin.conf" "$PPP_DIR/options.l2tpd.dialin"
    return 0
  fi
  validate_dialin_settings
  pool=$(dialin_pool); lip=$(dialin_local); pub=$(dialin_get public_ip); psk=$(dialin_get psk)
  check_pool_free "$pool"
  {
    echo "$TAG"
    echo "conn l2tp-gw-dialin"
    echo "    type=transport"
    echo "    authby=secret"
    echo "    keyexchange=ikev1"
    echo "    left=%any"
    if [ -n "$pub" ]; then echo "    leftid=$pub"; fi
    echo "    leftprotoport=17/1701"
    echo "    right=%any"
    echo "    rightprotoport=17/%any"
    echo "    ike=aes256-sha1-modp1024,aes128-sha1-modp1024,aes256-sha1-modp2048,3des-sha1-modp1024"
    echo "    esp=aes256-sha1-modp1024,aes192-sha1-modp1024,aes128-sha1-modp1024,aes256-sha256-modp1024,aes256-sha1-modp2048,aes128-sha1-modp2048,aes256-sha1,aes128-sha1,3des-sha1"
    echo "    auto=add"
    echo "    rekey=no"
    echo "    dpdaction=clear"
    echo "    dpddelay=30s"
  } > "$IPSEC_D/l2tp-gw-dialin.conf"
  printf '%%any %%any : PSK "%s"\n' "$psk" >> "$TMP_SECRETS"
  {
    echo "$TAG"
    echo "auth"
    echo "refuse-pap"
    echo "refuse-eap"
    echo "noccp"
    echo "nodefaultroute"
    echo "ipparam dialin"
    echo "mtu $(dialin_announce)"
    echo "mru $(dialin_announce)"
    echo "lcp-echo-interval 30"
    echo "lcp-echo-failure 4"
  } > "$PPP_DIR/options.l2tpd.dialin"
  chmod 600 "$PPP_DIR/options.l2tpd.dialin"
  {
    echo "[lns default]"
    echo "assign ip = no"
    echo "local ip = $lip"
    echo "length bit = yes"
    echo "hidden bit = no"
    echo "pppoptfile = $PPP_DIR/options.l2tpd.dialin"
    echo
  } >> "$TMP_XL"
}

# chap-secrets: our block (one line per enabled dial-in site) replaces the old one, the rest of the file is left alone
write_chap_secrets() {
  local f="$PPP_DIR/chap-secrets"
  [ -f "$f" ] || : > "$f"
  sed -i '/^# BEGIN l2tp-gw$/,/^# END l2tp-gw$/d' "$f"
  if dialin_enabled && [ -s "${TMP_CHAP:-/dev/null}" ]; then
    { echo "# BEGIN l2tp-gw"; cat "$TMP_CHAP"; echo "# END l2tp-gw"; } >> "$f"
  fi
  chmod 600 "$f"
}

# UDP 1701 may come from the Internet ONLY inside IPsec. Chain L2TPGW-IN is rebuilt on every apply; it is empty
# (= no effect at all) while dial-in is off.
apply_dialin_fw() {
  local ipt=${IPT:-iptables} h ip4
  command -v "$ipt" >/dev/null 2>&1 || return 0
  if ! dialin_enabled; then
    # off: touch nothing unless an earlier "on" left the chain behind; then just empty it (= no effect)
    if "$ipt" -S L2TPGW-IN >/dev/null 2>&1; then "$ipt" -F L2TPGW-IN; fi
    return 0
  fi
  "$ipt" -N L2TPGW-IN 2>/dev/null || true
  "$ipt" -C INPUT -j L2TPGW-IN 2>/dev/null || "$ipt" -I INPUT 1 -j L2TPGW-IN
  "$ipt" -F L2TPGW-IN
  if ! "$ipt" -A L2TPGW-IN -p udp --dport 1701 -m policy --dir in --pol ipsec -j ACCEPT 2>/dev/null; then
    echo "WARNING: this iptables cannot match IPsec traffic (xt_policy): plain UDP 1701 is NOT blocked." >&2
    return 0
  fi
  # client routers that are allowed to talk plain L2TP (ipsec_mode heal/allow) keep working
  if [ -s "${TMP_PLAIN:-/dev/null}" ]; then
    while read -r h; do
      [ -n "$h" ] || continue
      if is_ipv4 "$h"; then ip4=$h; else ip4=$(resolve_v4 "$h"); fi
      if [ -n "$ip4" ]; then "$ipt" -A L2TPGW-IN -s "$ip4" -p udp --dport 1701 -j ACCEPT; fi
    done < <(sort -u "$TMP_PLAIN")
  fi
  "$ipt" -A L2TPGW-IN -p udp --dport 1701 -j DROP
}

# Sites with ipsec_mode = require: plain (non-IPsec) UDP 1701 from the router's address is dropped. Chain L2TPGW-REQ is
# rebuilt on every apply and is empty (= no effect) when no site uses "require". heal/allow sites are never touched.
apply_require_fw() {
  local ipt=${IPT:-iptables} h ip4 any=0
  command -v "$ipt" >/dev/null 2>&1 || return 0
  if [ -s "${TMP_REQ:-/dev/null}" ]; then any=1; fi
  if [ "$any" = 0 ]; then
    if "$ipt" -S L2TPGW-REQ >/dev/null 2>&1; then "$ipt" -F L2TPGW-REQ; fi
    return 0
  fi
  "$ipt" -N L2TPGW-REQ 2>/dev/null || true
  "$ipt" -C INPUT -j L2TPGW-REQ 2>/dev/null || "$ipt" -I INPUT 1 -j L2TPGW-REQ
  "$ipt" -F L2TPGW-REQ
  while read -r h; do
    [ -n "$h" ] || continue
    if is_ipv4 "$h"; then ip4=$h; else ip4=$(resolve_v4 "$h"); fi
    [ -n "$ip4" ] || continue
    if ! "$ipt" -A L2TPGW-REQ -s "$ip4" -p udp --dport 1701 -m policy --dir in --pol ipsec -j ACCEPT 2>/dev/null; then
      echo "WARNING: this iptables cannot match IPsec traffic (xt_policy): plain UDP 1701 is NOT blocked for 'require' sites." >&2
      "$ipt" -F L2TPGW-REQ
      return 0
    fi
    "$ipt" -A L2TPGW-REQ -s "$ip4" -p udp --dport 1701 -j DROP
  done < <(sort -u "$TMP_REQ")
}

# What may each dial-in client reach? Chain L2TPGW-ACC (filter table, first rule of FORWARD) is rebuilt in ONE step
# (iptables-restore) from the flags in dialin-ip.d/NAME line 2 and the sessions that exist right now:
#   internet=no  the client cannot send anything out of the server except into other tunnels
#   sites=no     no traffic in either direction between the client and the outgoing (ppp-NAME) tunnels
#   clients=no   no traffic in either direction between the client and any other connected dial-in client
# With all flags "yes" (the default) the chain is empty = nothing changes. $1 = interface that is going down (skip it).
# Called after apply / dialin-sync, and by the pppd hook when a dial-in session comes or goes (so a new session is
# covered within a moment; the session exists for a few milliseconds before the hook runs - noted limit).
apply_client_access() {
  local skip=${1:-} ipt=${IPT:-iptables} f n ip4 flags ifc a b c ifs="" y rules=""
  local -a all=() fl=()
  command -v "$ipt" >/dev/null 2>&1 && command -v "${ipt}-restore" >/dev/null 2>&1 || return 0
  "$ipt" -N L2TPGW-ACC 2>/dev/null || true
  "$ipt" -C FORWARD -j L2TPGW-ACC 2>/dev/null || "$ipt" -I FORWARD 1 -j L2TPGW-ACC
  # connected dial-in interfaces (ppp0, ppp1 ... with a peer inside the pool)
  while read -r ifc ip4; do
    [ -n "$ifc" ] && [ "$ifc" != "$skip" ] || continue
    dialin_enabled || continue                       # (dial-in off: no dial-in interface counts)
    in_cidr "$ip4" "$(dialin_pool)" && all+=("$ifc")
  done < <(ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^ppp[0-9]/ { for (i = 1; i <= NF; i++) if ($i == "peer") { x = $(i + 1); sub("/.*", "", x); print $2, x; break } }')
  # outgoing sites (tunnel ppp-NAME): file site-acc.d/NAME = "internet sites clients". Rules are by interface NAME, so they
  # already hold when the tunnel comes back; only the dial-in interfaces (ppp0, ppp1 ...) need the list above.
  for f in "$CONF_DIR"/site-acc.d/*; do
    [ -f "$f" ] || continue
    n=$(basename "$f"); read -r a b c < "$f" || true       # internet, other outgoing sites, dial-in clients
    [ "${a:-yes}" = no ] && rules+="-A L2TPGW-ACC -i ppp-$n ! -o ppp+ -j DROP"$'\n'
    if [ "${b:-yes}" = no ]; then
      rules+="-A L2TPGW-ACC -i ppp-$n -o ppp-+ -j DROP"$'\n'"-A L2TPGW-ACC -i ppp-+ -o ppp-$n -j DROP"$'\n'
    fi
    if [ "${c:-yes}" = no ]; then
      for y in "${all[@]}"; do rules+="-A L2TPGW-ACC -i ppp-$n -o $y -j DROP"$'\n'"-A L2TPGW-ACC -i $y -o ppp-$n -j DROP"$'\n'; done
    fi
  done
  dialin_enabled || { printf '*filter\n:L2TPGW-ACC - [0:0]\n%sCOMMIT\n' "$(printf '%s' "$rules" | sort -u)"$'\n' | "${ipt}-restore" --noflush || true; return 0; }
  for f in "$CONF_DIR"/dialin-ip.d/*; do
    [ -f "$f" ] || continue
    ip4=$(sed -n 1p "$f"); flags=$(sed -n 2p "$f")
    read -r a b c <<< "${flags:-yes yes yes}"        # internet clients sites
    ifc=$(ifc_by_peer "$ip4")
    [ -n "$ifc" ] && [ "$ifc" != "$skip" ] || continue
    [ "${a:-yes}" = no ] && rules+="-A L2TPGW-ACC -i $ifc ! -o ppp+ -j DROP"$'\n'
    if [ "${c:-yes}" = no ]; then
      rules+="-A L2TPGW-ACC -i $ifc -o ppp-+ -j DROP"$'\n'"-A L2TPGW-ACC -i ppp-+ -o $ifc -j DROP"$'\n'
    fi
    if [ "${b:-yes}" = no ]; then
      for y in "${all[@]}"; do
        [ "$y" = "$ifc" ] && continue
        rules+="-A L2TPGW-ACC -i $ifc -o $y -j DROP"$'\n'"-A L2TPGW-ACC -i $y -o $ifc -j DROP"$'\n'
      done
    fi
  done
  # (":CHAIN - [0:0]" with --noflush empties only this chain; COMMIT swaps the whole content in one step)
  printf '*filter\n:L2TPGW-ACC - [0:0]\n%sCOMMIT\n' "$(printf '%s' "$rules" | sort -u)"$'\n' | "${ipt}-restore" --noflush \
    || echo "WARNING: could not load the dial-in access rules." >&2
}

# pppd of a dial-in session: stop it (the router may dial in again when the site is enabled)
kick_iface() {
  local ifc=$1 pid
  pid=$(cat "/run/$ifc.pid" 2>/dev/null || cat "/var/run/$ifc.pid" 2>/dev/null || true)
  if [[ "$pid" =~ ^[0-9]+$ ]]; then kill "$pid" 2>/dev/null || true; return 0; fi
  return 1
}
# end the sessions of dial-in routers that are no longer allowed (disabled / removed / password changed)
kick_unwanted() {
  local ifc peer
  dialin_enabled || return 0
  while read -r ifc peer; do
    [ -n "$ifc" ] || continue
    in_cidr "$peer" "$(dialin_pool)" || continue
    grep -qx "$peer" "$TMP_ALLOWED" 2>/dev/null && continue
    if kick_iface "$ifc"; then echo "ended the session of $peer ($ifc)"; fi
  done < <(ip -o -4 addr show 2>/dev/null | awk '$2 ~ /^ppp[0-9]/ { for (i = 1; i <= NF; i++) if ($i == "peer") { x = $(i + 1); sub("/.*", "", x); print $2, x; break } }')
}
dialin_hash() {   # what needs a service restart when it changes
  { dialin_get enabled no; dialin_get public_ip; dialin_get psk; dialin_pool; dialin_local; } | md5sum | cut -d' ' -f1
}

# dialin-sync: apply everything about dial-in SITES (users, fixed addresses, routes, NAT, who may stay connected)
# without touching IPsec or xl2tpd, so no tunnel flaps. Prints RESTART-NEEDED when a shared setting changed.
cmd_dialin_sync() {
  need_root
  [ -f "$SITES" ] || die "No sites file yet."
  umask 077
  TMP_CHAP=$(mktemp); KEEP=$(mktemp); TMP_NAT=$(mktemp); TMP_NATD=$(mktemp); TMP_ALLOWED=$(mktemp); TMP_PLAIN=$(mktemp); TMP_REQ=$(mktemp)
  mkdir -p "$CONF_DIR/routes.d" "$CONF_DIR/dialin-ip.d"
  DI_USER=(); DI_IP=(); TA_USED=()
  if dialin_enabled; then validate_dialin_settings; fi
  LIGHT=1; for_each_site gen_site; LIGHT=0
  local f n
  for f in "$CONF_DIR"/routes.d/* "$CONF_DIR"/dialin-ip.d/* "$CONF_DIR"/site-acc.d/*; do
    [ -f "$f" ] || continue
    n=$(basename "$f")
    grep -qx "$n" "$KEEP" || rm -f "$f"
  done
  write_chap_secrets
  apply_nat
  apply_dialin_fw
  apply_require_fw
  apply_client_access
  kick_unwanted || true
  write_route_hooks 2>/dev/null || true     # an update may have changed the hooks (e.g. mtu-apply); this is cheap and touches no tunnel
  dialin_mtu_rewrite || true
  cmd_mtu_apply "" || true
  cmd_routes_sync "" up
  if [ -f "$STATE_DIR/dialin.applied" ] && [ "$(cat "$STATE_DIR/dialin.applied")" != "$(dialin_hash)" ]; then
    echo "RESTART-NEEDED: the shared dial-in settings changed; run: l2tp-gw apply"
  elif [ ! -f "$STATE_DIR/dialin.applied" ] && dialin_enabled; then
    echo "RESTART-NEEDED: dial-in was never applied; run: l2tp-gw apply"
  fi
  rm -f "$TMP_CHAP" "$KEEP" "$TMP_NAT" "$TMP_NATD" "$TMP_ALLOWED" "$TMP_PLAIN" "$TMP_REQ"
  echo "Dial-in changes applied (no service was restarted)."
}

# disconnect NAME: end the live session of a dial-in site
cmd_disconnect() {
  need_root
  local n=${1:-} ip ifc
  [ -n "$n" ] && [ -f "$CONF_DIR/dialin-ip.d/$n" ] || die "Usage: l2tp-gw disconnect NAME (NAME must be a dial-in site)"
  ip=$(head -n1 "$CONF_DIR/dialin-ip.d/$n")
  ifc=$(ifc_by_peer "$ip")
  [ -n "$ifc" ] || { echo "$n is not connected."; return 0; }
  kick_iface "$ifc" || die "Could not find the pppd of $ifc"
  echo "Session of $n ($ifc) ended."
}

# cut NAME: the connection is cut ONCE so that new settings are really used: a dial-in client is disconnected (its router dials in
# again by itself), an outgoing site is disconnected and connected again. Used when a connection is saved.
cmd_cut() {
  need_root
  local n=${1:-} mode
  [ -n "$n" ] && [ -f "$SITES" ] && grep -qxF "[$n]" "$SITES" || die "Usage: l2tp-gw cut NAME (NAME must be an existing connection)"
  mode=$(awk -v s="[$n]" '$0==s {f=1; next} /^\[/ {f=0} f && /^[ \t]*mode[ \t]*=/ {sub(/^[^=]*=[ \t]*/, ""); print; exit}' "$SITES")
  if [ "$mode" = server ]; then
    [ -f "$CONF_DIR/dialin-ip.d/$n" ] || { echo "$n: not known to the dial-in service yet, nothing to cut."; return 0; }
    cmd_disconnect "$n"
  else cmd_reconnect "$n"; fi
}
# cut-all in|out: the same for ALL enabled dial-in clients (in) or ALL enabled outgoing sites (out), one after the other.
# Used when the defaults of that part of the Settings are saved.
cut_cb() {
  [ "$S_DISABLED" != yes ] || return 0
  if [ "$CUT_KIND" = in ] && [ "$S_MODE" = server ]; then ( cmd_disconnect "$S_NAME" ) < /dev/null || true
  elif [ "$CUT_KIND" = out ] && [ "$S_MODE" != server ]; then ( cmd_reconnect "$S_NAME" ) < /dev/null || true; fi
}
cmd_cut_all() {
  need_root
  CUT_KIND=${1:-}
  case "$CUT_KIND" in in|out) ;; *) die "Usage: l2tp-gw cut-all in|out" ;; esac
  [ -f "$SITES" ] || return 0
  for_each_site cut_cb
}

# xl2tpd-control with an optional control file (tests use their own xl2tpd)
xlc() { xl2tpd-control ${XL2TPD_CTL:+-c "$XL2TPD_CTL"} "$@"; }

# site-sync support: compare the client sites that WERE configured (TMP_PREV) with those that are now (TMP_ACTIVE).
# A site that is no longer wanted: its L2TP session and IPsec connection are closed and removed. A site that is new:
# its IPsec connection is loaded (it starts by itself) and its L2TP dial-out is added to the running xl2tpd.
# Nothing else is touched, so the other tunnels keep running. "ipsec update" only applies the difference.
live_reconcile() {
  local n h s hs changed=0
  while read -r n h; do
    [ -n "$n" ] || continue
    grep -q "^$n " "$TMP_ACTIVE" && continue
    changed=1
    echo "switching off $n"
    xlc disconnect-lac "$n" >/dev/null 2>&1 || true
    xlc remove-lac "$n" >/dev/null 2>&1 || true
    ipsec down "$n" >/dev/null 2>&1 || true
  done < "$TMP_PREV"
  while read -r n h; do
    [ -n "$n" ] || continue
    grep -q "^$n " "$TMP_PREV" && continue
    changed=1
    echo "switching on $n"
  done < "$TMP_ACTIVE"
  if [ "$changed" = 1 ]; then
    ipsec rereadsecrets >/dev/null 2>&1 || true
    ipsec update >/dev/null 2>&1 || true
    # sites switched on: add their L2TP dial-out to the running xl2tpd (same settings as in xl2tpd.conf)
    while read -r n h; do
      [ -n "$n" ] || continue
      grep -q "^$n " "$TMP_PREV" && continue
      xlc add-lac "$n" "lns=$h" "pppoptfile=$PPP_DIR/options.l2tpd.$n" "length bit=yes" "autodial=yes" "redial=yes" \
        "redial timeout=15" "max redials=9999" >/dev/null 2>&1 || echo "WARNING: could not add $n to the running xl2tpd; run: l2tp-gw apply" >&2
    done < "$TMP_ACTIVE"
    # a site that shared an IKE session with a switched-off one may have lost it: bring it up again
    while read -r n h; do
      [ -n "$n" ] || continue
      grep -q "^$n " "$TMP_ACTIVE" && continue
      while read -r s hs; do
        [ -n "$s" ] && [ "$hs" = "$h" ] || continue
        grep -q "^$s " "$TMP_PREV" || continue
        timeout 40 ipsec up "$s" >/dev/null 2>&1 || true
      done < "$TMP_ACTIVE"
    done < "$TMP_PREV"
  fi
  echo "Done. Only the changed sites were touched; other tunnels were not restarted."
}

cmd_site_sync() { LIVE=1; cmd_apply; LIVE=0; }

cmd_apply() {
  need_root
  [ -f "$SITES" ] || die "No sites file yet. Run: l2tp-gw add"
  grep -q "include $IPSEC_D" "$IPSEC_CONF" 2>/dev/null || die "Server is not prepared. Run: l2tp-gw setup"
  umask 077
  TMP_SECRETS=$(mktemp); TMP_XL=$(mktemp); KEEP=$(mktemp); TMP_NAT=$(mktemp)
  TMP_CHAP=$(mktemp); TMP_NATD=$(mktemp); TMP_ALLOWED=$(mktemp); TMP_PLAIN=$(mktemp); TMP_REQ=$(mktemp)
  TMP_ACTIVE=$(mktemp); TMP_PREV=$(mktemp)
  mkdir -p "$IPSEC_D" "$PPP_DIR" "$(dirname "$XL2TPD_CONF")" "$CONF_DIR/routes.d" "$CONF_DIR/dialin-ip.d"
  echo "; managed by l2tp-gw" > "$TMP_XL"
  DI_USER=(); DI_IP=(); TA_USED=()
  # what is configured right now (name + address of every client site), read before anything is regenerated
  local pf pn
  for pf in "$IPSEC_D"/*.conf; do
    [ -f "$pf" ] && grep -qF "$TAG" "$pf" || continue
    pn=$(basename "$pf" .conf)
    [ "$pn" != l2tp-gw-dialin ] || continue
    echo "$pn $(sed -n 's/^[[:space:]]*right=//p' "$pf" | head -n1)" >> "$TMP_PREV"
  done

  for_each_site gen_site

  # remove files of sites that no longer exist (only files we created)
  local f n
  for f in "$IPSEC_D"/*.conf; do
    [ -f "$f" ] || continue
    grep -qF "$TAG" "$f" || continue
    n=$(basename "$f" .conf)
    grep -qx "$n" "$KEEP" || rm -f "$f"
  done
  for f in "$PPP_DIR"/options.l2tpd.*; do
    [ -f "$f" ] || continue
    grep -qF "$TAG" "$f" || continue
    n=${f##*/options.l2tpd.}
    grep -qx "$n" "$KEEP" || rm -f "$f"
  done
  for f in "$CONF_DIR"/routes.d/* "$CONF_DIR"/dialin-ip.d/* "$CONF_DIR"/site-acc.d/*; do
    [ -f "$f" ] || continue
    n=$(basename "$f")
    grep -qx "$n" "$KEEP" || rm -f "$f"
  done

  dialin_emit          # shared dial-in pieces (or removal of them when dial-in is off)
  write_chap_secrets
  write_route_hooks
  apply_nat
  apply_dialin_fw
  apply_require_fw
  apply_client_access

  # ipsec.secrets: replace our block, leave the rest alone
  [ -f "$SECRETS" ] || : > "$SECRETS"
  sed -i '/^# BEGIN l2tp-gw$/,/^# END l2tp-gw$/d' "$SECRETS"
  { echo "# BEGIN l2tp-gw"; cat "$TMP_SECRETS"; echo "# END l2tp-gw"; } >> "$SECRETS"
  chmod 600 "$SECRETS"

  # xl2tpd.conf is fully generated (original saved once)
  if [ -f "$XL2TPD_CONF" ] && [ ! -f "$XL2TPD_CONF.orig-l2tpgw" ] && ! grep -q "managed by l2tp-gw" "$XL2TPD_CONF"; then
    cp "$XL2TPD_CONF" "$XL2TPD_CONF.orig-l2tpgw"
  fi
  cp "$TMP_XL" "$XL2TPD_CONF"
  chmod 644 "$XL2TPD_CONF"

  # forget state files of sites that no longer exist
  if [ -d "$STATE_DIR" ]; then
    for f in "$STATE_DIR"/down-* "$STATE_DIR"/alerted-* "$STATE_DIR"/ddns-* "$STATE_DIR"/noipsec-* "$STATE_DIR"/seen-*; do
      [ -f "$f" ] || continue
      # strip the state-file prefix (longest first) to get the site name
      n=$(basename "$f" | sed -E 's/^(noipsec-alerted|noipsec-last|noipsec-tries|noipsec-giveup|noipsec|down|alerted|ddns|seen)-//')
      grep -qx "$n" "$KEEP" || rm -f "$f"
    done
  fi

  mkdir -p "$STATE_DIR"
  dialin_hash > "$STATE_DIR/dialin.applied"
  if [ "${LIVE:-0}" = 1 ]; then
    live_reconcile            # site-sync: only the sites that were switched on or off are touched
    rm -f "$TMP_SECRETS" "$TMP_XL" "$KEEP" "$TMP_NAT" "$TMP_CHAP" "$TMP_NATD" "$TMP_ALLOWED" "$TMP_PLAIN" "$TMP_REQ" "$TMP_ACTIVE" "$TMP_PREV"
    install_watch_timer
    return 0
  fi
  rm -f "$TMP_SECRETS" "$TMP_XL" "$KEEP" "$TMP_NAT" "$TMP_CHAP" "$TMP_NATD" "$TMP_ALLOWED" "$TMP_PLAIN" "$TMP_REQ" "$TMP_ACTIVE" "$TMP_PREV"

  if [ "$NO_RESTART" != 1 ]; then
    systemctl restart "$(ike_service)" xl2tpd
    mkdir -p "$STATE_DIR"
    for_each_site ddns_record
    echo "Config applied, services restarted. Tunnels can take up to ~1 minute to come up."
    echo "Check with: l2tp-gw status"
  else
    echo "Config generated (NO_RESTART=1, services not restarted)."
  fi
  install_watch_timer
}

# ---------- commands ----------
remove_block() {
  local n=$1 t
  t=$(mktemp)
  awk -v n="[$n]" '/^\[.*\]$/ {skip=($0==n)} !skip {print}' "$SITES" > "$t"
  cat "$t" > "$SITES"
  rm -f "$t"
}

cmd_add() {
  need_root
  mkdir -p "$CONF_DIR"; touch "$SITES"; chmod 600 "$SITES"
  local m
  read -rp "Site name (a-z, 0-9, -; max 11 chars; e.g. site4): " S_NAME
  read -rp "MikroTik public IP or hostname: " S_HOST
  read -rsp "IPsec secret (PSK): " S_PSK; echo
  read -rp "PPP username: " S_USER
  read -rsp "PPP password: " S_PASS; echo
  read -rp "Does this router require PPP encryption (MPPE)? [y/N]: " m
  S_MPPE=no
  case "$m" in y|Y|yes|YES) S_MPPE=yes ;; esac
  echo "Routes to add while this tunnel is up (networks behind this router)."
  echo "Example: 172.16.0.0/24 metric 2, 10.5.0.0/16     (metric optional, default $DEFAULT_METRIC)"
  read -rp "Routes (Enter for none): " S_ROUTES
  read -rp "NAT traffic that leaves through this tunnel (source = this server's tunnel address)? [y/N]: " m
  S_NAT=no
  case "$m" in y|Y|yes|YES) S_NAT=yes ;; esac
  validate_site
  remove_block "$S_NAME"
  {
    echo
    echo "[$S_NAME]"
    echo "host = $S_HOST"
    echo "psk = $S_PSK"
    echo "user = $S_USER"
    echo "pass = $S_PASS"
    echo "mppe = $S_MPPE"
    echo "nat = $S_NAT"
    if [ -n "$S_ROUTES" ]; then echo "routes = $S_ROUTES"; fi
  } >> "$SITES"
  cmd_apply
}

cmd_remove() {
  need_root
  local n=${1:-}
  [ -n "$n" ] || die "Usage: l2tp-gw remove NAME"
  [ -f "$SITES" ] && grep -qxF "[$n]" "$SITES" || die "No site named '$n'"
  remove_block "$n"
  cmd_apply
}

print_site() {
  if [ "$S_MODE" = server ]; then
    printf '%-12s dial-in  user=%s ip=%s nat=%s%s\n' "$S_NAME" "$S_USER" "$S_IP" "$S_NAT" "$([ "$S_DISABLED" = yes ] && echo '  (switched off)')"
    if [ "$S_ACC_INET$S_ACC_CLIENTS$S_ACC_SITES" != yesyesyes ]; then
      printf '%-12s access: internet=%s other-clients=%s outgoing-sites=%s\n' "" "$S_ACC_INET" "$S_ACC_CLIENTS" "$S_ACC_SITES"
    fi
  else
    printf '%-12s %-40s mppe=%s nat=%s%s\n' "$S_NAME" "$S_HOST" "$S_MPPE" "$S_NAT" "$([ "$S_DISABLED" = yes ] && echo '  (switched off)')"
  fi
  if [ -n "$S_ROUTES" ]; then printf '%-12s routes: %s\n' "" "$S_ROUTES"; fi
  if [ -n "$S_REC_EVERY$S_REC_AT" ]; then
    printf '%-12s auto reconnect: %s%s%s\n' "" "${S_REC_EVERY:+every ${S_REC_EVERY}h}" "${S_REC_AT:+ daily at $S_REC_AT}" "${S_REC_WIN:+ (window $S_REC_WIN)}"
  fi
  if [ -n "$S_QUOTA" ]; then printf '%-12s limit: %s GB per %s (%s, warn at %s%%)\n' "" "$S_QUOTA" "$S_QPERIOD" "$S_QDIR" "$S_QWARN"; fi
}
cmd_list() {
  [ -f "$SITES" ] || { echo "(no sites)"; return 0; }
  for_each_site print_site
}

cmd_status() {
  ipsec status 2>/dev/null | grep -E 'ESTABLISHED|CONNECTING' || echo "(no IPsec connections)"
  echo
  ip -br a | grep '^ppp-' || echo "(no ppp interfaces up)"
  if dialin_enabled; then
    echo
    echo "dial-in sessions (ppp0, ppp1 ...):"
    ip -br a | grep -E '^ppp[0-9]' | sed 's/^/  /' || echo "  (nobody connected)"
  fi
  local ifc r
  echo
  echo "NAT toward tunnels (chain L2TPGW-NAT):"
  iptables -t nat -S L2TPGW-NAT 2>/dev/null | grep -- '-A' | sed 's/^/  /' || echo "  (none)"
  local allr
  allr=$(ip route show 2>/dev/null || true)      # read once (the table can hold thousands of routes)
  for ifc in $(ip -br a | awk '/^ppp-|^ppp[0-9]/ {print $1}'); do
    # a multipath route has its own line per tunnel ("nexthop dev X"): show it once, in ONE line ("... via ppp-a, ppp-b"),
    # under every tunnel that is one of its next hops. Routes of the route manager (proto 98: country lists, rules) can be
    # thousands: only their number is shown (the Routes page lists them).
    r=$(printf '%s\n' "$allr" | awk -v d="$ifc" '
      function flush() {
        if (first != "" && hit) {
          if (first ~ / proto 98( |$)/) p98++
          else { s = first; if (nh > 0) s = s " via " devs; print "  " s }
        }
        first = ""; hit = 0; nh = 0; devs = ""
      }
      /^[^ \t]/ { flush(); first = $0; sub(/[ \t]+$/, "", first)
                   if ($0 ~ ("dev " d "([ \t]|$)")) hit = 1; next }
      { if (match($0, /dev [^ \t]+/)) { dv = substr($0, RSTART + 4, RLENGTH - 4); nh++; devs = devs (devs == "" ? "" : ", ") dv }
        if ($0 ~ ("dev " d "([ \t]|$)")) hit = 1 }
      END { flush(); if (p98 > 0) print "  (" p98 " routes of the route manager, proto 98, not listed here - see the Routes page)" }' || true)
    if [ -n "$r" ]; then
      echo
      echo "routes via $ifc:"
      echo "$r"
    fi
  done
}

cmd_setup() {
  need_root
  export DEBIAN_FRONTEND=noninteractive
  echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
  echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections
  apt-get update -y
  apt-get install -y strongswan xl2tpd ppp iptables-persistent

  # forwarding
  echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-forward.conf
  sysctl -p /etc/sysctl.d/99-forward.conf >/dev/null

  # NAT: traffic coming in from any ppp interface leaves with this server's address
  local IF
  IF=$(ip -4 route get 1.1.1.1 | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  [ -n "$IF" ] || die "Could not detect the internet-facing interface"
  add_rule() { local t=$1; shift; iptables -t "$t" -C "$@" 2>/dev/null || iptables -t "$t" -A "$@"; }
  add_rule nat    POSTROUTING -o "$IF" -j MASQUERADE
  add_rule filter FORWARD -i 'ppp+' -j ACCEPT
  add_rule filter FORWARD -o 'ppp+' -m state --state RELATED,ESTABLISHED -j ACCEPT
  add_rule mangle FORWARD -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
  netfilter-persistent save

  # prefer IPv4 when a hostname has both A and AAAA records
  if ! grep -qE '^[[:space:]]*precedence[[:space:]]+::ffff:0:0/96' /etc/gai.conf; then
    echo 'precedence ::ffff:0:0/96  100' >> /etc/gai.conf
  fi

  # same state as the server where this was proven to work
  sed -i 's/^auth$/#auth/' "$PPP_DIR/options"

  # strongSwan reads every file in ipsec.d
  [ -f "$IPSEC_CONF.orig-l2tpgw" ] || cp "$IPSEC_CONF" "$IPSEC_CONF.orig-l2tpgw"
  printf 'config setup\n\ninclude %s/*.conf\n' "$IPSEC_D" > "$IPSEC_CONF"

  mkdir -p "$CONF_DIR"; touch "$SITES"; chmod 600 "$SITES"
  systemctl enable "$(ike_service)" xl2tpd
  echo
  echo "Server prepared (internet interface: $IF)."
  echo "Next: l2tp-gw add"
}

# ---------- extra tools: check, backup, reconnect, logs, watch ----------

# Settings for alerts live in $CONF_DIR/notify.conf  (key = value lines):
#   telegram_token = 123456:ABC...   telegram_chat = 123456789
#   down_after_min = 5               server_name = lightsail-1
conf_get() {   # conf_get KEY  -> value from notify.conf (empty if missing)
  local f="$CONF_DIR/notify.conf"
  [ -f "$f" ] || return 0
  awk -F= -v k="$1" '{ key=$1; gsub(/^[ \t]+|[ \t]+$/, "", key); if (key==k) { sub(/^[^=]*=/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit } }' "$f"
}

# Send a Telegram message. Return 2 if alerts are not configured, 1 if sending failed.
notify_send() {
  local tok chat name
  tok=$(conf_get telegram_token); chat=$(conf_get telegram_chat); name=$(conf_get server_name)
  [ -n "$name" ] || name=$(hostname)
  if [ -z "$tok" ] || [ -z "$chat" ]; then return 2; fi
  # the URL (it contains the token) goes through stdin, so it is not visible in "ps"
  local rc=0
  printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$tok" |
    curl -fsS -m 15 -o /dev/null -K - --data-urlencode "chat_id=$chat" --data-urlencode "text=[$name] $1" || rc=$?
  # remember when the last message was tried and how it ended (the web dashboard shows it)
  { mkdir -p "$STATE_DIR" && printf '%s %s\n' "$(date +%s)" "$rc" > "$STATE_DIR/notify.last"; } 2>/dev/null || true
  return "$rc"
}

# l2tp-gw notify TEXT  (used by the traffic collector for limit warnings)
cmd_notify() {
  local rc=0
  notify_send "$*" || rc=$?
  return 0
}

cmd_notify_test() {
  local rc=0
  notify_send "Test message from l2tp-gw" || rc=$?
  case "$rc" in
    0) echo "Test message sent." ;;
    2) die "Alerts are not set up. Fill telegram_token and telegram_chat in $CONF_DIR/notify.conf" ;;
    *) die "Sending failed (check token, chat id and internet access)." ;;
  esac
}

# resolve a hostname to its first IPv4 address (empty if it does not resolve)
resolve_v4() { getent ahostsv4 "$1" 2>/dev/null | awk 'NR==1 {print $1}' || true; }
is_ipv4() { [[ "$1" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; }

# ---- check: one command that tells whether everything is healthy ----
CHK_FAIL=0
chk() {   # chk LEVEL MESSAGE   (LEVEL = OK | WARN | FAIL)
  printf '%-5s %s\n' "$1" "$2"
  if [ "$1" = FAIL ]; then CHK_FAIL=1; fi
}

# routes of $1 (net) with metric $2: the part of "ip route" output that belongs to that metric
route_block() {
  ip route show exact "$1" 2>/dev/null | awk -v M="$2" '
    function flush() { if (b != "") { if (M == 0 ? b !~ / metric / : b ~ (" metric " M "([ \t\n]|$)")) printf "%s", b; b = "" } }
    /^[^ \t]/ { flush() }
    { b = b $0 "\n" }
    END { flush() }'
}

# regex for "site $1 has an IPsec SA" in the output of "ipsec status":
#  - its own IKE SA line     "name[48]: ESTABLISHED"
#  - or its own child SA line "name{305}:  INSTALLED"
# Two sites with the same MikroTik address share ONE IKE SA (named after the first site), so the second site
# has only the child SA line. Looking only for the IKE line would wrongly report it as "no IPsec".
ipsec_sa_re() {
  printf '^[[:space:]]*%s((\\[[0-9]+\\]: ESTABLISHED)|(\\{[0-9]+\\}:[[:space:]]+INSTALLED))' "$1"
}

# chk_mtu_road NAME IFC: the packet-size tests of this tunnel (files mtu-test/NAME.far / NAME.ded, written by the watcher) as health lines.
# Only things that are true are said: the size passes, or it does not and what the tests found. Nothing here is changed by itself.
chk_mtu_road() {
  local n=$1 ifc=$2 live fl st sug key lab fe t
  live=$(cat "${SYS_NET:-/sys/class/net}/$ifc/mtu" 2>/dev/null || echo 0)
  tst_cfg
  fl=$T_FLOOR
  if [ "$live" -gt 0 ] && [ "$live" -lt "$fl" ]; then chk WARN "$n: the size of this link is $live, below the lowest size $fl (the far router asked for less): nothing is cut, check its MRU"; fi
  for key in far ded; do
    f="$STATE_DIR/mtu-test/$n.$key"; [ -f "$f" ] || continue
    case "$key" in far) lab="far end of the tunnel" ;; *) lab="test address $S_TEST_ADDR" ;; esac
    st=$(mt_get "$f" state); sug=$(mt_get "$f" suggest); t=$(mt_get "$f" t)
    case "$st" in
      ok)       chk OK "$n: the packet size $live passes ($lab)" ;;
      found)    chk WARN "$n: a packet of $live does not pass ($lab); the biggest size found that passes is $sug (a suggestion: change the MTU of this connection and save)" ;;
      stepping) chk WARN "$n: a packet of $live does not pass ($lab); going down to find the size that passes ($(mt_get "$f" next) is the next one tried)" ;;
      floor)    chk WARN "$n: even the lowest size $fl does not pass ($lab)" ;;
      *) : ;;
    esac
  done
}

# one dial-in site: connected or not (not connected is only a warning: routers behind NAT come and go)
check_server_site() {
  local n=$S_NAME ifc net metric blk up=0
  if [ "$S_DISABLED" = yes ]; then chk OK "$n: dial-in site is switched off"; return 0; fi
  ifc=$(ifc_by_peer "$S_IP")
  if [ -n "$ifc" ] && iface_up "$ifc"; then
    up=1
    chk OK "$n: dial-in connected ($ifc, router address $S_IP)"
    chk_mtu_road "$n" "$ifc"
    local mtu_now
    mtu_now=$(cat "${SYS_NET:-/sys/class/net}/$ifc/mtu" 2>/dev/null || true)
    case "$mtu_now" in ''|*[!0-9]*) ;; *)
      if iptables -t mangle -C L2TPGW-MSS -i "$ifc" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$((mtu_now - 40))" 2>/dev/null; then
        chk OK "$n: TCP size (MSS) is cut to $((mtu_now - 40)) both ways (link MTU $mtu_now)"
      else
        chk WARN "$n: no TCP size rule for $ifc at MTU $mtu_now yet (run: l2tp-gw mss-apply)"
      fi ;;
    esac
  else
    chk WARN "$n: dial-in site is not connected"
  fi
  if [ -f "$CONF_DIR/routes.d/$n" ]; then
    while read -r net metric; do
      [ -n "$net" ] || continue
      blk=$(route_block "$net" "$metric")
      if [ "$up" = 1 ] && printf '%s' "$blk" | grep -q "dev $ifc"; then
        chk OK "$n: route $net metric $metric via $ifc"
      elif [ "$up" = 1 ]; then
        chk FAIL "$n: route $net metric $metric is missing (see $CONF_DIR/routes.log)"
      fi
    done < "$CONF_DIR/routes.d/$n"
  fi
}

# esp_bytes NAME: "bytes_in bytes_out" of the IPsec child connection of a site, read now (empty when not found)
esp_bytes() {
  local l bi bo
  l=$(ipsec statusall 2>/dev/null | grep -E "^[[:space:]]*${1}\{[0-9]+\}:.*bytes_i" | tail -n1 || true)
  [ -n "$l" ] || return 0
  bi=$(printf '%s' "$l" | sed -n 's/.* \([0-9]\+\) bytes_i.*/\1/p'); bo=$(printf '%s' "$l" | sed -n 's/.* \([0-9]\+\) bytes_o.*/\1/p')
  [ -n "$bi" ] && [ -n "$bo" ] && echo "$bi $bo"
  return 0
}
chk_hosts_cb() {      # which outgoing sites dial the same far address (they share one IPsec connection)
  [ "$S_MODE" != server ] && [ "$S_DISABLED" != yes ] && [ -n "$S_HOST" ] || return 0
  CHK_HOSTSITES[${S_HOST,,}]="${CHK_HOSTSITES[${S_HOST,,}]:-} $S_NAME"
}
check_site() {
  validate_site
  if [ "$S_MODE" = server ]; then check_server_site; return 0; fi
  if [ "$S_DISABLED" = yes ]; then chk OK "$S_NAME: site is switched off"; return 0; fi
  local n=$S_NAME ifc="ppp-$S_NAME" ppp_up=0 ipsec_ok=0 line bi bo net metric blk ip4 addr peer mode=${S_IPSEC_MODE:-heal}
  # IPsec
  if printf '%s\n' "$CHK_IPSEC" | grep -Eq "$(ipsec_sa_re "$n")"; then
    ipsec_ok=1
    chk OK "$n: IPsec established"
  elif [ "$mode" = allow ]; then
    chk WARN "$n: no IPsec SA (allowed by ipsec_mode = allow)"
  else
    chk FAIL "$n: IPsec is not established"
  fi
  if [ "$mode" = require ]; then
    if iptables -S L2TPGW-REQ 2>/dev/null | grep -q -- '--pol ipsec'; then
      chk OK "$n: plain (non-IPsec) UDP 1701 from this router is blocked (ipsec_mode = require)"
    else
      chk WARN "$n: ipsec_mode = require but the firewall rule L2TPGW-REQ is missing (run: l2tp-gw apply)"
    fi
  fi
  # PPP
  if iface_up "$ifc"; then
    ppp_up=1
    addr=$(ip -o -4 addr show dev "$ifc" | awk '{print $4}' | head -n1)
    peer=$(ip -o -4 addr show dev "$ifc" | awk '{for(i=1;i<=NF;i++) if($i=="peer"){sub("/.*","",$(i+1)); print $(i+1); exit}}')
    chk OK "$n: PPP up ($ifc ${addr:-?} -> ${peer:-?})"
    if [ -n "$peer" ]; then CHK_PEER[$n]=$peer; fi
    chk_mtu_road "$n" "$ifc"
    local mtu_now
    mtu_now=$(cat "${SYS_NET:-/sys/class/net}/$ifc/mtu" 2>/dev/null || true)
    case "$mtu_now" in ''|*[!0-9]*) ;; *)
      if iptables -t mangle -C L2TPGW-MSS -i "$ifc" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$((mtu_now - 40))" 2>/dev/null \
         && iptables -t mangle -C L2TPGW-MSS -o "$ifc" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$((mtu_now - 40))" 2>/dev/null; then
        chk OK "$n: TCP size (MSS) is cut to $((mtu_now - 40)) both ways (link MTU $mtu_now)"
      else
        chk WARN "$n: no TCP size rule for $ifc at MTU $mtu_now yet (run: l2tp-gw mss-apply)"
      fi ;;
    esac
    # PPP without an IPsec SA means plain L2TP: the MikroTik accepted it (use-ipsec=yes), but it is NOT encrypted
    if [ "$ipsec_ok" = 0 ] && [ "$mode" != allow ]; then
      chk FAIL "$n: PPP is up but IPsec is NOT established - traffic is not encrypted (on the MikroTik use-ipsec=require refuses this)"
    fi
  else
    chk FAIL "$n: PPP interface $ifc is down"
  fi
  # Sites with the same far address share ONE IPsec connection: its counters cannot be told apart per tunnel
  local others="" k
  for k in ${CHK_HOSTSITES[${S_HOST,,}]:-}; do [ "$k" = "$n" ] || others="$others $k"; done
  if [ -n "$others" ]; then
    chk WARN "$n: shares one IPsec connection with$others (same far address $S_HOST): encrypted-bytes counters and measurements cannot be told apart per tunnel. Give each tunnel its own address on the far router"
  else
  # ESP counters: PPP is carried inside ESP, so both directions must count bytes
  line=$(printf '%s\n' "$CHK_IPSEC_ALL" | grep -E "^[[:space:]]*${n}\{[0-9]+\}:.*bytes_i" | tail -n1 || true)
  if [ -n "$line" ]; then
    bi=$(printf '%s' "$line" | sed -n 's/.* \([0-9]\+\) bytes_i.*/\1/p')
    bo=$(printf '%s' "$line" | sed -n 's/.* \([0-9]\+\) bytes_o.*/\1/p')
    if [ "${bi:-0}" -gt 0 ] && [ "${bo:-0}" -gt 0 ]; then
      chk OK "$n: ESP traffic both ways (in ${bi} B, out ${bo} B)"
    elif [ "$ppp_up" = 1 ]; then
      chk WARN "$n: PPP is up but ESP counters are in=${bi:-?} out=${bo:-?} - traffic may not be encrypted"
    else
      chk WARN "$n: no ESP traffic yet"
    fi
  elif [ "$ppp_up" = 1 ]; then
    chk WARN "$n: cannot read ESP counters from 'ipsec statusall'"
  fi
  # live proof: a few pings through THIS tunnel must make its own IPsec counters grow (the totals above are only "ever counted")
  if [ "$ppp_up" = 1 ] && [ "$ipsec_ok" = 1 ] && [ -n "${peer:-}" ] && [ -n "$line" ] && command -v ping >/dev/null 2>&1; then
    local b1 b2 i1 o1 i2 o2
    b1=$(esp_bytes "$n"); read -r i1 o1 <<< "$b1"
    if ping -c 3 -i 0.2 -W 1 -n -q -I "$ifc" "$peer" >/dev/null 2>&1; then
      b2=$(esp_bytes "$n"); read -r i2 o2 <<< "$b2"
      if [ -n "${i1:-}" ] && [ -n "${i2:-}" ]; then
        if [ "$i2" -gt "$i1" ] && [ "$o2" -gt "$o1" ]; then chk OK "$n: live test: test pings were counted by IPsec (out +$((o2 - o1)) B, in +$((i2 - i1)) B): encrypted"
        else chk WARN "$n: live test: pings through the tunnel were answered but its IPsec counters did not grow: the traffic may not be encrypted"; fi
      fi
    fi
  fi
  fi
  # routes
  if [ -f "$CONF_DIR/routes.d/$n" ]; then
    while read -r net metric; do
      [ -n "$net" ] || continue
      blk=$(route_block "$net" "$metric")
      if printf '%s' "$blk" | grep -q "dev $ifc"; then
        chk OK "$n: route $net metric $metric via $ifc"
      elif [ "$ppp_up" = 1 ]; then
        chk FAIL "$n: route $net metric $metric is missing (see $CONF_DIR/routes.log)"
      else
        chk WARN "$n: route $net metric $metric not present (tunnel down)"
      fi
    done < "$CONF_DIR/routes.d/$n"
  fi
  # NAT toward this tunnel
  if [ "$S_NAT" = yes ]; then
    if iptables -t nat -C L2TPGW-NAT -o "$ifc" -j MASQUERADE 2>/dev/null; then
      chk OK "$n: NAT on"
    else
      chk FAIL "$n: NAT is set to yes but the iptables rule is missing (run: l2tp-gw apply)"
    fi
  fi
  # DDNS name
  if ! is_ipv4 "$S_HOST"; then
    ip4=$(resolve_v4 "$S_HOST")
    if [ -n "$ip4" ]; then chk OK "$n: $S_HOST resolves to $ip4"; else chk WARN "$n: $S_HOST does not resolve right now"; fi
  fi
}

# ---- MTU: a FIXED number or "auto" (see "mtu =" in the sites file) ----
# qconf_val KEY DEFAULT: a default from quality.conf (the Settings page)
qconf_val() {
  local v
  v=$(awk -F= -v k="$1" '{ key=$1; gsub(/^[ \t]+|[ \t]+$/, "", key); if (key==k) { sub(/^[^=]*=/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit } }' "$CONF_DIR/quality.conf" 2>/dev/null || true)
  printf '%s' "${v:-$2}"
}
# ---- the packet size of a tunnel: ONE fixed number, never changed while the tunnel is up ----
# dir_name: "in" = dial-in client, "out" = outgoing site (the site being handled)
dir_name() { if [ "$S_MODE" = server ]; then echo in; else echo out; fi; }
# dir_val KEY DEFAULT: the value of KEY for the site being handled: its own (S_KEY), else the Settings default of its direction
# (quality.conf: KEY_in / KEY_out), else the older plain Settings key, else DEFAULT (used only when Settings has nothing).
dir_val() {
  local var="S_${1^^}" v d
  v=${!var:-}
  if [ -z "$v" ]; then d=$(dir_name); v=$(qconf_val "${1}_$d" ""); fi
  if [ -z "$v" ]; then v=$(qconf_val "$1" ""); fi
  printf '%s' "${v:-$2}"
}
# mtu_value: the packet size of the site being handled. Outgoing: its own "mtu", else mtu_default_out of Settings.
# Dial-in clients have no number of their own (they share one pppd file): mtu_default_in of Settings. 1280 only when Settings has nothing.
mtu_value() {
  local v=""
  [ "$S_MODE" = server ] || v=${S_MTU:-}
  case "$v" in ''|auto) v=$(qconf_val "mtu_default_$(dir_name)" 1280) ;; esac
  case "$v" in
    ''|*[!0-9]*) v=1280 ;;
    *) v=$((10#$v)); if [ "$v" -lt 576 ] || [ "$v" -gt 1500 ]; then v=1280; fi ;;
  esac
  printf '%s' "$v"
}
# mtu_offer: the size given to pppd of an outgoing site: what we say we receive (mru) and the most we send (mtu)
mtu_offer() { mtu_value; }
# dialin_announce: ONE size for all dial-in clients (they share one pppd options file, and pppd offers its MRU before it knows who calls)
dialin_announce() { ( S_MODE=server; S_MTU=""; mtu_value ); }
# dialin_mtu_rewrite: only the two size lines of the shared pppd file (it is read when a new session starts: no restart needed)
dialin_mtu_rewrite() {
  local f="$PPP_DIR/options.l2tpd.dialin" a
  [ -f "$f" ] || return 0
  a=$(dialin_announce)
  if grep -qx "mtu $a" "$f" && grep -qx "mru $a" "$f"; then return 0; fi
  sed -i -e "s/^mtu .*/mtu $a/" -e "s/^mru .*/mru $a/" "$f"
  echo "dial-in: the size offered to the routers is now $a (each client gets it the next time it connects)"
}
# mtu_write_ppp_options NAME SIZE: the two size lines of an outgoing site's pppd file (read at the next connect)
mtu_write_ppp_options() {
  local f="$PPP_DIR/options.l2tpd.$1"
  [ -f "$f" ] || return 0
  sed -i -e "s/^mtu .*/mtu $2/" -e "s/^mru .*/mru $2/" "$f"
}
mtu_log() {      # NAME KIND LABEL TEXT (kind: info|warn|bad)
  local now; now=$(date +%s)
  echo "$(date '+%F %T') $1 $3: $4" >> "$STATE_DIR/watch.log"
  printf '{"t": %s, "k": "%s", "m": "%s"}\n' "$now" "$2" "$1: $3 - $4" >> "$STATE_DIR/events.log" 2>/dev/null || true
  [ "$(conf_get quality_alert)" = no ] || notify_send "$1: $3 - $4" || true
}
# mtu_note NAME KEY: a problem of kind KEY is present. Returns 1 the FIRST time (so it is told once, not every run), 0 while it stays.
# mtu_clear NAME KEY: the problem is gone (it will be told again if it comes back).
mtu_note() { mkdir -p "$STATE_DIR/mtu-note"; local f="$STATE_DIR/mtu-note/$1.$2"; [ ! -f "$f" ] || return 0; : > "$f"; return 1; }
mtu_clear() { rm -f "$STATE_DIR/mtu-note/$1.$2"; }
mtu_live() { cat "${SYS_NET:-/sys/class/net}/$1/mtu" 2>/dev/null || true; }
# mtu_pass DEV ADDR SIZE: do packets of exactly this link size (MTU_COUNT of them, not allowed to be split) go through the tunnel and come back?
# Yes when 71 percent or more come back (the orange / green colours of the tests).
mtu_pass() { local c=${MTU_COUNT:-5} r rx; r=$(bigping "$1" "$2" "$3" "$c"); rx=${r% *}; [ $(( rx * 100 / c )) -ge 71 ]; }
# mtu_find_max FUNCTION: the biggest payload (56..1472) for which FUNCTION SIZE succeeds
mtu_find_max() {
  local fn=$1 l=56 h=1472 m
  if "$fn" "$h"; then echo "$h"; return; fi
  while [ "$l" -lt "$h" ]; do m=$(( (l + h + 1) / 2 )); if "$fn" "$m"; then l=$m; else h=$((m - 1)); fi; done
  echo "$l"
}
MTU_OPROBE_ADDR=""
mtu_oprobe() { ping -c 2 -i 0.3 -W 2 -n -q -M do -s "$1" "$MTU_OPROBE_ADDR" >/dev/null 2>&1; }
# mtu_outer_road ADDRESS: the biggest packet that goes WITHOUT being split on the road to the far router's public address (empty: it does not answer ping)
mtu_outer_road() {
  local o
  [ -n "${1:-}" ] || return 0
  MTU_OPROBE_ADDR=$1
  mtu_oprobe 56 || return 0
  o=$(( $(mtu_find_max mtu_oprobe) + 28 )); [ "$o" -le 1500 ] || o=1500
  echo "$o"
}

# ---- the tests of a connection (every test_every minutes, from the watcher) ----
# tst_cfg: T_COUNT (pings per test), T_EVERY (minutes between tests), T_FLOOR (lowest size), T_STEP / T_WAIT (how the size goes down)
# of the site being handled: its own value, else the Settings default of its direction, else a built-in value.
tst_num() { case "$1" in ''|*[!0-9]*) echo "$2" ;; *) echo $((10#$1)) ;; esac; }
tst_cfg() {
  local d; d=$(dir_name)
  T_COUNT=$(tst_num "$(dir_val ping_count 10)" 10); [ "$T_COUNT" -ge 3 ] || T_COUNT=10
  T_EVERY=$(tst_num "$(dir_val test_every 1)" 1); [ "$T_EVERY" -ge 1 ] || T_EVERY=1
  T_FLOOR=$(tst_num "$(dir_val mtu_min 1250)" 1250)
  T_STEP=$(tst_num "$(qconf_val "mtu_step_$d" 5)" 5); [ "$T_STEP" -ge 1 ] || T_STEP=5
  T_WAIT=$(tst_num "$(qconf_val "mtu_step_wait_$d" 1)" 1); [ "$T_WAIT" -ge 1 ] || T_WAIT=1
}
# mt_get FILE KEY / mt_put FILE "k=v k=v": the one-line state files (mtu-test/NAME.far, NAME.ded)
mt_get() { { tr ' ' '\n' < "$1" | sed -n "s/^$2=//p" | head -n1; } 2>/dev/null || true; }
mt_put() { mkdir -p "$(dirname "$1")"; printf '%s\n' "$2" > "$1.tmp" && mv "$1.tmp" "$1"; chmod 644 "$1" 2>/dev/null || true; }
# bigping DEV ADDR SIZE COUNT -> "RECEIVED TOOBIG": COUNT packets of exactly SIZE bytes (not allowed to be split).
# TOOBIG is 1 when a "packet too big / needs to be split" message came back.
bigping() {
  local out rx tb=0
  out=$(ping -c "$4" -i 0.2 -W 1 -n -M do -s "$(( $3 - 28 ))" -I "$1" "$2" 2>&1) || true
  rx=$(printf '%s\n' "$out" | sed -n 's/.* \([0-9]*\) received.*/\1/p' | head -n1); rx=${rx:-0}
  if printf '%s\n' "$out" | grep -qiE 'frag(mentation)? needed|message too long|too big|too large|needs to be fragmented'; then tb=1; fi
  echo "$rx $tb"
}
# mtu_probe NAME KEY DEV ADDR SMALLPCT DUE: the packet-size part of a test, for one address (KEY far|ded) of one connection.
# Each regular test starts again from the size the link has NOW. Going down happens ONLY when that size does not pass; then every
# T_WAIT minute(s) one step of T_STEP down (never below T_FLOOR), until a size passes. Nothing is changed by it: the result is a suggestion.
# State file mtu-test/NAME.KEY: t live state pct tb suggest next stepat floor
#   ok        the size of the link passes
#   stepping  it does not pass (small packets do): "next" is the size tried at "stepat"
#   found     the biggest size that passes (suggest)
#   floor     nothing passes down to the lowest size
#   none      small packets are lost too: nothing can be said about the size
mtu_probe() {
  local name=$1 key=$2 dev=$3 addr=$4 spct=$5 due=$6 f="$STATE_DIR/mtu-test/$1.$2" now live st next stepat r rx tb pct size
  now=$(date +%s); live=$(mtu_live "$dev"); case "$live" in ''|*[!0-9]*) return 0 ;; esac
  st=$(mt_get "$f" state); next=$(mt_get "$f" next); stepat=$(mt_get "$f" stepat)
  case "$next" in ''|*[!0-9]*) next=0 ;; esac; case "$stepat" in ''|*[!0-9]*) stepat=0 ;; esac
  if [ "$st" = stepping ] && [ -z "${Q_FORCE:-}" ]; then      # (the "Test now" button starts again from the size of the tunnel)
    [ "$now" -ge "$stepat" ] || return 0
    size=$next
    r=$(bigping "$dev" "$addr" "$size" "$T_COUNT"); rx=${r% *}; tb=${r#* }
    pct=$(( (rx * 100 + T_COUNT / 2) / T_COUNT ))
    if [ "$pct" -ge 71 ]; then
      mt_put "$f" "t=$now live=$live state=found pct=$pct tb=$tb suggest=$size next=0 stepat=0 floor=$T_FLOOR"
    elif [ "$size" -le "$T_FLOOR" ]; then
      mt_put "$f" "t=$now live=$live state=floor pct=$pct tb=$tb suggest=0 next=0 stepat=0 floor=$T_FLOOR"
    else
      next=$(( size - T_STEP )); [ "$next" -ge "$T_FLOOR" ] || next=$T_FLOOR
      mt_put "$f" "t=$now live=$live state=stepping pct=$pct tb=$tb suggest=0 next=$next stepat=$(( now + T_WAIT * 60 )) floor=$T_FLOOR"
    fi
    return 0
  fi
  [ "$due" = 1 ] || return 0
  if [ "$spct" -lt 71 ]; then
    mt_put "$f" "t=$now live=$live state=none pct=0 tb=0 suggest=0 next=0 stepat=0 floor=$T_FLOOR"; return 0
  fi
  r=$(bigping "$dev" "$addr" "$live" "$T_COUNT"); rx=${r% *}; tb=${r#* }
  pct=$(( (rx * 100 + T_COUNT / 2) / T_COUNT ))
  if [ "$tb" = 0 ] && [ "$pct" -ge 71 ]; then
    mt_put "$f" "t=$now live=$live state=ok pct=$pct tb=$tb suggest=0 next=0 stepat=0 floor=$T_FLOOR"
  elif [ "$live" -le "$T_FLOOR" ]; then
    mt_put "$f" "t=$now live=$live state=floor pct=$pct tb=$tb suggest=0 next=0 stepat=0 floor=$T_FLOOR"
  else
    next=$(( live - T_STEP )); [ "$next" -ge "$T_FLOOR" ] || next=$T_FLOOR
    mt_put "$f" "t=$now live=$live state=stepping pct=$pct tb=$tb suggest=0 next=$next stepat=$(( now + T_WAIT * 60 )) floor=$T_FLOOR"
  fi
}
# test_route_set DEV ADDR: the test address of a connection always goes through ITS tunnel: a host route with metric 1
test_route_set() {
  ip route show "$2/32" dev "$1" 2>/dev/null | grep -q 'metric 1\b' && return 0
  ip route replace "$2/32" dev "$1" metric 1 2>/dev/null || true
}
test_route_cb() {
  [ "$S_DISABLED" != yes ] && [ -n "$S_TEST_ADDR" ] || return 0
  local ifc
  if [ "$S_MODE" = server ]; then ifc=$(ifc_by_peer "$S_IP"); else ifc="ppp-$S_NAME"; iface_up "$ifc" || return 0; fi
  [ -n "$ifc" ] || return 0
  if [ -n "${MTU_ONLY:-}" ] && [ "$ifc" != "$MTU_ONLY" ]; then return 0; fi
  test_route_set "$ifc" "$S_TEST_ADDR"
}
# mtu-apply [IFACE]: called when a tunnel comes up (ip-up hook) and by dialin-sync. It no longer touches any size (a live tunnel keeps
# its size): it puts the test-address route in place and refreshes the TCP size rules.
cmd_mtu_apply() { MTU_ONLY=${1:-}; for_each_site test_route_cb; MTU_ONLY=""; cmd_mss_apply || true; }

# mss-apply: the TCP segment size (MSS) of every tunnel is cut to "link MTU - 40" in BOTH directions (chain L2TPGW-MSS in the mangle table).
# The older rule (--clamp-mss-to-pmtu) only looks at the interface a packet LEAVES by, so the SYN that goes from the router out to the
# Internet kept its big MSS and the Internet server then sent packets that are too big for the tunnel. --set-mss never raises a value.
# Rebuilt only when the list of tunnels or an MTU changed (signature file), so it is cheap to call every minute.
cmd_mss_apply() {
  command -v iptables >/dev/null 2>&1 || return 0
  local dev mtu pair sig="" ipt=iptables
  for dev in $(ip -o link show 2>/dev/null | awk -F': ' '$2 ~ /^ppp/ {sub("@.*", "", $2); print $2}'); do
    mtu=$(cat "${SYS_NET:-/sys/class/net}/$dev/mtu" 2>/dev/null) || continue
    case "$mtu" in ''|*[!0-9]*) continue ;; esac
    [ "$mtu" -ge 576 ] || continue
    sig="$sig $dev:$mtu"
  done
  if [ "$sig" = "$(cat "$STATE_DIR/mss-sig" 2>/dev/null)" ] && "$ipt" -t mangle -S L2TPGW-MSS >/dev/null 2>&1 \
     && "$ipt" -t mangle -C FORWARD -j L2TPGW-MSS 2>/dev/null; then return 0; fi
  "$ipt" -t mangle -N L2TPGW-MSS 2>/dev/null || true
  "$ipt" -t mangle -F L2TPGW-MSS
  for pair in $sig; do
    dev=${pair%%:*}; mtu=${pair##*:}
    "$ipt" -t mangle -A L2TPGW-MSS -i "$dev" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$((mtu - 40))"
    "$ipt" -t mangle -A L2TPGW-MSS -o "$dev" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --set-mss "$((mtu - 40))"
  done
  "$ipt" -t mangle -C FORWARD -j L2TPGW-MSS 2>/dev/null || "$ipt" -t mangle -I FORWARD 1 -j L2TPGW-MSS
  mkdir -p "$STATE_DIR" && printf '%s\n' "$sig" > "$STATE_DIR/mss-sig"
  [ -n "${QUIET:-}" ] || echo "TCP size rules (MSS): $(printf '%s\n' $sig | grep -c .) tunnel(s)${sig:+ -$sig}"
}

# ---- the real connection of a link: how long it has been up and, for dial-in clients, from which public address ----
# pppd writes its process number to /var/run/IFACE.pid; the age of that process is how long the connection really lasts
# (it does not depend on the per-minute log, so a quick disconnect/reconnect is seen at once).
ppp_pid() { local p; p=$(head -n1 "${PPP_RUN:-/var/run}/$1.pid" 2>/dev/null || true); case "$p" in ''|*[!0-9]*) return 1 ;; esac; echo "$p"; }
ppp_age() {      # IFACE: seconds the connection is up (empty when unknown)
  local p a; p=$(ppp_pid "$1") || return 0
  a=$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ' || true)
  case "$a" in ''|*[!0-9]*) ;; *) echo "$a" ;; esac
}
ppp_peer_public() {      # IFACE of a dial-in client: the public address its router connects from (empty when unknown)
  local p tid
  p=$(ppp_pid "$1") || return 0
  tid=$(tr '\0' ' ' < "${PROC_DIR:-/proc}/$p/cmdline" 2>/dev/null | sed -n 's/.*pppol2tp_tunnel_id \([0-9]*\).*/\1/p' || true)
  [ -n "$tid" ] || return 0
  ip l2tp show tunnel 2>/dev/null | awk -v t="$tid" '$1=="Tunnel" { x=$2; gsub(",", "", x); on=(x==t) } on && $1=="From" { sub(":.*", "", $4); print $4; exit }' || true
}
# link-info: one line per connected site:  NAME IFACE SECONDS PUBLIC_ADDRESS   ("-" = not known). Used by the panel.
link_info_cb() {
  [ "$S_DISABLED" != yes ] || return 0
  local dev age pub=-
  if [ "$S_MODE" = server ]; then dev=$(ifc_by_peer "$S_IP"); else dev="ppp-$S_NAME"; fi
  [ -n "$dev" ] && iface_up "$dev" || return 0
  age=$(ppp_age "$dev"); [ -n "$age" ] || age=-
  if [ "$S_MODE" = server ]; then pub=$(ppp_peer_public "$dev"); [ -n "$pub" ] || pub=-; fi
  echo "$S_NAME $dev $age $pub"
}
cmd_link_info() { for_each_site link_info_cb; }

mtu_find_cb() {      # finds the tunnel interface and the far address of site MTU_NAME (or of the site that owns interface MTU_BYDEV)
  local dev addr
  if [ "$S_MODE" = server ]; then dev=$(ifc_by_peer "$S_IP"); addr=$S_IP
  else
    dev="ppp-$S_NAME"
    addr=$(ip -o -4 addr show dev "$dev" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="peer"){sub("/.*","",$(i+1)); print $(i+1); exit}}')
  fi
  if [ -n "${MTU_NAME:-}" ]; then [ "$S_NAME" = "$MTU_NAME" ] || return 0
  else [ -n "$dev" ] && [ "$dev" = "${MTU_BYDEV:-}" ] || return 0; fi
  MTU_DEV=$dev; MTU_ADDR=$addr; MTU_SITE=$S_NAME; MTU_OUTER=""
  if [ "$S_MODE" = server ]; then      # public address of THIS router: from its own tunnel; if that cannot be read, from the IPsec list when only one client is connected
    MTU_OUTER=$(ppp_peer_public "$dev")
    if [ -z "$MTU_OUTER" ]; then
      MTU_OUTER=$(ipsec status 2>/dev/null | sed -n 's/^l2tp-gw-dialin\[[0-9]*\]: ESTABLISHED.*\.\.\.\([0-9.]*\)\[.*/\1/p' | sort -u)
      [ "$(printf '%s\n' "$MTU_OUTER" | grep -c .)" = 1 ] || MTU_OUTER=""
    fi
  else
    MTU_OUTER=$S_HOST; is_ipv4 "$MTU_OUTER" || MTU_OUTER=$(resolve_v4 "$MTU_OUTER")
  fi
  MTU_WANT=$(mtu_offer)
  MTU_FOUND=1
}

# route_devs ADDRESS: what the routing table says about ADDRESS: "PREFIX METRIC DEV [DEV ...]" (several DEV = a multipath route,
# the traffic is shared between them). The most specific route wins, like in the kernel. Empty when it cannot be read.
route_devs() {
  command -v python3 >/dev/null 2>&1 || return 0
  ip -j route show to match "$1" 2>/dev/null | python3 -c '
import json, sys
try: rs = json.load(sys.stdin)
except Exception: sys.exit(0)
def plen(r):
    d = r.get("dst", "default")
    return 0 if d == "default" else int(d.split("/")[1]) if "/" in d else 32
best = None
for r in rs:
    if r.get("type", "unicast") != "unicast": continue
    k = (plen(r), -int(r.get("metric", 0)))
    if best is None or k > best[0]: best = (k, r)
if best:
    r = best[1]
    devs = [n["dev"] for n in r.get("nexthops", []) if "dev" in n] or ([r["dev"]] if "dev" in r else [])
    print(r.get("dst", "default"), r.get("metric", 0), *devs)
' 2>/dev/null
}

# mtu-test NAME|ADDRESS [IFACE]: the biggest packet (DF set, no fragmentation) that gets an answer, found by halving.
# NAME    = a connected site: its tunnel, and the road to its router.
# ADDRESS = any address: the routing table says which tunnel (or the internet) it leaves through, each way of a multipath route is
#           measured on its own; if that way is a tunnel of ours, the road to the router and the router's own limit count too.
# IFACE   = (optional, only with an address) force one interface instead of asking the routing table.
# Nothing is raised or changed: the link keeps its size, so no result is ever above it. Nothing in the settings is changed.
# One line per way:  RESULT addr=A dev=D current=N max=M suggested=S inner=I outer=O lowered=L [site=NAME] [prefix=P]
cmd_mtu_test() {
  need_root
  local target=${1:-} via=${2:-} addr="" dev="" pfx="" metric="" devs=() d rc=0 tmp_route="" tx0=0
  [ -n "$target" ] || die "Usage: l2tp-gw mtu-test SITE_NAME|ADDRESS [INTERFACE]"
  MTU_COUNT=$(tst_num "$(qconf_val ping_count_out 10)" 10); [ "$MTU_COUNT" -ge 3 ] || MTU_COUNT=5
  command -v ping >/dev/null 2>&1 || die "ping is not installed (apt-get install iputils-ping)"
  if is_ipv4 "$target"; then
    addr=$target
    if [ -n "$via" ]; then
      devs=("$via"); echo "Path: you chose the interface $via: $addr is sent through that tunnel."
      if ! ip route show "$addr/32" dev "$via" 2>/dev/null | grep -q 'metric 1\b'; then
        if ip route add "$addr/32" dev "$via" metric 1 2>/dev/null; then tmp_route=1; echo "A temporary route for $addr through $via (metric 1) was added; it is removed after the test."
        else echo "The temporary route could not be added; the packets are still forced through $via."; fi
      fi
      tx0=$(cat "${SYS_NET:-/sys/class/net}/$via/statistics/tx_packets" 2>/dev/null || echo 0)
    else
      local rd rest=""
      rd=$(route_devs "$addr"); read -r pfx metric rest <<< "$rd"
      if [ -n "$rest" ]; then read -r -a devs <<< "$rest"
      else devs=("$(ip route get "$addr" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)"); pfx="?"; fi
      [ -n "${devs[0]:-}" ] || die "No route to $addr"
      echo "Path: the routing table sends $addr by the route $pfx (metric ${metric:-0}) through: ${devs[*]}."
      [ "${#devs[@]}" -lt 2 ] || echo "This is a multipath route: the traffic is shared between these ways, so each one is measured on its own."
    fi
    for d in "${devs[@]}"; do mtu_measure "$addr" "$d" "" "$pfx" || rc=1; done
    if [ -n "$via" ]; then       # the proof that the packets really went through that tunnel, then the temporary route goes
      local rg tx1
      rg=$(ip route get "$addr" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)
      tx1=$(cat "${SYS_NET:-/sys/class/net}/$via/statistics/tx_packets" 2>/dev/null || echo 0)
      if [ "$rg" = "$via" ] && [ "$((tx1 - tx0))" -ge 1 ]; then echo "Proof: the routing table sends $addr through $via, and $((tx1 - tx0)) packets left through it during the test."
      else echo "NOT PROVEN: the routing table says $addr leaves through '${rg:-?}', and $((tx1 - tx0)) packets were counted on $via. Do not trust this result for that tunnel."; rc=1; fi
      [ -z "$tmp_route" ] || ip route del "$addr/32" dev "$via" metric 1 2>/dev/null || true
    fi
    return $rc
  fi
  MTU_NAME=$target; MTU_BYDEV=""; MTU_FOUND=""; MTU_DEV=""; MTU_ADDR=""; MTU_OUTER=""; MTU_WANT=""; MTU_SITE=""
  for_each_site mtu_find_cb
  [ -n "$MTU_FOUND" ] || die "No site named '$target' (use a site name or an IPv4 address)"
  [ -n "$MTU_DEV" ] && iface_up "$MTU_DEV" && [ -n "$MTU_ADDR" ] || die "Site '$target' is not connected: nothing to measure"
  echo "Path: site $target, through the tunnel interface $MTU_DEV to $MTU_ADDR."
  mtu_check_site "$MTU_SITE" "${via:-$MTU_DEV}" "$MTU_ADDR" "$MTU_OUTER"
}

# mtu_check_site NAME DEV ADDR [OUTER]: the real test of one connected site, with the size it has NOW. Nothing is raised or changed.
# It answers one question: does a packet of exactly the MTU of this tunnel go through and come back? If not, it goes down by
# "mtu_step" (default 20) and tells the biggest size that does.
mtu_check_site() {
  local name=$1 dev=$2 addr=$3 oip=${4:-} cur s step best=0 pass=no outer=""
  cur=$(mtu_live "$dev"); case "$cur" in ''|*[!0-9]*) die "Cannot read the MTU of $dev" ;; esac
  step=$(tst_num "$(qconf_val mtu_step_out 5)" 5); [ "$step" -ge 1 ] || step=5
  if ! ping -c 2 -i 0.3 -W 2 -n -q -M do -s 56 -I "$dev" "$addr" >/dev/null 2>&1; then
    echo "No answer from $addr through $dev even with a tiny packet (the far end may not answer ping, or the path is down)."
    echo "RESULT addr=$addr dev=$dev current=$cur max=0 suggested=0 inner=0 outer=0 lowered=0 pass=no site=$name"; return 1
  fi
  if mtu_pass "$dev" "$addr" "$cur"; then
    pass=yes; best=$cur
    echo "The MTU of this tunnel now is $cur. A packet of exactly $cur bytes goes through and comes back: it PASSES."
  else
    echo "The MTU of this tunnel now is $cur. A packet of exactly $cur bytes does NOT come back."
    s=$((cur - step))
    while [ "$s" -ge 576 ]; do
      if mtu_pass "$dev" "$addr" "$s"; then best=$s; break; fi
      s=$((s - step))
    done
    if [ "$best" -gt 0 ]; then echo "Going down $step by $step: $best is the biggest size that passes."
    else echo "No size down to 576 passes, although a tiny packet does: the road or the far router drops bigger packets."; fi
  fi
  if [ -n "$oip" ]; then
    outer=$(mtu_outer_road "$oip")
    if [ -n "$outer" ]; then echo "The road outside the tunnel, to the router's public address $oip, carries packets up to $outer bytes whole."
    else echo "The router's public address $oip does not answer ping: the road outside the tunnel was not measured (this does not change the test above)."; fi
  else echo "The public address of the far router is not known, so the road outside the tunnel was not measured (this does not change the test above)."; fi
  echo "RESULT addr=$addr dev=$dev current=$cur max=$best suggested=$best inner=$best outer=${outer:-0} lowered=0 pass=$pass site=$name"
}

# mtu_measure ADDR DEV [SITE] [PREFIX]: measure one way. SITE (or a tunnel found from DEV) switches on the road check and the router-limit note.
mtu_measure() {
  local outer_ip="" addr=$1 dev=$2 site=${3:-} pfx=${4:-} cur lo raised=0 want="" outer="" olim="" note="" max sug lowered=""
  if [ -z "$site" ] && [[ "$dev" == ppp* ]]; then          # an address whose way is a tunnel of ours
    MTU_NAME=""; MTU_BYDEV=$dev; MTU_FOUND=""; MTU_OUTER=""; MTU_WANT=""; MTU_SITE=""
    for_each_site mtu_find_cb
    if [ -n "$MTU_FOUND" ]; then site=$MTU_SITE; echo "$dev is the tunnel of $site."; fi
  elif [ -n "$site" ]; then :
  elif [[ "$dev" != ppp* ]]; then echo "$dev is a normal network card: the traffic goes out to the internet directly, no tunnel wrapping."; fi
  [ -z "$site" ] || { want=$MTU_WANT; outer_ip=$MTU_OUTER; }
  cur=$(ip -o link show dev "$dev" 2>/dev/null | sed -n 's/.* mtu \([0-9]*\).*/\1/p')
  probe() { mtu_pass "$dev" "$addr" $(( $1 + 28 )); }
  if ! probe 56; then
    echo "No answer from $addr through $dev even with a tiny packet (the far router may not answer ping, or the path is down)."
    echo "RESULT addr=$addr dev=$dev current=${cur:-?} max=0 suggested=0 inner=0 outer=0 lowered=0${site:+ site=$site}"; return 1
  fi
  find_max() { local fn=$1 l=56 h=1472 m; if $fn "$h"; then echo "$h"; return; fi
               while [ "$l" -lt "$h" ]; do m=$(( (l + h + 1) / 2 )); if $fn "$m"; then l=$m; else h=$((m - 1)); fi; done; echo "$l"; }
  lo=$(find_max probe)
  max=$((lo + 28)); [ "$max" -le 1500 ] || max=1500
  sug=$max
  # What is reported is what really passes through the way that was asked for. (A packet that goes through is not judged against
  # the road outside the tunnel: when it comes back, every limit on the way has been passed.)
  if [ -n "$site" ] && [ -n "$want" ] && [ -n "$cur" ] && [ "$cur" -lt "$want" ]; then lowered=$cur; fi
  if [ "$max" -ge "${cur:-1500}" ]; then echo "Packets up to $max bytes (the MTU of $dev now) pass through $dev."
  else echo "Through $dev the biggest packet that passes is $max bytes (the link MTU now is ${cur:-?}); a good MTU is $sug."; fi
  if [ -n "$lowered" ]; then
    echo "The far router asked for at most $lowered bytes when the tunnel came up (you set $want here), so the tunnel really carries only $lowered."
    [ "$sug" -le "$lowered" ] || sug=$lowered
  fi
  echo "RESULT addr=$addr dev=$dev current=${cur:-?} max=$max suggested=$sug inner=$max outer=${outer:-0} lowered=${lowered:-0}${site:+ site=$site}${pfx:+ prefix=$pfx}"
}

# mtu-verify [NAME]: "test now" (the button of the measurement page): ONE full test, at once, of every connected tunnel (or of NAME):
# the pings of both addresses and the packet-size check, exactly what the watcher does every test_every minutes. When the size of a
# link does not pass, going down starts (one step a minute, by the watcher). Results: quality/NAME.last, mtu-test/NAME.far|ded
cmd_mtu_verify() {
  need_root
  command -v ping >/dev/null 2>&1 || return 0
  mkdir -p "$STATE_DIR/quality" "$STATE_DIR/mtu-test"
  exec 6>"$STATE_DIR/.quality.lock"
  flock -w 50 6 || die "Another test is running right now. Try again in a minute."
  Q_FORCE=1; Q_ONLY=${1:-}
  quality_run
  Q_FORCE=""; Q_ONLY=""
}

# two active dial-in clients with the same network AND the same distance (metric): the traffic is split between them
# (multipath) and half of it goes to the wrong router. Almost always a typo in one of the networks.
dup_collect() {
  [ "$S_MODE" = server ] && [ "$S_DISABLED" != yes ] || return 0
  [ -f "$CONF_DIR/routes.d/$S_NAME" ] || return 0
  local net metric
  while read -r net metric; do
    [ -n "$net" ] || continue
    echo "$net ${metric:-0} $S_NAME" >> "$DUP_TMP"
  done < "$CONF_DIR/routes.d/$S_NAME"
}
check_dup_routes() {
  DUP_TMP=$(mktemp)
  for_each_site dup_collect
  local line
  while IFS= read -r line; do
    [ -n "$line" ] && chk WARN "dial-in clients have the SAME network and distance: $line - traffic is split between them (typo?)"
  done < <(awk '{k=$1" metric "$2; c[k]++; n[k]=n[k] (n[k]==""?"":" and ") $3} END{for(k in c) if(c[k]>1) print k" ("n[k]")"}' "$DUP_TMP" | sort)
  rm -f "$DUP_TMP"
}

# ---- connection quality: a few pings through every tunnel (and through the road outside it) every minute ----
# quality-sample: one line per tunnel is appended to $STATE_DIR/quality/NAME.log (the watcher runs this every minute):
#   TIME STATE LOSS AVG MAX JITTER OUT_LOSS OUT_AVG OUT_MAX RX_BYTES TX_BYTES      ("-" = not measured)
#   STATE up|down; LOSS in percent, times in ms; the first group is INSIDE the tunnel, OUT_ is the road to the far router outside it.
# The panel (Quality pages) turns the lines into averages, worst values, speed and a grade; 7 days are kept.
# pingstat ARGS...: "LOSS AVG MAX JITTER" of 5 quick pings, "- - - -" when ping cannot run at all
pingstat() {
  local out loss rtt
  out=$(ping -c "${Q_COUNT:-5}" -i 0.2 -W 1 -n -q "$@" 2>&1) || true
  loss=$(printf '%s\n' "$out" | sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p' | head -n1)
  [ -n "$loss" ] || { echo "- - - -"; return; }
  rtt=$(printf '%s\n' "$out" | sed -n 's|^r[a-z-]* min/avg/max/[a-z]* = [0-9.]*/\([0-9.]*\)/\([0-9.]*\)/\([0-9.]*\).*|\1 \2 \3|p' | head -n1)
  if [ -n "$rtt" ]; then echo "$loss $rtt"; else echo "$loss - - -"; fi
}
# quality_cb: one connection. Every minute a line goes to quality/NAME.log (up/down and the byte counters: the history). Every test_every
# minutes (and at once for a new link) a full TEST is done: ping_count pings to the far end of the tunnel, to the extra test address
# (test_addr, if any) and to the router outside; the answer is kept in quality/NAME.last. Then the packet-size check (mtu_probe).
quality_cb() {
  [ "$S_DISABLED" != yes ] || return 0
  [ -z "${Q_ONLY:-}" ] || [ "$S_NAME" = "$Q_ONLY" ] || return 0
  local dev addr outer="" name=$S_NAME log last tick now idx lt="" lidx="" due=0 ta=$S_TEST_ADDR
  if [ "$S_MODE" = server ]; then dev=$(ifc_by_peer "$S_IP"); addr=$S_IP; outer=$(ppp_peer_public "$dev"); [ -n "$outer" ] || outer=${Q_DIALIN_OUTER:-}
  else
    dev="ppp-$S_NAME"
    addr=$(ip -o -4 addr show dev "$dev" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="peer"){sub("/.*","",$(i+1)); print $(i+1); exit}}' || true)
    outer=$S_HOST; is_ipv4 "$outer" || outer=$(resolve_v4 "$outer")
  fi
  log="$STATE_DIR/quality/$name.log"; last="$STATE_DIR/quality/$name.last"; tick="$STATE_DIR/quality/$name.tick"
  now=$(date +%s)
  if [ -z "$dev" ] || [ -z "$addr" ] || ! iface_up "$dev"; then
    echo "$now down - - - - - - - - -" >> "$log"
    echo "t=$now state=down" > "$last"
    rm -f "$tick" "$STATE_DIR/mtu-test/$name.far" "$STATE_DIR/mtu-test/$name.ded"
    return 0
  fi
  tst_cfg
  idx=$(cat "${SYS_NET:-/sys/class/net}/$dev/ifindex" 2>/dev/null || echo 0)
  if [ -f "$tick" ]; then read -r lt lidx < "$tick" || true; fi
  if [ -z "$lt" ] || [ "$lidx" != "$idx" ]; then       # a new link (the interface has another number): test at once, forget the old results
    due=1; rm -f "$STATE_DIR/mtu-test/$name.far" "$STATE_DIR/mtu-test/$name.ded"
  elif [ -n "${Q_FORCE:-}" ] || [ $((now - lt)) -ge $((T_EVERY * 60 - 20)) ]; then due=1; fi
  [ -z "$ta" ] || test_route_set "$dev" "$ta"
  (
    local i o d rx tx loss sf="0" sd="0"
    rx=$(cat "${SYS_NET:-/sys/class/net}/$dev/statistics/rx_bytes" 2>/dev/null || echo -); tx=$(cat "${SYS_NET:-/sys/class/net}/$dev/statistics/tx_bytes" 2>/dev/null || echo -)
    if [ "$due" = 1 ]; then
      Q_COUNT=$T_COUNT
      i=$(pingstat -I "$dev" "$addr")
      if [ -n "$outer" ]; then o=$(pingstat "$outer"); else o="- - - -"; fi
      if [ -n "$ta" ]; then d=$(pingstat -I "$dev" "$ta"); else d="- - - -"; fi
      # outside numbers: loss, avg, max only (jitter of the road is not shown)
      set -- $o
      echo "$now up $i $1 $2 $3 $rx $tx" >> "$log"
      echo "$now $idx" > "$tick"
      echo "t=$now state=up n=$T_COUNT far=${i// /,} ded=${d// /,} ded_addr=${ta:--}" > "$last"
      loss=${i%% *}; case "$loss" in ''|-) sf=0 ;; *) sf=$(awk -v l="$loss" 'BEGIN { printf "%d", 100 - l + 0.5 }') ;; esac
      loss=${d%% *}; case "$loss" in ''|-) sd=0 ;; *) sd=$(awk -v l="$loss" 'BEGIN { printf "%d", 100 - l + 0.5 }') ;; esac
    else
      echo "$now up - - - - - - - $rx $tx" >> "$log"
    fi
    mtu_probe "$name" far "$dev" "$addr" "$sf" "$due"
    [ -z "$ta" ] || mtu_probe "$name" ded "$dev" "$ta" "$sd" "$due"
  ) &
}
# alert_quality NAME: a Telegram message when the last 5 minutes were poor, and one when it is good again
# pq_val KEY DEFAULT: the limit of THIS connection (S_* variables of the site being handled), else the default from quality.conf, else the built-in value
pq_val() {
  local var="S_${1^^}" v
  v=${!var:-}
  [ -n "$v" ] || v=$(awk -F= -v k="$1" '{ key=$1; gsub(/^[ \t]+|[ \t]+$/, "", key); if (key==k) { sub(/^[^=]*=/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); print; exit } }' "$CONF_DIR/quality.conf" 2>/dev/null || true)
  printf '%s' "${v:-$2}"
}
# pq_thresholds: Q_PL/Q_PR/Q_PJ = poor from (loss %, delay ms, swing ms); Q_GL/Q_GR/Q_GJ = good below (fair starts at about a third of "poor")
pq_thresholds() {
  Q_PL=$(pq_val poor_loss 5); Q_PR=$(pq_val poor_rtt 400); Q_PJ=$(pq_val poor_jitter 120)
  Q_GL=$(awk -v v="$Q_PL" 'BEGIN { printf "%.3f", v * 0.2 }'); Q_GR=$(awk -v v="$Q_PR" 'BEGIN { printf "%.1f", v * 0.375 }'); Q_GJ=$(awk -v v="$Q_PJ" 'BEGIN { printf "%.1f", v / 3 }')
}
# pq_in_window HH:MM-HH:MM: is it that time now (time zone from Settings, general.conf)? Empty window = always.
pq_in_window() {
  local w=$1 tz now s e
  [ -n "$w" ] || return 0
  tz=$(awk -F= '{ k=$1; gsub(/[ \t]/, "", k); if (k=="timezone") { v=$2; gsub(/^[ \t]+|[ \t]+$/, "", v); print v; exit } }' "$CONF_DIR/general.conf" 2>/dev/null || true)
  now=$(TZ=${tz:-UTC} date +%H:%M); s=${w%-*}; e=${w#*-}
  if [[ "$s" < "$e" ]]; then [[ "$now" > "$s" || "$now" == "$s" ]] && [[ "$now" < "$e" ]]
  else [[ "$now" > "$s" || "$now" == "$s" || "$now" < "$e" ]]; fi
}
quality_alert() {
  local name=$1 log="$STATE_DIR/quality/$1.log" flag="$STATE_DIR/quality/$1.alert" r loss rtt jit oloss poor=0 good=0 verdict M
  [ "$(conf_get quality_alert)" != no ] || return 0
  pq_thresholds
  M=$(pq_val poor_alert_min 5)
  r=$(grep ' up ' "$log" | tail -n "$M" | awk -v M="$M" '{ n++; if ($3 != "-") { l += $3; ln++ } if ($4 != "-") { a += $4; an++ } if ($6 != "-") { j += $6; jn++ } if ($7 != "-") { o += $7; on++ } }
       END { if (n < M) { print "none"; exit } printf "%.1f %.0f %.0f %.1f\n", ln ? l/ln : 0, an ? a/an : 0, jn ? j/jn : 0, on ? o/on : -1 }')
  [ "$r" != none ] || return 0
  read -r loss rtt jit oloss <<< "$r"
  if awk -v l="$loss" -v a="$rtt" -v j="$jit" -v PL="$Q_PL" -v PR="$Q_PR" -v PJ="$Q_PJ" 'BEGIN { exit !(l >= PL || a >= PR || j >= PJ) }'; then poor=1; fi
  if awk -v l="$loss" -v a="$rtt" -v j="$jit" -v GL="$Q_GL" -v GR="$Q_GR" -v GJ="$Q_GJ" 'BEGIN { exit !(l < GL && a < GR && j < GJ) }'; then good=1; fi
  if [ "$poor" = 1 ] && [ ! -f "$flag" ]; then
    if awk -v o="$oloss" 'BEGIN { exit !(o >= 2) }'; then verdict="The road outside the tunnel is bad too (loss ${oloss}%): the internet path or a filter, not the tunnel."
    elif awk -v o="$oloss" 'BEGIN { exit !(o >= 0) }'; then verdict="The road outside the tunnel is fine: the problem is inside the tunnel (IPsec, L2TP, MTU or the router load)."
    else verdict="The road outside the tunnel could not be measured."; fi
    if notify_send "$name: connection quality is POOR for $M minutes (lost packets ${loss}%, average delay ${rtt} ms, delay swing ${jit} ms). $verdict"; then :; fi
    date +%s > "$flag"
    echo "$(date '+%F %T') $name quality poor: loss ${loss}% avg ${rtt} ms jitter ${jit} ms (alert attempted)" >> "$STATE_DIR/watch.log"
  elif [ "$good" = 1 ] && [ -f "$flag" ]; then
    notify_send "$name: connection quality is good again (lost packets ${loss}%, average delay ${rtt} ms)." || true
    rm -f "$flag"
    echo "$(date '+%F %T') $name quality good again" >> "$STATE_DIR/watch.log"
  fi
}
# quality_reconnect NAME: when the tunnel was poor almost all the time (80% of the 5-minute blocks) during the last poor_reconnect_min minutes,
# reconnect it once. Guards: only while it is up, only inside poor_window, not again before poor_cooldown_min, at most poor_max_day a day,
# optionally not when the road outside is bad too (poor_outside = no). Off by default (poor_reconnect_min = 0).
quality_reconnect() {
  local name=$1 log="$STATE_DIR/quality/$1.log" rec="$STATE_DIR/quality/$1.recon" N cool maxd res b p oo now last cnt notify=1
  N=$(pq_val poor_reconnect_min 0)
  case "$N" in ''|*[!0-9]*) return 0 ;; esac
  [ "$((10#$N))" -gt 0 ] || return 0
  N=$((10#$N))
  [ -f "$log" ] || return 0
  [ "$(tail -n1 "$log" | awk '{ print $2 }')" = up ] || return 0
  pq_thresholds
  res=$(tail -n "$N" "$log" | awk -v PL="$Q_PL" -v PR="$Q_PR" -v PJ="$Q_PJ" -v N="$N" '
    { l[NR] = $0 }
    END {
      if (NR < N * 0.9) { print "short"; exit }
      for (i = NR; i >= 5; i -= 5) {
        ups = 0; sl = sa = sj = 0; ln = an = jn = 0
        for (k = i - 4; k <= i; k++) { split(l[k], f, " "); if (f[2] == "up") { ups++
          if (f[3] != "-") { sl += f[3]; ln++ } if (f[4] != "-") { sa += f[4]; an++ } if (f[6] != "-") { sj += f[6]; jn++ }
          if (f[7] != "-") { so += f[7]; on++ } } }
        b++
        if (ups >= 3 && ((ln && sl / ln >= PL) || (an && sa / an >= PR) || (jn && sj / jn >= PJ))) p++
      }
      if (b < 3) { print "short"; exit }
      printf "%d %d %.1f\n", b, p, on ? so / on : -1 }')
  [ "$res" != short ] && [ -n "$res" ] || return 0
  read -r b p oo <<< "$res"
  [ "$((p * 100))" -ge "$((b * 80))" ] || return 0
  if [ "$(pq_val poor_outside yes)" = no ] && awk -v o="$oo" 'BEGIN { exit !(o >= 2) }'; then return 0; fi
  pq_in_window "$(pq_val poor_window "")" || return 0
  now=$(date +%s)
  cool=$(pq_val poor_cooldown_min "$N"); case "$cool" in ''|*[!0-9]*) cool=$N ;; esac
  maxd=$(pq_val poor_max_day 4); case "$maxd" in ''|*[!0-9]*) maxd=4 ;; esac
  [ -f "$rec" ] || : > "$rec"
  awk -v n="$now" '$1 > n - 86400' "$rec" > "$rec.tmp" && mv "$rec.tmp" "$rec"
  last=$(tail -n1 "$rec"); cnt=$(grep -c . "$rec" || true)
  if [ -n "$last" ] && [ "$((now - last))" -lt "$((cool * 60))" ]; then return 0; fi
  [ "$(conf_get quality_alert)" != no ] || notify=0
  if [ "$cnt" -ge "$maxd" ]; then
    if [ "$(cat "$STATE_DIR/quality/$name.capmsg" 2>/dev/null)" != "$(date +%F)" ]; then
      date +%F > "$STATE_DIR/quality/$name.capmsg"
      echo "$(date '+%F %T') $name still poor, automatic reconnect limit reached ($maxd in 24 h)" >> "$STATE_DIR/watch.log"
      [ "$notify" = 0 ] || notify_send "$name: still poor, but the automatic reconnects ($maxd in 24 hours) did not help. The problem is probably not fixed by reconnecting." || true
    fi
    return 0
  fi
  echo "$now" >> "$rec"
  if [ "$S_MODE" = server ]; then setsid "$0" disconnect "$name" >/dev/null 2>&1 < /dev/null 6>&- &
  else setsid "$0" reconnect "$name" >/dev/null 2>&1 < /dev/null 6>&- &
  fi
  echo "$(date '+%F %T') $name poor for $N minutes: reconnected automatically ($((cnt + 1)) of $maxd in 24 h)" >> "$STATE_DIR/watch.log"
  printf '{"t": %s, "k": "warn", "m": "%s"}\n' "$now" "Connection $name was poor for $N minutes: reconnected automatically ($((cnt + 1)) of $maxd in 24 hours)" >> "$STATE_DIR/events.log" 2>/dev/null || true
  [ "$notify" = 0 ] || notify_send "$name: quality was poor for $N minutes - reconnected automatically ($((cnt + 1)) of $maxd in 24 hours)." || true
}
quality_alert_cb() { [ "$S_DISABLED" != yes ] || return 0; quality_alert "$S_NAME"; }
quality_reconnect_cb() { [ "$S_DISABLED" != yes ] || return 0; quality_reconnect "$S_NAME"; }
# quality_run: the tests of every connected tunnel (Q_ONLY = one NAME, Q_FORCE = test now, not only when it is due)
quality_run() {
  Q_DIALIN_OUTER=$(ipsec status 2>/dev/null | sed -n 's/^l2tp-gw-dialin\[[0-9]*\]: ESTABLISHED.*\.\.\.\([0-9.]*\)\[.*/\1/p' | sort -u)
  [ "$(printf '%s\n' "$Q_DIALIN_OUTER" | grep -c .)" = 1 ] || Q_DIALIN_OUTER=""
  for_each_site quality_cb
  wait
}
cmd_quality_sample() {
  need_root
  [ -f "$SITES" ] || return 0
  command -v ping >/dev/null 2>&1 || return 0
  mkdir -p "$STATE_DIR/quality" "$STATE_DIR/mtu-test"
  exec 6>"$STATE_DIR/.quality.lock"
  flock -n 6 || return 0
  Q_ONLY=${1:-}
  quality_run
  Q_ONLY=""
  local f n
  for f in "$STATE_DIR"/quality/*.log; do        # keep 7 days (one line a minute)
    [ -f "$f" ] || continue
    if [ "$(wc -l < "$f")" -gt 10200 ]; then tail -n 10080 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; fi
    n=$(basename "$f" .log)
    if ! grep -q "^\[$n\]" "$SITES" 2>/dev/null; then      # a deleted site takes its history with it
      rm -f "$f" "$STATE_DIR/quality/$n.alert" "$STATE_DIR/quality/$n.recon" "$STATE_DIR/quality/$n.capmsg" "$STATE_DIR/quality/$n.last" "$STATE_DIR/quality/$n.tick" "$STATE_DIR/mtu-test/$n.far" "$STATE_DIR/mtu-test/$n.ded"
    fi
  done
  for_each_site quality_alert_cb
  for_each_site quality_reconnect_cb
}

cmd_check() {
  need_root
  [ -f "$SITES" ] || die "No sites yet."
  CHK_IPSEC=$(ipsec status 2>/dev/null || true)
  CHK_IPSEC_ALL=$(ipsec statusall 2>/dev/null || true)
  declare -gA CHK_PEER=()
  local ike
  ike=$(ike_service)
  if systemctl is-active --quiet "$ike"; then chk OK "service $ike is running"; else chk FAIL "service $ike is not running"; fi
  if systemctl is-active --quiet xl2tpd; then chk OK "service xl2tpd is running"; else chk FAIL "service xl2tpd is not running"; fi
  if [ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null)" = 1 ]; then chk OK "IP forwarding is on"; else chk FAIL "IP forwarding is off (run: l2tp-gw setup)"; fi
  if iptables -t nat -S POSTROUTING 2>/dev/null | grep -q MASQUERADE; then
    chk OK "internet NAT rule present"
  else
    chk FAIL "no MASQUERADE rule in POSTROUTING (run: l2tp-gw setup)"
  fi
  local fw_mangle fw_all
  fw_mangle=$(iptables -t mangle -S FORWARD 2>/dev/null || true)
  if grep -q 'clamp-mss-to-pmtu' <<< "$fw_mangle"; then
    chk OK "TCP size fix for forwarded traffic is on (MSS clamp to the path MTU)"
  else
    chk WARN "TCP size fix (MSS clamp to the path MTU) is missing (run: l2tp-gw setup)"
  fi
  if iptables -t mangle -S L2TPGW-MSS >/dev/null 2>&1; then
    local mss_rules mss_pk
    mss_rules=$(iptables -t mangle -S L2TPGW-MSS 2>/dev/null | grep -c -- '--set-mss' || true)
    mss_pk=$(iptables -t mangle -L L2TPGW-MSS -v -n -x 2>/dev/null | awk 'NR > 2 { s += $1 } END { print s + 0 }')
    chk OK "TCP size fix per tunnel, both directions: $mss_rules rules, ${mss_pk} connection starts looked at"
  else
    chk WARN "TCP size fix per tunnel is not set yet (run: l2tp-gw mss-apply)"
  fi
  fw_all=$(iptables -S 2>/dev/null || true)
  if grep -- '-p icmp' <<< "$fw_all" | grep -E -- '-j (DROP|REJECT)' | grep -qvE 'echo-request|icmp-type 8'; then
    chk WARN "a firewall rule drops ICMP - the message 'packet too big' may get lost and big packets then stall (check: iptables -S | grep icmp)"
  else
    chk OK "ICMP 'packet too big' messages are not blocked on this server"
  fi
  if systemctl is-active --quiet l2tp-gw-collect 2>/dev/null; then
    chk OK "traffic collector is running"
  else
    chk WARN "traffic collector is not running - no usage statistics, no auto reconnect (run: l2tp-gw-web install)"
  fi
  DI_USER=(); DI_IP=(); TA_USED=()
  if dialin_enabled; then
    if [ -f "$IPSEC_D/l2tp-gw-dialin.conf" ]; then chk OK "dial-in: IPsec connection l2tp-gw-dialin is configured"; else chk FAIL "dial-in is on but its IPsec config is missing (run: l2tp-gw apply)"; fi
    if ss -lun 2>/dev/null | grep -q ':1701 '; then chk OK "dial-in: xl2tpd listens on UDP 1701"; else chk FAIL "dial-in: nothing listens on UDP 1701"; fi
    if iptables -S L2TPGW-IN 2>/dev/null | grep -q -- '--pol ipsec'; then
      chk OK "dial-in: UDP 1701 is accepted only inside IPsec"
    else
      chk FAIL "dial-in: plain UDP 1701 is NOT blocked (the L2TPGW-IN firewall rule is missing; run: l2tp-gw apply)"
    fi
    if [ -z "$(dialin_get public_ip)" ]; then chk WARN "dial-in: public_ip is not set - routers that check the server identity may refuse"; fi
  fi
  declare -gA CHK_HOSTSITES=()
  for_each_site chk_hosts_cb
  for_each_site check_site
  check_dup_routes
  # tunnels that share the same peer address need ONE multipath route, or all replies use one tunnel
  local p s cnt want
  for p in $(printf '%s\n' "${CHK_PEER[@]}" | sort -u); do
    want=0; s=""
    for n in "${!CHK_PEER[@]}"; do
      if [ "${CHK_PEER[$n]}" = "$p" ]; then want=$((want + 1)); s="$s $n"; fi
    done
    [ "$want" -ge 2 ] || continue
    cnt=$(ip route show exact "$p/32" 2>/dev/null | grep -c nexthop || true)
    if [ "$cnt" -eq "$want" ]; then
      chk OK "peer address $p is shared by:$s - replies are balanced (multipath)"
    else
      chk WARN "peer address $p is shared by:$s but the multipath route is incomplete ($cnt of $want)"
    fi
  done
  echo
  if [ "$CHK_FAIL" = 0 ]; then echo "RESULT: no failures"; else echo "RESULT: there are failures"; fi
  return "$CHK_FAIL"
}

# ---- backup / restore of the sites file (it holds all secrets) ----
DIALIN_MARK="#--dialin-settings--"
cmd_backup() {
  need_root
  [ -f "$SITES" ] || die "No sites file to back up."
  local out=${1:-/root/l2tp-gw-sites-$(date +%Y%m%d-%H%M%S).conf}
  cp "$SITES" "$out"; chmod 600 "$out"
  # the shared dial-in settings (they hold the PSK) travel in the same file, after a marker line
  if [ -f "$DIALIN" ]; then { echo "$DIALIN_MARK"; cat "$DIALIN"; } >> "$out"; fi
  echo "Backup written to $out (it contains passwords - keep it private)."
}

# ---- automatic backup: one file per day in AUTOBACKUP_DIR, the newest AUTOBACKUP_KEEP days are kept ----
# Called from "watch" (every minute). If the settings differ from the newest copy, today's copy is (re)written, so
# each day's file holds the last state of that day; when nothing changed nothing is written.
: "${AUTOBACKUP_DIR:=/var/backups/l2tp-gw}"
: "${AUTOBACKUP_KEEP:=7}"
cmd_backup_auto() {
  [ -f "$SITES" ] || return 0
  local today new last f
  today=$(date +%Y%m%d)
  mkdir -p "$AUTOBACKUP_DIR"; chmod 700 "$AUTOBACKUP_DIR"
  new=$(mktemp)
  cp "$SITES" "$new"
  if [ -f "$DIALIN" ]; then { echo "$DIALIN_MARK"; cat "$DIALIN"; } >> "$new"; fi
  last=$(ls -1 "$AUTOBACKUP_DIR"/sites-*.conf 2>/dev/null | tail -n 1 || true)     # (empty folder is normal: no failure)
  if [ -n "$last" ] && cmp -s "$new" "$last"; then rm -f "$new"; return 0; fi
  rm -f "$AUTOBACKUP_DIR"/sites-"$today"-*.conf          # one file per day: replace today's older copy
  f="$AUTOBACKUP_DIR/sites-$today-$(date +%H%M%S).conf"
  mv "$new" "$f"; chmod 600 "$f"
  ls -1 "$AUTOBACKUP_DIR"/sites-*.conf 2>/dev/null | head -n -"$AUTOBACKUP_KEEP" | xargs -r rm -f -- || true
}

# restore FILE: validate FILE first (nothing changes if it is bad), then apply; undo if apply fails.
# The file may end with the dial-in settings after the marker line (see backup).
cmd_restore() {
  need_root
  local f=${1:-} part dpart
  [ -n "$f" ] && [ -f "$f" ] || die "Usage: l2tp-gw restore FILE"
  part=$(mktemp); dpart=$(mktemp)
  awk -v m="$DIALIN_MARK" '$0 == m {exit} {print}' "$f" > "$part"
  awk -v m="$DIALIN_MARK" 'f {print} $0 == m {f = 1}' "$f" > "$dpart"
  # the sites are validated against the dial-in settings that come WITH the file (pool etc.), else the current ones
  if [ -s "$dpart" ]; then
    DIALIN_FILE=$dpart "$0" validate "$part" > /dev/null || { rm -f "$part" "$dpart"; die "That file is not valid. Nothing was changed."; }
  else
    "$0" validate "$part" > /dev/null || { rm -f "$part" "$dpart"; die "That file is not valid. Nothing was changed."; }
  fi
  mkdir -p "$CONF_DIR"
  if [ -f "$SITES" ]; then cp "$SITES" "$SITES.bak"; chmod 600 "$SITES.bak"; fi
  if [ -f "$DIALIN" ]; then cp "$DIALIN" "$DIALIN.bak"; chmod 600 "$DIALIN.bak"; fi
  cp "$part" "$SITES"; chmod 600 "$SITES"
  if [ -s "$dpart" ]; then cp "$dpart" "$DIALIN"; chmod 600 "$DIALIN"; fi
  rm -f "$part" "$dpart"
  if ! ( cmd_apply ); then
    if [ -f "$SITES.bak" ]; then cp "$SITES.bak" "$SITES"; fi
    if [ -f "$DIALIN.bak" ]; then cp "$DIALIN.bak" "$DIALIN"; fi
    ( cmd_apply ) || true
    die "Apply failed. The old settings were put back."
  fi
}

# ---- reconnect one site without touching the others ----
# Uses xl2tpd-control (disconnect-lac / connect-lac) and "ipsec down/up" for that site only.
cmd_reconnect() {
  need_root
  local n=${1:-}
  [ -n "$n" ] && [ -f "$SITES" ] && grep -qxF "[$n]" "$SITES" || die "Usage: l2tp-gw reconnect NAME (NAME must be an existing site)"
  command -v xl2tpd-control >/dev/null 2>&1 || die "xl2tpd-control not found (it comes with the xl2tpd package)."
  echo "Reconnecting $n ..."
  xl2tpd-control disconnect-lac "$n" >/dev/null 2>&1 || true
  ipsec down "$n" >/dev/null 2>&1 || true
  sleep 2
  timeout 40 ipsec up "$n" 2>&1 | tail -n 2 || true
  xl2tpd-control connect-lac "$n" >/dev/null 2>&1 || true
  echo "Done. The tunnel can need up to ~1 minute to come back. Check: l2tp-gw status"
}

# ---- logs (journal of the VPN services); NAME keeps only lines that mention that site ----
cmd_logs() {
  local n=${1:-} lines=${2:-200} out host=""
  [[ "$lines" =~ ^[0-9]{1,4}$ ]] || lines=200
  out=$(journalctl -u xl2tpd -u "$(ike_service)" --no-pager -n 3000 -o short-iso 2>&1 || true)
  if [ -z "$n" ]; then
    printf '%s\n' "$out" | tail -n "$lines"
    return 0
  fi
  [ -f "$SITES" ] && grep -qxF "[$n]" "$SITES" || die "No site named '$n'"
  host=$(awk -v s="[$n]" '$0==s {f=1; next} /^\[/ {f=0} f && /^[ \t]*host[ \t]*=/ {sub(/^[^=]*=[ \t]*/, ""); print; exit}' "$SITES")
  # whole-word match only, so a short name like "a" does not match every line
  local b='[^A-Za-z0-9_-]' hre pat
  pat="(^|$b)(ppp-)?$n($b|\$)"
  if [ -n "$host" ]; then hre=$(printf '%s' "$host" | sed 's/\./\\./g'); pat="$pat|(^|$b)$hre($b|\$)"; fi
  printf '%s\n' "$out" | grep -iE -- "$pat" | tail -n "$lines" || true
}

# ---- watch: runs every minute from a systemd timer ----
#  1) sends a Telegram alert when a tunnel stays down for down_after_min minutes (and when it is back)
#  2) when a DDNS address of a DOWN tunnel has changed, re-applies the config (re-resolves names)
: "${STATE_DIR:=/var/lib/l2tp-gw}"
: "${UNIT_DIR:=/etc/systemd/system}"

# PPP is up: is the IPsec SA there too? Without it L2TP runs in plain text (MikroTik use-ipsec=yes accepts that).
# Behaviour depends on the site setting ipsec_mode (default heal):
#   heal     after IPSEC_GRACE s: one Telegram alert, then "l2tp-gw reconnect" (max IPSEC_HEAL_MAX times, IPSEC_HEAL_GAP s apart);
#            after the last failed try one more alert "repair failed", then it only stays red in the web page and in check
#   require  same, but grace IPSEC_GRACE_REQUIRE s, a repair every IPSEC_HEAL_GAP_REQUIRE s, and no limit on tries
#   allow    nothing at all (the peer cannot do IPsec; the web page shows it as "allowed")
# A normal reconnect briefly has PPP before IPsec is reported, hence the grace time.
# WATCH_IPSEC is "ipsec status" read once per run; WATCH_IPSEC_OK=0 means it could not be read (then we do not guess).
# State files (STATE_DIR): noipsec-N (when it started) noipsec-alerted-N noipsec-last-N (last repair time)
#                          noipsec-tries-N noipsec-giveup-N. They are kept while PPP is down (a repair reconnects the
#                          tunnel, which must not reset the counters) and cleared when IPsec is back or the mode is allow.
: "${IPSEC_GRACE:=120}"
: "${IPSEC_GRACE_REQUIRE:=30}"
: "${IPSEC_HEAL_GAP:=600}"
: "${IPSEC_HEAL_GAP_REQUIRE:=120}"
: "${IPSEC_HEAL_MAX:=3}"

noipsec_clear() {
  rm -f "$STATE_DIR/noipsec-$1" "$STATE_DIR/noipsec-alerted-$1" "$STATE_DIR/noipsec-last-$1" \
        "$STATE_DIR/noipsec-tries-$1" "$STATE_DIR/noipsec-giveup-$1"
}

watch_ipsec() {
  local n=$1 now=$2 mode=${S_IPSEC_MODE:-heal} grace gap since last tries self
  [ "$WATCH_IPSEC_OK" = 1 ] || return 0
  if [ "$mode" = allow ]; then noipsec_clear "$n"; return 0; fi
  if printf '%s\n' "$WATCH_IPSEC" | grep -Eq "$(ipsec_sa_re "$n")"; then
    if [ -f "$STATE_DIR/noipsec-alerted-$n" ]; then
      notify_send "OK: tunnel $n has IPsec again" || true
      echo "$(date '+%F %T') $n IPsec is back" >> "$STATE_DIR/watch.log"
    fi
    noipsec_clear "$n"
    return 0
  fi
  if [ "$mode" = require ]; then grace=$IPSEC_GRACE_REQUIRE; gap=$IPSEC_HEAL_GAP_REQUIRE
  else grace=$IPSEC_GRACE; gap=$IPSEC_HEAL_GAP; fi
  [ -f "$STATE_DIR/noipsec-$n" ] || echo "$now" > "$STATE_DIR/noipsec-$n"
  since=$(cat "$STATE_DIR/noipsec-$n" 2>/dev/null || echo "$now")
  [ $((now - since)) -ge "$grace" ] || return 0
  # look once more with a fresh reading before alerting or repairing: an IKE re-key can hide the SA for a moment
  # (IPSEC_RECHECK_WAIT seconds later; the first reading may also be a few seconds old)
  sleep "${IPSEC_RECHECK_WAIT:-3}"
  if ipsec status 2>/dev/null | grep -Eq "$(ipsec_sa_re "$n")"; then
    if [ -f "$STATE_DIR/noipsec-alerted-$n" ]; then
      notify_send "OK: tunnel $n has IPsec again" || true
      echo "$(date '+%F %T') $n IPsec is back" >> "$STATE_DIR/watch.log"
    fi
    noipsec_clear "$n"
    return 0
  fi
  if [ ! -f "$STATE_DIR/noipsec-alerted-$n" ]; then
    notify_send "WARNING: tunnel $n is up WITHOUT IPsec (not encrypted) for $(( (now - since) / 60 )) min (mode $mode)" || true
    echo "$(date '+%F %T') $n PPP up without IPsec for $(( (now - since) / 60 )) min, mode $mode (alert attempted)" >> "$STATE_DIR/watch.log"
    touch "$STATE_DIR/noipsec-alerted-$n"
  fi
  tries=$(cat "$STATE_DIR/noipsec-tries-$n" 2>/dev/null | grep -E '^[0-9]+$' || echo 0)
  last=$(cat "$STATE_DIR/noipsec-last-$n" 2>/dev/null | grep -E '^[0-9]+$' || echo 0)
  if [ "$mode" = heal ] && [ "$tries" -ge "$IPSEC_HEAL_MAX" ]; then
    if [ ! -f "$STATE_DIR/noipsec-giveup-$n" ]; then
      notify_send "tunnel $n: automatic repair failed $tries times, it still has no IPsec. Check IPsec on the router, or set ipsec_mode = allow for this site" || true
      echo "$(date '+%F %T') $n repair failed $tries times, giving up (alert attempted)" >> "$STATE_DIR/watch.log"
      touch "$STATE_DIR/noipsec-giveup-$n"
    fi
    return 0
  fi
  [ $((now - last)) -ge "$gap" ] || return 0
  echo "$now" > "$STATE_DIR/noipsec-last-$n"
  echo $((tries + 1)) > "$STATE_DIR/noipsec-tries-$n"
  echo "$(date '+%F %T') $n repair attempt $((tries + 1)): reconnect" >> "$STATE_DIR/watch.log"
  # run in the foreground: a systemd oneshot unit kills leftover background processes when it ends.
  # It can take up to ~50 s; the watch lock keeps the next timer run from overlapping.
  self=$(readlink -f "$0" 2>/dev/null || echo /usr/local/bin/l2tp-gw)
  timeout 120 "$self" reconnect "$n" >/dev/null 2>&1 || echo "$(date '+%F %T') $n repair command failed" >> "$STATE_DIR/watch.log"
}

watch_site() {
  local n=$S_NAME now since ip4 prev limit ifc="ppp-$S_NAME" seen=""
  now=$(date +%s)
  # a switched-off site raises no alert, whatever its kind
  if [ "$S_DISABLED" = yes ]; then rm -f "$STATE_DIR/seen-$n" "$STATE_DIR/down-$n" "$STATE_DIR/alerted-$n"; return 0; fi
  limit=$(( $(conf_get down_after_min | grep -E '^[0-9]+$' || echo 5) * 60 ))
  if [ "$S_MODE" = server ]; then
    # dial-in site: it is only "down" once it has been seen connected; a switched-off site raises no alert
    ifc=$(ifc_by_peer "$S_IP")
    if [ "$S_DISABLED" = yes ]; then rm -f "$STATE_DIR/seen-$n" "$STATE_DIR/down-$n" "$STATE_DIR/alerted-$n"; return 0; fi
    if [ -n "$ifc" ]; then touch "$STATE_DIR/seen-$n"; seen=1; fi
    if [ -z "$ifc" ] && [ ! -f "$STATE_DIR/seen-$n" ]; then return 0; fi
  fi
  if [ -n "$ifc" ] && iface_up "$ifc"; then
    if [ -f "$STATE_DIR/alerted-$n" ]; then
      notify_send "RECOVERED: tunnel $n is up again" || true
      echo "$(date '+%F %T') $n recovered" >> "$STATE_DIR/watch.log"
      rm -f "$STATE_DIR/alerted-$n"
    fi
    rm -f "$STATE_DIR/down-$n"
    if [ "$S_MODE" != server ]; then watch_ipsec "$n" "$now"; fi
    return 0
  fi
  # PPP is down: the "since when" timer restarts with the next plain connection; counters and the alert flag are kept
  rm -f "$STATE_DIR/noipsec-$n"
  # tunnel is down
  [ -f "$STATE_DIR/down-$n" ] || echo "$now" > "$STATE_DIR/down-$n"
  since=$(cat "$STATE_DIR/down-$n")
  if [ $((now - since)) -ge "$limit" ] && [ ! -f "$STATE_DIR/alerted-$n" ]; then
    notify_send "DOWN: tunnel $n has been down for $(( (now - since) / 60 )) min" || true
    echo "$(date '+%F %T') $n down for $(( (now - since) / 60 )) min (alert attempted)" >> "$STATE_DIR/watch.log"
    touch "$STATE_DIR/alerted-$n"
  fi
  # DDNS: the address changed since the config was last loaded, and the tunnel is down
  if [ "$S_MODE" != server ] && ! is_ipv4 "$S_HOST"; then
    dns_flush_throttled 120          # a down tunnel with a DDNS name: do not trust an old cached answer
    ip4=$(resolve_v4 "$S_HOST")
    prev=$(cat "$STATE_DIR/ddns-$n" 2>/dev/null || true)
    if [ -n "$ip4" ] && [ -z "$prev" ]; then
      echo "$ip4" > "$STATE_DIR/ddns-$n"      # first time we see this host: remember its address
    elif [ -n "$ip4" ] && [ "$ip4" != "$prev" ]; then
      WATCH_NEED_APPLY="$WATCH_NEED_APPLY $n($prev->$ip4)"
    fi
  fi
}

# remember the address every DDNS host has right now (called after a successful apply)
ddns_record() {
  local ip4
  if [ "$S_MODE" != server ] && [ "$S_DISABLED" != yes ] && ! is_ipv4 "$S_HOST"; then
    ip4=$(resolve_v4 "$S_HOST")
    if [ -n "$ip4" ]; then echo "$ip4" > "$STATE_DIR/ddns-$S_NAME"; fi
  fi
}

# ---- DNS cache: names of DDNS sites must be resolved fresh, otherwise a changed address is not noticed ----
# dns_flush empties the local resolver caches (systemd-resolved, nscd). It cannot empty the cache of an upstream
# resolver, which keeps an answer until the TTL of the DNS record ends.
dns_flush() {
  if command -v resolvectl >/dev/null 2>&1; then resolvectl flush-caches >/dev/null 2>&1 || true
  elif command -v systemd-resolve >/dev/null 2>&1; then systemd-resolve --flush-caches >/dev/null 2>&1 || true; fi
  if command -v nscd >/dev/null 2>&1; then nscd -i hosts >/dev/null 2>&1 || true; fi
  { mkdir -p "$STATE_DIR" && date +%s > "$STATE_DIR/last-dns-flush"; } 2>/dev/null || true
}

# dns_flush_throttled SECONDS: flush only when the last flush is older than SECONDS
dns_flush_throttled() {
  local now last
  now=$(date +%s); last=$(cat "$STATE_DIR/last-dns-flush" 2>/dev/null || echo 0)
  if [ $((now - last)) -ge "$1" ]; then dns_flush; fi
  return 0
}

# periodic flush: every dns_flush_min minutes (notify.conf, default 30, 0 = never)
dns_flush_periodic() {
  local m
  m=$(conf_get dns_flush_min); m=${m:-30}
  case "$m" in ''|*[!0-9]*) m=30 ;; esac
  if [ "$m" -eq 0 ]; then return 0; fi
  dns_flush_throttled $((m * 60 - 30))        # (30 s tolerance: the timer does not fire at the exact second)
}

# ---- send the settings file to Telegram when it changed (only if tg_send_config = yes and Telegram works) ----
# The file holds all passwords. The first time the option is seen the current state is only remembered (no send).
# A change is sent when the file has not been touched for 60 s (so a series of quick edits gives one message).
cfg_send_check() {
  [ "$(conf_get tg_send_config)" = yes ] || return 0
  local tok chat name sum prev now mt last tmp fname rc=0
  tok=$(conf_get telegram_token); chat=$(conf_get telegram_chat)
  if [ -z "$tok" ] || [ -z "$chat" ] || [ ! -f "$SITES" ]; then return 0; fi
  tmp=$(mktemp)
  cp "$SITES" "$tmp"
  if [ -f "$DIALIN" ]; then { echo "$DIALIN_MARK"; cat "$DIALIN"; } >> "$tmp"; fi
  sum=$(md5sum < "$tmp" | cut -d' ' -f1)
  prev=$(cat "$STATE_DIR/cfg-sent.md5" 2>/dev/null || true)
  if [ -z "$prev" ]; then echo "$sum" > "$STATE_DIR/cfg-sent.md5"; rm -f "$tmp"; return 0; fi
  if [ "$sum" = "$prev" ]; then rm -f "$tmp"; return 0; fi
  now=$(date +%s); mt=$(stat -c %Y "$SITES" 2>/dev/null || echo 0)
  if [ -f "$DIALIN" ]; then last=$(stat -c %Y "$DIALIN" 2>/dev/null || echo 0); [ "$last" -gt "$mt" ] && mt=$last; fi
  if [ $((now - mt)) -lt 60 ]; then rm -f "$tmp"; return 0; fi
  last=$(cat "$STATE_DIR/cfg-try" 2>/dev/null || echo 0)
  if [ $((now - last)) -lt 300 ]; then rm -f "$tmp"; return 0; fi      # after a failure: try again in 5 minutes at most
  echo "$now" > "$STATE_DIR/cfg-try"
  name=$(conf_get server_name); [ -n "$name" ] || name=$(hostname)
  fname="sites-$(date +%Y%m%d-%H%M).conf"
  # the URL (it contains the token) goes through stdin, so it is not visible in "ps"
  printf 'url = "https://api.telegram.org/bot%s/sendDocument"\n' "$tok" |
    curl -fsS -m 60 -o /dev/null -K - -F "chat_id=$chat" -F "caption=[$name] Settings changed $(date '+%F %T')" \
         -F "document=@$tmp;filename=$fname" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "$sum" > "$STATE_DIR/cfg-sent.md5"
    echo "$(date '+%F %T') settings file sent to Telegram" >> "$STATE_DIR/watch.log"
  else
    echo "$(date '+%F %T') sending the settings file to Telegram FAILED (will retry)" >> "$STATE_DIR/watch.log"
  fi
  rm -f "$tmp"
  return 0
}

cmd_watch() {
  need_root
  [ -f "$SITES" ] || return 0
  mkdir -p "$STATE_DIR"
  exec 8>"$STATE_DIR/.watch.lock"
  flock -n 8 || return 0
  WATCH_NEED_APPLY=""
  cmd_backup_auto || true        # (cheap: writes only when the settings changed, see cmd_backup_auto)
  dns_flush_periodic || true
  cfg_send_check || true
  # read the IPsec state once; if the command fails (strongSwan stopped) we skip the IPsec test instead of guessing
  WATCH_IPSEC_OK=1
  WATCH_IPSEC=$(ipsec status 2>/dev/null) || WATCH_IPSEC_OK=0
  for_each_site watch_site
  QUIET=1 "$0" mss-apply >/dev/null 2>&1 || true
  QUIET=1 timeout 45 "$0" quality-sample >/dev/null 2>&1 || true      # the tests (each connection on its own interval) and the size checks
  if [ -n "$WATCH_NEED_APPLY" ]; then
    local now last
    now=$(date +%s); last=$(cat "$STATE_DIR/last-ddns-apply" 2>/dev/null || echo 0)
    # at most once every 10 minutes, so a flapping DNS name cannot cause a restart loop
    if [ $((now - last)) -ge 600 ]; then
      echo "$now" > "$STATE_DIR/last-ddns-apply"
      echo "$(date '+%F %T') DDNS address changed:$WATCH_NEED_APPLY - re-applying config" >> "$STATE_DIR/watch.log"
      notify_send "DDNS address changed:$WATCH_NEED_APPLY - restarting VPN services" || true
      cmd_apply > /dev/null 2>&1 || echo "$(date '+%F %T') re-apply FAILED" >> "$STATE_DIR/watch.log"
    fi
  fi
  if [ -f "$STATE_DIR/watch.log" ] && [ "$(wc -l < "$STATE_DIR/watch.log")" -gt 200 ]; then
    tail -n 200 "$STATE_DIR/watch.log" > "$STATE_DIR/watch.log.tmp" && mv "$STATE_DIR/watch.log.tmp" "$STATE_DIR/watch.log"
  fi
}

# systemd timer that runs "l2tp-gw watch" every minute (written by every apply, harmless to repeat)
install_watch_timer() {
  local gw
  command -v systemctl >/dev/null 2>&1 || return 0
  gw=$(readlink -f "$0" 2>/dev/null || echo /usr/local/bin/l2tp-gw)
  mkdir -p "$UNIT_DIR"
  cat > "$UNIT_DIR/l2tp-gw-watch.service" <<EOF
[Unit]
Description=l2tp-gw watch (alerts, DDNS check)

[Service]
Type=oneshot
Environment=CONF_DIR=$CONF_DIR
ExecStart=$gw watch
EOF
  cat > "$UNIT_DIR/l2tp-gw-watch.timer" <<EOF
[Unit]
Description=Run l2tp-gw watch every minute

[Timer]
OnBootSec=3min
OnUnitActiveSec=60s
AccuracySec=10s

[Install]
WantedBy=timers.target
EOF
  if [ "$NO_RESTART" != 1 ]; then
    systemctl daemon-reload
    systemctl enable --now l2tp-gw-watch.timer >/dev/null 2>&1 || echo "WARNING: could not enable l2tp-gw-watch.timer" >&2
  fi
}

usage() {
  sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
  case "${1:-}" in
    setup)  cmd_setup ;;
    add)    cmd_add ;;
    remove) cmd_remove "${2:-}" ;;
    list)   cmd_list ;;
    edit)   need_root; mkdir -p "$CONF_DIR"; touch "$SITES"; chmod 600 "$SITES"; nano "$SITES"; cmd_apply ;;
    apply)  cmd_apply ;;
    status) cmd_status ;;
    check)  cmd_check ;;
    reconnect) cmd_reconnect "${2:-}" ;;
    cut)       cmd_cut "${2:-}" ;;
    cut-all)   cmd_cut_all "${2:-}" ;;
    logs)   cmd_logs "${2:-}" "${3:-200}" ;;
    backup) cmd_backup "${2:-}" ;;
    backup-auto) need_root; cmd_backup_auto ;;
    restore) cmd_restore "${2:-}" ;;
    watch)  cmd_watch ;;
    notify-test) cmd_notify_test ;;
    notify) shift; cmd_notify "$@" ;;
    timer)  need_root; install_watch_timer ;;
    version) echo "l2tp-gw $VERSION" ;;
    routes-sync) cmd_routes_sync "${2:-}" "${3:-up}" ;;
    mtu-test)    cmd_mtu_test "${2:-}" "${3:-}" ;;
    mtu-apply)   cmd_mtu_apply "${2:-}" ;;
    mss-apply)   need_root; cmd_mss_apply ;;
    mtu-verify)  cmd_mtu_verify "${2:-}" ;;
    link-info)   cmd_link_info ;;
    quality-sample) cmd_quality_sample "${2:-}" ;;
    site-sync) cmd_site_sync ;;
    dialin-sync) cmd_dialin_sync ;;
    access-sync) need_root; apply_client_access "${2:-}" ;;
    disconnect)  cmd_disconnect "${2:-}" ;;
    validate) SITES=${2:?Usage: l2tp-gw validate FILE}; for_each_site validate_site; echo OK ;;
    *)      usage ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
