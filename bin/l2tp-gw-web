        % (rows, csrf, listopts, ("<br>Tunnel addresses now: " + hint) if hint else ""))
    # --- lists
    cards = ""
    for n in names:
        entries, perr = parse_list_text(rt_read_list(n) or "")
        used = [r["rule"] for r in rules if r["rule"]["list"] == n]
        nets = sum(len(v) for k, v, _ in entries if k == "nets")
        dns = sum(1 for k, v, _ in entries if k == "dns")
        ccs = [v for k, v, _ in entries if k == "country"]
        first = [o for _, _, o in entries[:4]]
        cards += ("<div class=card><div class=bar style='margin:0'><div><h2 style='margin:0'>%s</h2>"
                  "<div class=none>%d entr%s (%d network%s%s%s)%s</div></div><div class=acts>"
                  "<a class='btn sm' href='/routes/list?name=%s'>Edit</a>"
                  "<form method=post action=/routes/list/delete onsubmit=\"return confirm('Delete list %s?')\">"
                  "<input type=hidden name=csrf value='%s'><input type=hidden name=name value='%s'><button class='btn sm del'>Delete</button></form></div></div>"
                  "<div class='mono none' style='margin-top:6px'>%s</div></div>"
                  % (e(n), len(entries), "y" if len(entries) == 1 else "ies", nets, "" if nets == 1 else "s", (", %d DNS name%s" % (dns, "" if dns == 1 else "s")) if dns else "",
                     (", country " + ", ".join(ccs)) if ccs else "",
