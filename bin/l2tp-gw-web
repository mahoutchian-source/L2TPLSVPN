def dialin_howto_page(sid, name):
    """what to type on the MikroTik. The values are this client's real ones."""
    e = html.escape
    c = read_dialin()
    s = next((x for x in load_sites() if x["name"] == name and is_server(x)), None)
    if s is None:
        return page("Not found", "<p>Unknown client. <a href=/dialin>Back</a></p>", sid, None, "/dialin")
    pub = c["public_ip"] or "SERVER-PUBLIC-IP"
    cmd = ("/interface l2tp-client add name=to-gateway connect-to=%s user=%s password=%s "
           "use-ipsec=yes ipsec-secret=%s add-default-route=no disabled=no"
           % (pub, s.get("user", ""), s.get("pass", ""), c["psk"] or "IPSEC-SECRET"))
    body = ("<div class=bar><h1>Setup: %s</h1><a class=btn href=/dialin>Back</a></div>"
            "<div class=form><fieldset><legend>Values</legend>"
            "<p class=mono>Server: %s<br>Username: %s<br>Password: %s<br>IPsec secret: %s<br>Address this client gets: %s</p></fieldset>"
            "<fieldset><legend>MikroTik (RouterOS terminal)</legend>"
            "<p class=hint>Creates the L2TP/IPsec client on the router. Worked on a real MikroTik with its default IPsec settings. If yours does not connect, "
            "send me the router's log lines.</p><pre style='white-space:pre-wrap;word-break:break-all'>%s</pre>"
            "<p class=hint>Then send traffic through the tunnel, for example everything: <code>/ip route add dst-address=0.0.0.0/0 gateway=to-gateway distance=5</code>, "
            "and hide your LAN behind the tunnel address: <code>/ip firewall nat add chain=srcnat out-interface=to-gateway action=masquerade</code></p></fieldset>"
            "%s</div>"
            % (e(name), e(pub), e(s.get("user", "")), e(s.get("pass", "")), e(c["psk"]), e(s.get("ip", "")), e(cmd),
               "" if c["enabled"] == "yes" else "<div class=warnbox>Dial-in is switched off. Turn it on in the server settings first.</div>"))
    return page("Setup " + name, body, sid, None, "/dialin")


# ================= dashboard: system readings and the network card history =================
# CPU, memory, disk, kernel and service state are read when the page is shown (nothing is stored).
# Only the traffic of the main network card is recorded by the collector, in hourly and daily buckets,
# so "last 24 hours / 7 days / 30 days" survive a reboot of the server.
PROC = os.environ.get("PROC_DIR", "/proc")
NIC_FILE = os.path.join(TRAFFIC_DIR, "nic.json")
RESET_FLAG = os.path.join(TRAFFIC_DIR, "reset-all")


def main_nic():
    """name of the interface that carries the default route (the lowest metric wins)"""
    best = None
    try:
        with open(PROC + "/net/route") as f:
            next(f)
            for line in f:
                p = line.split()
                if len(p) > 6 and p[1] == "00000000" and (best is None or int(p[6]) < best[0]):
                    best = (int(p[6]), p[0])
    except (OSError, ValueError, StopIteration):
        return None
    return best[1] if best else None


def nic_counters(dev):
    """(received bytes, sent bytes) of an interface, or None"""
    try:
        with open(PROC + "/net/dev") as f:
            for line in f:
                if ":" in line:
                    name, rest = line.split(":", 1)
                    if name.strip() == dev:
                        v = rest.split()
                        return int(v[0]), int(v[8])
    except (OSError, ValueError, IndexError):
        pass
    return None


def read_nic():
    try:
        with open(NIC_FILE) as f:
            d = json.load(f)
        if isinstance(d, dict):
            d.setdefault("hours", {}); d.setdefault("days", {}); d.setdefault("since", 0); d.setdefault("last", None); d.setdefault("dev", "")
            return d
    except (OSError, ValueError):
        pass
    return {"dev": "", "last": None, "hours": {}, "days": {}, "since": 0}


class NicStats:
    """kept by the collector: adds the bytes of the main network card to the hour and day it happened in"""
    def __init__(self):
        self.d = read_nic()
        self.dirty = False

    def tick(self, now, local):
        dev = main_nic()
        c = nic_counters(dev) if dev else None
        if c is None:
            return
        last = self.d["last"]
        if self.d["dev"] != dev or last is None:
            delta = (0, 0)                       # another card, or the first reading: only remember it
        elif c[0] < last[0] or c[1] < last[1]:
            delta = c                            # counters restarted (reboot): everything on them is new
        else:
            delta = (c[0] - last[0], c[1] - last[1])
        if self.d["dev"] != dev or last != list(c):
            self.d["dev"], self.d["last"] = dev, list(c)
            self.dirty = True
        if delta[0] or delta[1]:
            for bucket, key in (("hours", local.strftime("%Y-%m-%dT%H")), ("days", local.strftime("%Y-%m-%d"))):
                row = self.d[bucket].setdefault(key, [0, 0])
                row[0] += delta[0]
                row[1] += delta[1]
            for bucket, keep in (("hours", 72), ("days", 400)):
                for k in sorted(self.d[bucket])[:-keep]:
                    del self.d[bucket][k]
            self.dirty = True

    def reset(self, now):
        self.d["hours"], self.d["days"], self.d["since"] = {}, {}, now
        self.dirty = True

    def flush(self):
        if self.dirty:
            atomic_write(NIC_FILE, json.dumps(self.d))
            self.dirty = False


def nic_windows(d, local):
    """-> {"24h": (rx, tx), "7d": ..., "30d": ...} from the buckets (a window never reaches back before the last reset)"""
    out = {}
    hour_keys = [(local - timedelta(hours=i)).strftime("%Y-%m-%dT%H") for i in range(24)]
    day_keys = [(local - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(30)]
    for name, keys, bucket in (("24h", hour_keys, "hours"), ("7d", day_keys[:7], "days"), ("30d", day_keys, "days")):
        out[name] = (sum(d[bucket].get(k, [0, 0])[0] for k in keys), sum(d[bucket].get(k, [0, 0])[1] for k in keys))
    return out


def sys_cpu():
    """CPU use in percent over a short moment (reads /proc/stat twice)"""
    def rd():
        v = [int(x) for x in open(PROC + "/stat").readline().split()[1:9]]
        return sum(v), v[3] + v[4]
    try:
        a = rd(); time.sleep(0.4); b = rd()
    except (OSError, ValueError, IndexError):
        return None
    dt = b[0] - a[0]
    return max(0.0, min(100.0, 100.0 * (1 - (b[1] - a[1]) / dt))) if dt > 0 else 0.0


def sys_mem():
    """(used percent, used bytes, total bytes)"""
    try:
        m = {}
        for line in open(PROC + "/meminfo"):
            k, v = line.split(":", 1)
            m[k] = int(v.split()[0]) * 1024
        tot, av = m["MemTotal"], m["MemAvailable"]
        return 100.0 * (tot - av) / tot, tot - av, tot
    except (OSError, ValueError, KeyError, ZeroDivisionError):
        return None


def sys_disk(path="/"):
    try:
        s = os.statvfs(path)
        tot = s.f_blocks * s.f_frsize
        free = s.f_bavail * s.f_frsize
        return 100.0 * (tot - free) / tot, tot - free, tot
    except (OSError, ZeroDivisionError):
        return None


def sys_uptime():
    try:
        return float(open(PROC + "/uptime").read().split()[0])
    except (OSError, ValueError, IndexError):
        return None


KERNEL_CACHE = {"t": 0, "v": None}


def kernel_health():
    """-> (kernel release, reboot needed, errors in the kernel log in 24 h or None, out-of-memory kills or None); cached for a minute"""
    if time.time() - KERNEL_CACHE["t"] < 60 and KERNEL_CACHE["v"]:
        return KERNEL_CACHE["v"]
    rc, out = run(["journalctl", "-k", "-p", "err", "--since", "24 hours ago", "--no-pager", "-q"], 15)
    errs = ooms = None
    if rc == 0:
        lines = [l for l in out.splitlines() if l.strip() and not l.startswith("-- ")]
        errs = len(lines)
        ooms = sum(1 for l in lines if re.search(r"Out of memory|oom-kill|Killed process", l))
    v = (os.uname().release, os.path.exists("/var/run/reboot-required") or os.path.exists("/run/reboot-required"), errs, ooms)
    KERNEL_CACHE.update(t=time.time(), v=v)
    return v


def ike_unit():
    rc, _ = run(["systemctl", "cat", "strongswan-starter.service"], 5)
    return "strongswan-starter" if rc == 0 else "strongswan"


def svc_active(name):
    rc, out = run(["systemctl", "is-active", name], 5)
    return out.strip() == "active"


def telegram_state():
    """-> (class, text): grey = not set up, green = last message went out, red = last try failed, amber = never tried"""
    c = read_notify()
    if not (c["telegram_token"] and c["telegram_chat"]):
        return "off", "Not set up (Settings)"
    try:
        ts, rc = open(os.path.join(STATE_DIR, "notify.last")).read().split()
        when = datetime.fromtimestamp(int(ts), get_tz(read_general()["timezone"])).strftime("%m-%d %H:%M")
        return ("ok", "Last message sent %s" % when) if rc == "0" else ("bad", "Last message FAILED %s (check token, chat id, internet)" % when)
    except (OSError, ValueError):
        return "warn", "Set up, but no message was sent yet. Send a test message."


def firewall_state(dialin_on):
    """-> (css class, text, access-rules text). The gateway firewall = chain L2TPGW-IN (UDP 1701 only inside IPsec, needed
    while dial-in is on) and chain L2TPGW-ACC (what each client may reach). Both must be hooked into INPUT / FORWARD."""
    rc_in, out_in = run(["iptables", "-S", "L2TPGW-IN"], 5)
    hooked_in = run(["iptables", "-C", "INPUT", "-j", "L2TPGW-IN"], 5)[0] == 0
    rc_acc, out_acc = run(["iptables", "-S", "L2TPGW-ACC"], 5)
    hooked_acc = run(["iptables", "-C", "FORWARD", "-j", "L2TPGW-ACC"], 5)[0] == 0
    n_acc = len([ln for ln in (out_acc or "").splitlines() if ln.startswith("-A ")])
    if dialin_on:
        if rc_in == 0 and hooked_in and "-j DROP" in (out_in or ""):
            fw = ("up", "active (UDP 1701 only inside IPsec)")
        else:
            fw = ("down", "NOT active, run apply")
    else:
        fw = ("none", "not needed (dial-in is off)")
    if rc_acc == 0 and hooked_acc:
        acc = "active, %d rule%s" % (n_acc, "" if n_acc == 1 else "s") if n_acc else "active, nothing blocked"
    else:
        acc = "not installed yet"
    return fw[0], fw[1], acc


def pct_cls(p, warn, bad):
    return "bad" if p >= bad else "warn" if p >= warn else "ok"


def fmt_dur(sec):
    sec = int(sec)
    d, r = divmod(sec, 86400)
    h, r = divmod(r, 3600)
    return ("%dd %dh" % (d, h)) if d else ("%dh %dm" % (h, r // 60))


def events_table(limit, tzname, short=False, items=None):
    e = html.escape
    tz = get_tz(tzname)
    rows = "".join("<tr><td class=mono>%s</td><td><span class='evk %s'>%s</span></td><td>%s</td></tr>"
                   % (datetime.fromtimestamp(t, tz).strftime("%m-%d %H:%M" if short else "%Y-%m-%d %H:%M:%S"), e(k), e({"up": "up", "down": "down", "warn": "warning"}.get(k, "info")), e(m))
                   for t, k, m in (read_events(limit) if items is None else items))
    return ("<table class='t evt'><tr><th>Time</th><th>Type</th><th>Event</th></tr>%s</table>" % rows) if rows else "<p>No events yet.</p>"


EVENTS_PER_PAGE = 25


def pager(base, page_no, pages):
    """links  < Newer  1 2 [3] 4 ... 40  Older >  (empty text when there is only one page)"""
    if pages <= 1:
        return ""
    def a(n, text=None, cls=""):
        return "<a class='pg %s' href='%s?p=%d'>%s</a>" % (cls, base, n, text or n)
    shown = sorted({1, pages} | set(range(max(1, page_no - 2), min(pages, page_no + 2) + 1)))
    out, prev = [], 0
    if page_no > 1:
        out.append(a(page_no - 1, "&larr; Newer"))
    for n in shown:
        if n - prev > 1:
            out.append("<span class=pgdots>&hellip;</span>")
        out.append("<span class='pg on'>%d</span>" % n if n == page_no else a(n))
        prev = n
    if page_no < pages:
        out.append(a(page_no + 1, "Older &rarr;"))
    return "<div class=pager>%s</div>" % "".join(out)


def events_page(sid, msg=None, page_no=1):
    gen = read_general()
    items = read_events(EVENTS_MAX_LINES)
    pages = max(1, -(-len(items) // EVENTS_PER_PAGE))
    page_no = min(max(1, page_no), pages)
    part = items[(page_no - 1) * EVENTS_PER_PAGE: page_no * EVENTS_PER_PAGE]
    pg = pager("/events", page_no, pages)
    body = ("<div class=bar><div><h1>Events</h1><div class=sum>Tunnels and dial-in clients going up and down, switches, resets and warnings. "
            "Times follow %s time. Newest first, %d per page; the server keeps about the last %d events.</div></div></div>"
            "<div class=card>%s%s%s</div>"
            % (html.escape(gen["timezone"]), EVENTS_PER_PAGE, EVENTS_MAX_LINES, events_table(0, gen["timezone"], False, part), pg,
               ("<p class=sum>Page %d of %d (%d events)</p>" % (page_no, pages, len(items))) if pages > 1 else ""))
    return page("Events", body, sid, msg, "/events")


def dash_card(title, rows, status=None):
    """rows = [(label, value-html)]; status = ok/warn/bad/off shows a coloured dot in the title"""
    dot = ("<i class='dot %s'></i>" % status) if status else ""
    body = "".join("<div class=kv><span>%s</span><div class=v>%s</div></div>" % (l, v) for l, v in rows)
    return "<div class=card><h2>%s%s</h2>%s</div>" % (dot, title, body)


def meter(p, cls):
    return "<div class='meter %s'><span style='width:%d%%'></span></div>" % (cls, max(0, min(100, int(p))))


def dash_html(sid):
    e = html.escape
    gen = read_general()
    unit, tz = gen["unit"], get_tz(gen["timezone"])
    local = datetime.now(tz)
    cards = []
    # --- system
    cpu, mem, dsk = sys_cpu(), sys_mem(), sys_disk()
    la = os.getloadavg() if hasattr(os, "getloadavg") else (0, 0, 0)
    cores = os.cpu_count() or 1
    rows, worst = [], "ok"
    def lvl(c):
        nonlocal worst
        if c == "bad" or (c == "warn" and worst == "ok"):
            worst = c
    if cpu is not None:
        c = pct_cls(cpu, 60, 85); lvl(c)
        rows.append(("CPU", "%d%%%s" % (round(cpu), meter(cpu, c))))
    rows.append(("Load (1 / 5 / 15 min)", "%.2f / %.2f / %.2f &middot; %d core%s" % (la[0], la[1], la[2], cores, "" if cores == 1 else "s")))
    if mem:
        c = pct_cls(mem[0], 75, 90); lvl(c)
        rows.append(("Memory", "%d%% &middot; %s of %s%s" % (round(mem[0]), e(fmt_bytes(mem[1], unit)), e(fmt_bytes(mem[2], unit)), meter(mem[0], c))))
    if dsk:
        c = pct_cls(dsk[0], 80, 90); lvl(c)
        rows.append(("Disk /", "%d%% &middot; %s of %s%s" % (round(dsk[0]), e(fmt_bytes(dsk[1], unit)), e(fmt_bytes(dsk[2], unit)), meter(dsk[0], c))))
    up = sys_uptime()
    if up is not None:
        rows.append(("Uptime", e(fmt_dur(up))))
    cards.append(dash_card("System", rows, worst))
    # --- kernel
    rel, reboot, errs, ooms = kernel_health()
    st = "ok"
    rows = [("Kernel", "<span class=mono>%s</span>" % e(rel))]
    if errs is None:
        rows.append(("Kernel log, 24 h", "cannot be read")); st = "warn"
    else:
        if errs:
            st = "warn"
        if ooms:
            st = "bad"
        rows.append(("Errors, last 24 h", "%d" % errs))
        rows.append(("Out-of-memory kills", "%d" % ooms))
    if reboot:
        st = "warn" if st == "ok" else st
    rows.append(("Reboot needed", "yes (an update is waiting)" if reboot else "no"))
    cards.append(dash_card("Kernel health", rows, st))
    # --- network card
    nd = read_nic()
    dev = main_nic()
    w = nic_windows(nd, local)
    rows = [("Interface", "<span class=mono>%s</span>" % e(dev or "none")),
            ("Speed now", "<span class='speed mono' data-speed='__nic'>&darr; - &nbsp;&uarr; -</span>")]
    for key, label in (("24h", "Last 24 hours"), ("7d", "Last 7 days"), ("30d", "Last 30 days")):
        rows.append((label, "&darr; %s &nbsp;&uarr; %s" % (e(fmt_bytes(w[key][0], unit)), e(fmt_bytes(w[key][1], unit)))))
    if nd["since"]:
        rows.append(("Counting since", e(datetime.fromtimestamp(nd["since"], tz).strftime("%Y-%m-%d %H:%M"))))
    cards.append(dash_card("Network card (all traffic)", rows, "ok" if dev else "warn"))
    # --- services
    ike = ike_unit()
    svcs = [(ike, "IPsec (strongSwan)", svc_active(ike)), ("xl2tpd", "L2TP (xl2tpd)", svc_active("xl2tpd")),
            ("collector", "Traffic collector", collector_alive()), ("panel", "This web panel", True)]
    rows, st = [], "ok"
    for _, label, ok in svcs:
        rows.append((label, "<span class='state %s'>%s</span>" % ("up" if ok else "down", "running" if ok else "NOT running")))
        if not ok:
            st = "bad"
    di = read_dialin()
    if di["enabled"] == "yes":
        lis = dialin_listening()
        rc, _ = run(["iptables", "-S", "L2TPGW-IN"], 5)
        good = lis is not False and rc == 0
        rows.append(("Dial-in", "<span class='state %s'>%s</span>" % ("up" if good else "half", "on" if good else "on, check Dial-in page")))
        if not good and st == "ok":
            st = "warn"
    else:
        rows.append(("Dial-in", "<span class=none>off</span>"))
    fw_cls, fw_txt, acc_txt = firewall_state(di["enabled"] == "yes")
    rows.append(("Firewall", "<span class='state %s'>%s</span>" % (fw_cls, fw_txt)))
    rows.append(("Access rules", acc_txt))
    if fw_cls == "down" and st != "bad":
        st = "warn"
    cards.append(dash_card("Services", rows, st))
    # --- tunnels
    ppp, ipsec = live_status()
    sites = load_sites()
    cl_all = [s for s in sites if not is_server(s)]
    cl = [s for s in cl_all if s.get("disabled") != "yes"]
    n_off = len(cl_all) - len(cl)
    sv = [s for s in sites if is_server(s) and s.get("disabled") != "yes"]
    cl_up = [s for s in cl if s["name"] in ppp]
    sv_up = [s for s in sv if s["name"] in ppp]
    plain = 0
    for s in cl_up:
        n = s["name"]
        has = bool(re.search(r"(^|\s)%s(\[\d+\]: ESTABLISHED|\{\d+\}:\s+INSTALLED)" % re.escape(n), ipsec or ""))
        if ipsec is not None and not has and (s.get("ipsec_mode") or "heal") != "allow":
            plain += 1
    near = 0
    qs = read_state()["quota"]
    for s in sites:
        if s.get("quota_gb") and qs.get(s["name"]):
            limit = float(s["quota_gb"]) * UNITS[unit]
            if quota_used(qs[s["name"]], s.get("quota_dir") or "total") * 100.0 / limit >= int(s.get("quota_warn") or 80):
                near += 1
    st = "ok"
    if len(cl_up) < len(cl):
        st = "warn"
    if plain:
        st = "bad"
    rows = [("Sites (we dial)", "%d of %d up" % (len(cl_up), len(cl))),
            ("Dial-in clients", "%d of %d connected" % (len(sv_up), len(sv))),
            ("Switched off", ("%d site%s" % (n_off, "" if n_off == 1 else "s")) if n_off else "none"),
            ("Without IPsec", ("<span class='state down'>%d tunnel%s</span>" % (plain, "" if plain == 1 else "s")) if plain else "none"),
            ("Near the traffic limit", "%d" % near if near else "none")]
    cards.append(dash_card("Tunnels", rows, st if (cl or sv) else "off"))
    # --- VPN traffic
    days = {"today": [local.date().isoformat()],
            "7d": [(local.date() - timedelta(days=i)).isoformat() for i in range(7)],
            "30d": [(local.date() - timedelta(days=i)).isoformat() for i in range(30)]}
    tot = {k: [0, 0] for k in days}
    per = []
    for s in sites:
        rows_d = read_daily(s["name"])
        for k, ds in days.items():
            for d in ds:
                v = rows_d.get(d)
                if v:
                    tot[k][0] += v[0]; tot[k][1] += v[1]
        m = sum(sum(rows_d.get(d, [0, 0])) for d in days["30d"])
        if m:
            per.append((m, s["name"]))
    rows = [(lab, "&darr; %s &nbsp;&uarr; %s" % (e(fmt_bytes(tot[k][0], unit)), e(fmt_bytes(tot[k][1], unit))))
            for k, lab in (("today", "Today"), ("7d", "Last 7 days"), ("30d", "Last 30 days"))]
    per.sort(reverse=True)
    if per:
        rows.append(("Top, 30 days", ", ".join("%s %s" % (e(n), e(fmt_bytes(m, unit))) for m, n in per[:3])))
    cards.append(dash_card("VPN traffic (inside the tunnels)", rows))
    # --- alerts
    tcls, ttxt = telegram_state()
    cards.append(dash_card("Alerts (Telegram)", [("Status", e(ttxt))], tcls) +
                 "")
    # --- recent events
    cards.append("<div class=card><h2>Recent events</h2>%s<p><a href=/events>All events</a></p></div>" % events_table(8, gen["timezone"], True))
    # --- verdict and tunnel strip (one segment per tunnel: green up, red down, hatched switched off, grey dial-in client not connected)
    segs = []
    down_names = [s["name"] for s in cl if s["name"] not in ppp]
    for s in cl_all:
        n = s["name"]
        c = "off" if s.get("disabled") == "yes" else ("up" if n in ppp else "down")
        segs.append((c, n, {"off": "switched off", "up": "up", "down": "down"}[c]))
    for s in sites:
        if is_server(s):
            c = "off" if s.get("disabled") == "yes" else ("up" if s["name"] in ppp else "wait")
            segs.append((c, s["name"], {"off": "dial-in, switched off", "up": "dial-in client connected", "wait": "dial-in client not connected"}[c]))
    if not segs:
        verdict, vcls = "No tunnels yet", "off"
    elif down_names:
        verdict = "%d tunnel%s down: %s" % (len(down_names), "" if len(down_names) == 1 else "s",
                                            ", ".join(down_names[:3]) + (" and %d more" % (len(down_names) - 3) if len(down_names) > 3 else ""))
        vcls = "bad"
    elif plain:
        verdict, vcls = "%d tunnel%s running without IPsec" % (plain, "" if plain == 1 else "s"), "bad"
    else:
        verdict, vcls = "All tunnels are up", "ok"
    hero = ("<div class=hero><h2><i class='dot %s'></i>%s</h2><div class=sub>%d of %d sites up, %d of %d dial-in clients connected</div>"
            "<div class=seg>%s</div>"
            "<div class=legend><span><b class=up></b>up</span><span><b class=down></b>down</span>"
            "<span><b class=wait></b>dial-in, not connected</span><span><b class=off></b>switched off</span></div></div>"
            % (vcls, e(verdict), len(cl_up), len(cl), len(sv_up), len(sv),
               "".join("<i class='%s' title='%s: %s'></i>" % (c, e(n), t) for c, n, t in segs)))
    # cards were appended in this order: 0 System, 1 Kernel health, 2 Network card, 3 Services, 4 Tunnels, 5 VPN traffic, 6 Alerts, 7 Recent events
    left, right = [cards[i] for i in (4, 5, 7)], [cards[i] for i in (0, 2, 3, 1, 6)]
    return hero + "<div class=cols><div class=col>%s</div><div class=col>%s</div></div>" % ("".join(left), "".join(right))


def dash_page(sid, msg=None):
    e = html.escape
    g = read_general()
    body = ("<div class=bar><div><h1>Dashboard</h1><div class=sum>%s &middot; refreshes every 10 seconds</div></div></div>"
            "<div id=live data-src='?page=dash'>%s</div>"
            "<form method=post action=/settings/test style='margin-top:14px'><input type=hidden name=csrf value='%s'>"
            "<input type=hidden name=back value=/><button class='btn sm'>Send a Telegram test message</button></form>"
            % (e(g["brand"]), dash_html(sid), e(csrf_of(sid))))
    return page("Dashboard", body, sid, msg, "/")


def sum_days(rows, pred):
    d = u = 0
    for date, v in rows.items():
        if pred(date):
            d += v[0]
            u += v[1]
    return d, u


ARCH_RE = re.compile(r"archive-\d{8}-\d{6}")
NAME_RE = re.compile(r"[A-Za-z0-9_.-]{1,40}")


def archive_page(sid, msg=None):
    """Traffic > Archive: the reports that a reset or a delete moved away (nothing is ever removed)"""
    e = html.escape
    unit = read_general().get("unit", "GB")
    try:
        dirs = sorted((x for x in os.listdir(TRAFFIC_DIR) if ARCH_RE.fullmatch(x)), reverse=True)
    except OSError:
        dirs = []
    out = ""
    for dname in dirs:
        rows = ""
        try:
            files = sorted(x for x in os.listdir(os.path.join(TRAFFIC_DIR, dname)) if x.endswith(".csv"))
        except OSError:
            files = []
        for fn in files:
            n = fn[:-4]
            data = read_daily(n, os.path.join(TRAFFIC_DIR, dname, fn))
            if not data:
                continue
            days = sorted(data)
            rows += ("<tr><td>%s</td><td>%s &ndash; %s</td><td>%d</td><td>%s</td><td>%s</td>"
                     "<td><a href='/traffic/archive/csv?d=%s&amp;n=%s'>CSV</a></td></tr>"
                     % (e(n), days[0], days[-1], len(days), e(fmt_bytes(sum(v[0] for v in data.values()), unit)),
                        e(fmt_bytes(sum(v[1] for v in data.values()), unit)), dname, e(n)))
        if rows:
            t = "%s-%s-%s %s:%s:%s" % (dname[8:12], dname[12:14], dname[14:16], dname[17:19], dname[19:21], dname[21:23])
            out += ("<div class=card><h2>Archived %s</h2><table class=t><tr><th>Site</th><th>Days recorded</th><th>Days</th>"
                    "<th>Download</th><th>Upload</th><th></th></tr>%s</table></div>" % (t, rows))
    body = ("<div class=bar><div><h1>Traffic archive</h1><div class=sum>Reports moved here when you reset a site, reset all counters "
            "or deleted a site. Nothing here is deleted by the program.</div></div><a class=btn href=/traffic>Back to Traffic</a></div>%s"
            % (out or "<p>The archive is empty.</p>"))
    return page("Traffic archive", body, sid, msg, "/traffic")


def traffic_page(sid, msg=None):
    e = html.escape
    gen = read_general()
    unit, tz = gen["unit"], get_tz(gen["timezone"])
    local = datetime.now(tz)
    today = local.date()
    st = read_state()
    iso = today.isocalendar()
    head = ""
    if not collector_alive():
        head = ("<div class=warnbox>The traffic collector is not running, so numbers are not being updated. "
                "On the server run: l2tp-gw-web install</div>")
    cards = ""
    for s in load_sites():
        n = s["name"]
        rows = read_daily(n)
        tot_today = sum_days(rows, lambda d: d == today.isoformat())
        tot_week = sum_days(rows, lambda d: datetime.strptime(d, "%Y-%m-%d").isocalendar()[:2] == iso[:2])
        tot_month = sum_days(rows, lambda d: d[:7] == today.isoformat()[:7])
        tot_all = sum_days(rows, lambda d: True)
        def cell(label, t):
            return "<div><b>%s</b>&darr; %s<br>&uarr; %s</div>" % (label, e(fmt_bytes(t[0], unit)), e(fmt_bytes(t[1], unit)))
        days = [(today - timedelta(days=i)).isoformat() for i in range(29, -1, -1)]
        peak = max([sum(rows.get(d, [0, 0])) for d in days] + [1])
        bars = "".join("<div class=bar title='%s: &darr; %s &uarr; %s'><i style='height:%d%%'></i></div>"
                       % (d, e(fmt_bytes(rows.get(d, [0, 0])[0], unit)), e(fmt_bytes(rows.get(d, [0, 0])[1], unit)),
                          int(sum(rows.get(d, [0, 0])) * 100 / peak)) for d in days)
        table = "".join("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>"
                        % (d, e(fmt_bytes(rows[d][0], unit)), e(fmt_bytes(rows[d][1], unit)), e(fmt_bytes(sum(rows[d]), unit)))
                        for d in sorted(rows, reverse=True)[:62])
        q = st["quota"].get(n)
        qbox = ""
        if s.get("quota_gb"):
            since = datetime.fromtimestamp(q["reset_at"], tz).strftime("%Y-%m-%d %H:%M") if q else "-"
            qbox = (quota_html(s, st, unit) +
                    "<div class=qtxt>Counter started %s &middot; warning at %s%%</div>"
                    "<form method=post action=/traffic/reset onsubmit=\"return confirm('Reset the limit counter of %s? Reports are kept.')\">"
                    "<input type=hidden name=csrf value='%s'><input type=hidden name=name value='%s'>"
                    "<button class='btn sm' style='margin-top:6px'>Reset limit counter</button></form>"
                    % (since, e(s.get("quota_warn") or "80"), e(n), e(csrf_of(sid)), e(n)))
        cards += ("<div class=card><h2>%s <small style='font-weight:normal;opacity:.7'>(%s)</small></h2>%s<div class=tot>%s%s%s%s</div>"
                  "<div class=qtxt>Last 30 days (hover a bar for the numbers)</div><div class=bars>%s</div>"
                  "<form method=post action=/traffic/reset style='margin:8px 0' onsubmit=\"return confirm('Reset ALL numbers of %s (usage reports and limit counter)? The old daily reports are moved to an archive folder, not deleted.')\">"
                  "<input type=hidden name=csrf value='%s'><input type=hidden name=name value='%s'><input type=hidden name=all value=1>"
                  "<button class='btn sm link' style='padding-left:0'>Reset all numbers of this site</button></form>"
                  "<details><summary>Daily table</summary><table class=t><tr><th>Date</th><th>Download</th><th>Upload</th><th>Total</th></tr>%s</table></details></div>"
                  % (e(n), "dial-in client" if is_server(s) else "outgoing", qbox, cell("Today", tot_today), cell("This week", tot_week), cell("This month", tot_month),
                     cell("All recorded", tot_all), bars, e(n), e(csrf_of(sid)), e(n), table or "<tr><td colspan=4>No data yet</td></tr>"))
    body = ("<div class=bar><div><h1>Traffic</h1><div class=sum>Download = sent to the MikroTik, upload = received from it. "
            "Counted inside the tunnel (the real internet traffic is a bit higher because of IPsec overhead). "
            "Days follow %s time. Unit: %s.</div></div><span><a class=btn href=/traffic/archive>Archive</a> <a class=btn href=/traffic/csv>Download all as CSV</a></span></div>%s<div class=tgrid>%s</div>"
            % (e(gen["timezone"]), unit, head, cards or "<p>No sites yet.</p>"))
    return page("Traffic", body, sid, msg, "/traffic")


def check_page(sid, msg=None):
    e = html.escape
    rc, out = run([GW, "check"], 60)
    rows, result = "", ""
    for line in out.splitlines():
        m = re.match(r"(OK|WARN|FAIL)\s+(.*)", line)
        if m:
            rows += "<div><span class='pill %s'>%s</span><span>%s</span></div>" % (m.group(1), m.group(1), e(m.group(2)))
        elif line.startswith("RESULT:"):
            result = line[7:].strip()
        elif line.strip():
            rows += "<div><span>%s</span></div>" % e(line)
    body = ("<div class=bar><div><h1>Health check</h1><div class=sum>%s</div></div>"
            "<a class='btn' href=/check>Run again</a></div><div class=chk>%s</div>"
            "<p class=note>OK = fine. WARN = look at it. FAIL = something is broken. "
            "The same check is available on the server with: l2tp-gw check</p>"
            % (e(result or "Check could not run"), rows or "<div><span>%s</span></div>" % e(out)))
    return page("Health check", body, sid, msg, "/check")


def logs_page(sid, name, n):
    e = html.escape
    if name:
        if not any(s["name"] == name for s in load_sites()):
            return page("Logs", "<p>Unknown site. <a href=/sites>Back</a></p>", sid)
        rc, out = run([GW, "logs", name, str(n)], 30)
        title = "Logs: " + name
        note = "Lines of the IPsec and L2TP/PPP services that mention %s. Some lines do not name the site and are only in the full log." % e(name)
        other = "<a class=btn href='/logs'>Show full log</a>"
    else:
        rc, out = run([GW, "logs", "", str(n)], 30)
        title = "Logs: all"
        note = "Newest lines of the IPsec and xl2tpd/pppd services, oldest first."
        other = ""
    body = ("<div class=bar><div><h1>%s</h1><div class=sum>%s</div></div><div>%s <a class=btn href=/sites>Back</a></div></div>"
            "<pre>%s</pre>" % (e(title), note, other, e(out or "(no matching lines)")))
    return page(title, body, sid, None, "/")


AUTOBACKUP_DIR = os.environ.get("AUTOBACKUP_DIR", "/var/backups/l2tp-gw")
AUTO_RE = re.compile(r"sites-\d{8}-\d{6}\.conf")


def autobackups():
    """newest first: [(file name, size, time)]"""
    try:
        names = sorted((x for x in os.listdir(AUTOBACKUP_DIR) if AUTO_RE.fullmatch(x)), reverse=True)
    except OSError:
        return []
    out = []
    for n in names:
        try:
            st = os.stat(os.path.join(AUTOBACKUP_DIR, n))
            out.append((n, st.st_size, st.st_mtime))
        except OSError:
            pass
    return out


def backup_page(sid, msg=None, content=""):
    e = html.escape
    rows = "".join("<tr><td>%s</td><td>%d bytes</td><td><a href='/backup/auto?f=%s'>Download</a></td></tr>"
                   % (time.strftime("%Y-%m-%d %H:%M", time.localtime(t)), z, e(n)) for n, z, t in autobackups())
    auto = ("<fieldset><legend>Automatic backups</legend><p>A copy is saved on this server when the settings change (one file per day, the last state of that day). "
            "The newest 7 days are kept. They are on the same disk, so they protect against a mistake, not against losing the server: "
            "download one now and then.</p>%s</fieldset>"
            % (("<table class=t><tr><th>Saved</th><th>Size</th><th></th></tr>%s</table>" % rows) if rows else "<p>No automatic backup yet. The first one is made within a minute after the update.</p>"))
    body = ("<div class=bar><h1>Backup and restore</h1></div>"
            "<div class=form><fieldset><legend>Backup</legend>"
            "<p>The sites file holds every site with its passwords (and the dial-in settings). Download it and keep it somewhere private.</p>"
            "<p><a class='btn pri' href=/backup/download>Download sites file</a></p></fieldset>" + auto +
            "<fieldset><legend>Restore</legend>"
            "<p>Paste the content of a saved sites file, or choose the file. It is checked first. "
            "If it is not valid, nothing changes. If it is valid it replaces ALL current sites and the VPN services restart.</p>"
            "<form method=post action=/restore onsubmit=\"return confirm('Replace all sites with this file?')\">"
            "<input type=hidden name=csrf value='%s'>"
            "<p><input type=file id=pick accept='.conf,text/plain'></p>"
            "<textarea name=content id=content spellcheck=false autocomplete=off>%s</textarea>"
            "<p><button class='btn pri' data-busy='Applying, please wait...'>Restore</button></p></form></fieldset></div>"
            "<script>document.getElementById('pick').addEventListener('change',function(ev){var f=ev.target.files[0];if(!f)return;"
            "var r=new FileReader();r.onload=function(){document.getElementById('content').value=r.result};r.readAsText(f)})</script>"
            % (e(csrf_of(sid)), e(content)))
    return page("Backup", body, sid, msg, "/backup")


def settings_page(sid, msg=None, vals=None):
    e = html.escape
    c = vals or read_notify()
    body0 = ("<div class=bar style='margin-top:26px'><h1>Alerts</h1></div>"
            "<form class=form method=post action=/settings autocomplete=off><input type=hidden name=csrf value='%s'>"
            "<fieldset><legend>Telegram</legend>"
            "<p>When a tunnel stays down, a message is sent to your Telegram. Another message tells you when it is back. "
            "Leave the token empty to keep alerts off.</p>"
            "<label for=tok>Bot token<span class=hint>%s Create a bot with @BotFather in Telegram to get one.</span></label>"
            "<input type=password id=tok name=telegram_token placeholder='%s'>"
            "<label for=chat>Chat ID<span class=hint>Your user ID or a group ID. Send a message to your bot first.</span></label>"
            "<input type=text id=chat name=telegram_chat value='%s' class=mono>"
            "<label for=min>Alert after (minutes down)</label><input type=text id=min name=down_after_min value='%s' class=mono>"
            "<label for=srv>Server name in messages<span class=hint>Optional, to tell servers apart.</span></label>"
            "<input type=text id=srv name=server_name value='%s'>"
            "<label class=chk><input type=checkbox name=tg_send_config value=yes%s> Send the settings file to Telegram every time it changes</label>"
            "<span class=hint>Needs the bot above. The file contains ALL passwords and the IPsec secret, and Telegram is not end-to-end encrypted: "
            "use a private chat that only you can read. One message is sent after you stop editing for a minute.</span></fieldset>"
            "<fieldset><legend>DNS cache</legend>"
            "<label for=dnsf>Empty the DNS cache every (minutes)<span class=hint>So a site whose address name (DDNS) got a new IP is found again. 0 = never. Default 30.</span></label>"
            "<input type=text id=dnsf name=dns_flush_min value='%s' class=mono></fieldset>"
            "<p><button class='btn pri'>Save</button></p></form>"
            "<form class=form method=post action=/settings/test style='margin-top:14px'><input type=hidden name=csrf value='%s'>"
            "<p>Sends one test message with the saved settings.</p><button class=btn>Send test message</button></form>"
            % (e(csrf_of(sid)), "A token is saved. Leave empty to keep it." if c["telegram_token"] else "No token saved.",
               "unchanged" if c["telegram_token"] else "", e(c["telegram_chat"]), e(c["down_after_min"]), e(c["server_name"]),
               " checked" if c["tg_send_config"] == "yes" else "", e(c["dns_flush_min"]), e(csrf_of(sid))))
    g = read_general()
    known = [v for v, _ in TZ_CHOICES]
    tzopts = options(TZ_CHOICES + [("__custom__", "Other (type below)")], g["timezone"] if g["timezone"] in known else "__custom__")
    body = ("<div class=bar><h1>Settings</h1></div>"
            "<form class=form method=post action=/settings/general><input type=hidden name=csrf value='%s'>"
            "<fieldset><legend>Name</legend>"
            "<label for=brand>Name shown at the top of every page<span class=hint>For example your company. Clicking it opens the dashboard.</span></label>"
            "<input type=text id=brand name=brand value='%s' maxlength=40></fieldset>"
            "<fieldset><legend>Time zone and unit</legend>"
            "<p>The time zone decides where a day starts in the traffic reports and when the daily reconnect time is. "
            "Days already recorded keep their date.</p>"
            "<label for=tz>Time zone</label><select id=tz name=tz_choice>%s</select>"
            "<label for=tzc>Other time zone name<span class=hint>Example: Asia/Istanbul. Used only if you pick Other.</span></label>"
            "<input type=text id=tzc name=tz_custom value='%s' class=mono>"
            "<label for=unit>Unit for sizes and limits</label><select id=unit name=unit>%s</select>"
            "<span class=hint>GB = 1,000,000,000 bytes (like providers). GiB = 1,073,741,824 bytes (like MikroTik).</span></fieldset>"
            "<p><button class='btn pri'>Save</button></p></form>"
            % (e(csrf_of(sid)), e(g["brand"]), tzopts, e(g["timezone"]) if g["timezone"] not in known else "",
               options([("GB", "GB (decimal)"), ("GiB", "GiB (binary)")], g["unit"])))
    body += ("<form class=form method=post action=/settings/password autocomplete=off style='margin-top:14px'>"
             "<input type=hidden name=csrf value='%s'><fieldset><legend>Panel password</legend>"
            "<p>The password you use to log in to this panel. Other open sessions are logged out when you change it.</p>"
            "<label for=pw0>Current password</label><input type=password id=pw0 name=current autocomplete=current-password>"
            "<label for=pw1>New password<span class=hint>At least 8 characters, no spaces.</span></label>"
            "<input type=password id=pw1 name=new1 autocomplete=new-password>"
            "<label for=pw2>New password again</label><input type=password id=pw2 name=new2 autocomplete=new-password>"
            "<p><button class='btn pri'>Change password</button></p></fieldset></form>" % e(csrf_of(sid)))
    body += ("<form class=form method=post action=/settings/reset-stats style='margin-top:14px' "
             "onsubmit=\"return confirm('Reset ALL traffic counters (network card, VPN usage, limit counters)? The old daily reports are moved to an archive folder, not deleted.')\">"
             "<input type=hidden name=csrf value='%s'><fieldset><legend>Statistics</legend>"
             "<p>Sets the traffic numbers of the dashboard, the Traffic page and the limit counters back to zero. "
             "The old daily reports are not deleted: they are moved into an archive folder on the server.</p>"
             "<button class='btn del'>Reset all counters</button></fieldset></form>" % e(csrf_of(sid)))
    return page("Settings", body + body0, sid, msg, "/settings")


# ---------- route manager pages ----------
PENDING = {}       # session id -> change waiting for "Apply" on the review page


def rt_ago(ts):
    s = int(time.time() - ts)
    return "%d s ago" % s if s < 90 else "%d min ago" % (s // 60) if s < 5400 else "%d h ago" % (s // 3600)


def rt_peers_hint(sites):
    """tunnel address -> sites, for the hint under the add-rule form"""
    tun = rt_tunnels(sites)
    groups = {}
    for n, t in sorted(tun.items()):
        if t["peer"]:
            groups.setdefault(t["peer"], []).append(n)
    return groups


def rt_state_html(rep):
    e = html.escape
    cls = {"ok": "ok", "down": "warn", "disabled": "mute", "nohop": "bad", "nolist": "bad"}[rep["state"]]
    label = {"ok": "Active", "down": "Tunnel down", "disabled": "Off", "nohop": "No next hop", "nolist": "List missing"}[rep["state"]]
    extra = ""
    if rep["unresolved"]:
        extra += " &middot; %d name%s not resolved yet" % (rep["unresolved"], "" if rep["unresolved"] == 1 else "s")
    if rep.get("nodata"):
        extra += " &middot; country data not downloaded yet"
    return "<span class='rtst %s'>%s</span><div class=rtsub>%s%s</div>" % (cls, label, e(rep["text"]), extra)


def routes_page(sid, msg=None):
    e = html.escape
    csrf = e(csrf_of(sid))
    res = rt_compute()
    sites = load_sites()
    status = rt_json_read("status.json", {})
    rules = res["rules"]
    names = rt_list_names()
    # --- status line
    parts = []
    if status:
        parts.append("%d routes applied, checked %s" % (status.get("routes", 0), rt_ago(status["ts"])))
        if status.get("errors"):
            parts.append("<span class='rtst bad'>%d command errors</span>" % status["errors"])
    if not collector_alive():
        parts.append("<span class='rtst warn'>the collector service is not running: changes made here are applied, "
                     "but tunnel changes are not followed</span>")
    st = " &middot; ".join(parts)
    # --- rules
    rows = ""
    for rep in rules:
        r = rep["rule"]
        line = "%s via %s%s metric %d%s" % (r["list"], r["via"], ("@" + r["site"]) if r["site"] else "", r["metric"],
