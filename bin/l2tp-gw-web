    if running:
        cmsg = "<span class='rtst warn'>Downloading the registry files now... reload in a minute.</span>"
    elif cst.get("message"):
        cmsg = "<span class='rtst %s'>%s</span> &middot; checked %s" % ("ok" if cst.get("ok") else "bad", e(cst["message"]), rt_ago(cst.get("attempt", cst.get("ts", 0))))
    held_btn = ""
    if cst.get("held"):
        held_btn = ("<form method=post action=/routes/country/accept style='display:inline'><input type=hidden name=csrf value='%s'>"
                    "<button class=btn>Accept the changed size</button></form> " % csrf)
    country_html = (
        "<div class=card><h2>Country data</h2><p class=hint>A line <code>@country IR</code> in a list means every address block the registries "
        "delegated to that country. It is downloaded from the five public registry files, refreshed every week, and the last good copy is always kept. "
        "It follows the registration country, not where the address is really used.</p>%s%s"
        "<form method=post action=/routes/country/update style='display:inline'><input type=hidden name=csrf value='%s'>"
        "<button class='btn'%s>Update now</button></form> %s<div style='margin-top:8px'>%s</div></div>"
        % (("<table class=rt>%s</table>" % crow) if crow else "<p class=none>No list uses a country yet. Add a line like <code>@country IR</code> to a list.</p>", "",
           csrf, " disabled" if running or not used else "", held_btn, cmsg))
    # --- protected
    _, protects, _ = parse_rules_text(rt_read_rules_text())
    prows = "".join("<tr><td class=mono>%s</td><td>%s</td></tr>" % (e(str(n)), e(r)) for n, r in
                    sorted(res["protected"], key=lambda x: (x[1], str(x[0]))))
    prot_html = ("<details><summary>Protected addresses (%d)</summary><div class=card style='margin-top:10px'>"
                 "<p class=hint>These are cut out of every list, so a list can never cut you off from this server or break a tunnel. "
                 "Machines that are logged in right now are included automatically.</p>"
                 "<table class='rt'>%s</table>"
