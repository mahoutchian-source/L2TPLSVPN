function speed(){fetch('/speed',{credentials:'same-origin'}).then(function(r){if(r.status!==200)throw 0;return r.json()}).then(function(j){
 if(PREV&&j.t>PREV.t){var dt=j.t-PREV.t;for(var n in j.links){var a=PREV.links[n],b=j.links[n];
  if(a&&b&&b.tx>=a.tx&&b.rx>=a.rx)SP[n]='&darr; '+fmtbps((b.tx-a.tx)*8/dt)+' &nbsp;&uarr; '+fmtbps((b.rx-a.rx)*8/dt)}}
 PREV=j;applySpeed()}).catch(function(){})}
if(document.getElementById('live'))setInterval(speed,2000);
function toggleTheme(){var d=document.documentElement,c=d.getAttribute('data-theme');
 if(!c)c=(window.matchMedia&&matchMedia('(prefers-color-scheme: light)').matches)?'light':'dark';
 var n=c==='dark'?'light':'dark';d.setAttribute('data-theme',n);try{localStorage.setItem('theme',n)}catch(e){}}
function showpw(id,b){var i=document.getElementById(id);i.type=i.type==='password'?'text':'password';b.textContent=i.type==='password'?'Show':'Hide'}
"""


def csrf_of(sid):
    return SESSIONS[sid]["csrf"]


NAV = [("/", "Dashboard"), ("/sites", "Sites"), ("/dialin", "Dial-in"), ("/traffic", "Traffic"), ("/events", "Events"), ("/routes", "Routes"), ("/check", "Health check"), ("/backup", "Backup"), ("/settings", "Settings")]


THEME_BOOT = ("try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}")


def page(title, body, sid=None, msg=None, active="/sites"):
    e = html.escape
    m = ('<div class="msg %s">%s</div>' % ("ok" if msg[0] else "err", e(msg[1]))) if msg else ""
    back = "<p class=backrow><a class='btn sm' href=/>&larr; Dashboard</a></p>" if sid and active != "/" else ""
    head = ("<!doctype html><html lang=en><head><meta charset=utf-8>"
            "<meta name=viewport content='width=device-width,initial-scale=1'><title>%s</title>"
            "<script>%s</script><style>%s</style></head><body>" % (e(title), THEME_BOOT, CSS))
    tail = "<div class=toast id=toast></div><script>%s</script></body></html>" % JS
    if not sid:                      # log-in page: no side bar
        return (head + "<main class=solo>%s%s</main>" % (m, body) + tail).encode()
    nav = "".join("<a href='%s'%s>%s</a>" % (u, " class=on" if u == active else "", n) for u, n in NAV)
    clock = ("<div class=topbar><span id=clk class=mono data-ms='%d' data-tz='%s'></span></div>"
             % (int(time.time() * 1000), e(read_general()["timezone"])))
    side = ("<aside class=side><a class=brand href=/>%s</a><div class=nav>%s</div>"
            "<div class=sidefoot><form method=post action=/logout><input type=hidden name=csrf value='%s'>"
            "<button class='btn link'>Log out</button></form>"
            "<button type=button class='btn link' onclick=\"toggleTheme()\" title='Dark or light'>Theme</button></div></aside>"
            % (e(read_general()["brand"]), nav, e(csrf_of(sid))))
    return (head + "<div class=shell>%s<main>%s%s%s%s</main></div>" % (side, clock, back, m, body) + tail).encode()


def login_page(msg=None):
    return page("Log in", '<div class=brand style="justify-content:center;font-size:20px;padding:0 0 20px">%s</div>' % html.escape(read_general()["brand"]) +
                '<form class="form login" method="post" action="/login"><label for=pw>Password</label>'
                '<input type=password id=pw name=password autofocus autocomplete=current-password>'
                '<p><button class="btn pri" style="width:100%">Log in</button></p></form>', None, msg)


def same_secret(a, b):
    """Compare two secrets as bytes: compare_digest raises TypeError on non-ASCII text (e.g. a Persian password)."""
    return secrets.compare_digest(str(a).encode("utf-8"), str(b).encode("utf-8"))


def site_rows(ppp, ipsec):
    e = html.escape
    sites = [x for x in load_sites() if not is_server(x)]
    rows, up_n = "", 0
    st, gen = read_state(), read_general()
    tz = get_tz(gen["timezone"])
    for s in sites:
        n = s["name"]
        # own IKE SA line, or own child SA line (sites with the same MikroTik address share one IKE SA)
        ipsec_up = bool(re.search(r"(^|\s)%s(\[\d+\]: ESTABLISHED|\{\d+\}:\s+INSTALLED)" % re.escape(n), ipsec or ""))
        off = s.get("disabled") == "yes"
        ppp_up = n in ppp and not off
        if ppp_up:
            up_n += 1
        ipmode = s.get("ipsec_mode") or "heal"
        if off:
            cls, txt = "off", "Switched off"
        elif ppp_up and ipsec is not None and not ipsec_up:
            # PPP without an IPsec SA = plain L2TP (a MikroTik with use-ipsec=yes accepts it): not encrypted.
            # With ipsec_mode = allow the owner accepted that, so it is shown in amber instead of red.
            if ipmode == "allow":
                cls, txt = "noipsecok", "Connected, no IPsec (allowed)"
            else:
                cls, txt = "noipsec", "Connected WITHOUT IPsec"
        elif ppp_up:
            cls, txt = "up", "Connected"
        else:
            cls, txt = ("half", "IPsec up, waiting for PPP") if ipsec_up else ("down", "Down")
        addr = e(ppp.get(n, "").replace(" peer ", " → ").replace("/32", "")) if ppp_up else ""
        # what is really there (not what is configured): IPsec SA and PPP state, and the encryption in use
        if off:
            reason = ""
        else:
            ips = "unknown" if ipsec is None else ("up" if ipsec_up else "down")
            reason = "IPsec %s &middot; PPP %s" % (ips, "up" if ppp_up else "down")
            if ppp_up:
                if ipsec_up:
                    enc = "IPsec" + (" + MPPE" if s["mppe"] == "yes" else "")
                elif s["mppe"] == "yes":
                    enc = "MPPE only (no IPsec)"
                elif ipsec is None:
                    enc = "unknown"
                else:
                    enc = "none"
                reason += " &middot; Encryption: %s" % e(enc)
        chips = ""
        for r in [x.strip() for x in s["routes"].split(",") if x.strip()]:
            chips += "<span class='chip mono'>%s</span>" % e(r)
        if not chips:
            chips = "<span class=none>No routes</span>"
        tags = ""
        if s["nat"] == "yes":
            tags += "<span class='chip tag'>NAT</span>"
        if s["mppe"] == "yes":
            tags += "<span class='chip tag'>MPPE</span>"
        if ipmode != "heal":
            tags += "<span class='chip tag'>IPsec: %s</span>" % e(ipmode)
        for k, label in (("internet", "no internet"), ("sites", "no other sites"), ("clients", "no dial-in clients")):
            if s.get("access_" + k) == "no":
                tags += "<span class='chip tag'>%s</span>" % label
        extra = ("<div class='speed mono' data-speed='%s'>&darr; - &nbsp;&uarr; -</div>" % e(n)) if ppp_up else ""
        extra += quota_html(s, st, gen["unit"]) + auto_text(s, st, tz)
        rows += ("<div class=row><div class='rail %s'></div>"
                 "<div><div class=name>%s</div><div class='host mono'>%s</div></div>"
                 "<div><div class='state %s'>%s</div><div class='addr mono'>%s</div><div class='reason'>%s</div>@@EXTRA@@</div>"
                 "<div class=chips>%s%s</div>"
                 "<div class=acts><button class='btn sm' onclick=\"ping('%s',this)\"%s>Ping</button>"
                 "<form method=post action=/reconnect style='display:inline' onsubmit=\"return confirm('Reconnect %s? Only this tunnel is interrupted.')\">"
                 "<input type=hidden name=csrf value='@@CSRF@@'><input type=hidden name=name value='%s'><button class='btn sm'>Reconnect</button></form>"
                 "<form method=post action=/toggle%s><input type=hidden name=csrf value='@@CSRF@@'><input type=hidden name=name value='%s'>"
                 "<button class='btn sm'>%s</button></form>"
                 "<a class='btn sm' href='/logs?name=%s'>Logs</a>"
                 "<a class='btn sm' href='/edit?name=%s'>Edit</a>"
                 "<form method=post action=/delete onsubmit=\"return confirm('Delete site %s? Its tunnel will be removed.')\">"
                 "<input type=hidden name=csrf value='@@CSRF@@'><input type=hidden name=name value='%s'>"
                 "<button class='btn sm del'>Delete</button></form></div></div>"
                 % (cls, e(n), e(s.get("host", "")), cls, txt, addr, reason, chips, tags, e(n),
                    "" if ppp_up else " disabled title='Tunnel is not connected'", e(n), e(n),
                    "" if off else " onsubmit=\"return confirm('Switch off %s? Its tunnel is closed. Other tunnels are not touched.')\"" % e(n),
                    e(n), "Switch on" if off else "Switch off", e(n), e(n), e(n), e(n))
                 ).replace("@@EXTRA@@", extra)
    return sites, up_n, rows


def live_html(sid):
    ppp, ipsec = live_status()
    sites, up_n, rows = site_rows(ppp, ipsec)
    if not sites:
        body = ("<div class=list><div class=empty><p><b>No sites yet</b></p>"
                "<p>Add the first MikroTik router this server should connect to.</p>"
                "<a class='btn pri' href=/edit>Add site</a></div></div>")
        summ = "No sites yet"
    else:
        body = "<div class=list>%s</div>" % rows.replace("@@CSRF@@", html.escape(csrf_of(sid)))
        n_on = sum(1 for x in sites if x.get("disabled") != "yes")
        summ = "%d of %d tunnels connected" % (up_n, n_on) + ((" &middot; %d switched off" % (len(sites) - n_on)) if n_on != len(sites) else "")
    return ('<div class=bar><div><h1>Sites</h1><div class=sum>%s</div></div>'
            '<a class="btn pri" href=/edit>Add site</a></div>%s' % (summ, body))


def main_page(sid, msg=None):
    _, st = run([GW, "status"], 30)
    body = (live_html_wrap(sid) +
            "<p class=note>Saving or deleting re-applies the whole config and restarts the VPN services. "
            "All tunnels reconnect within about a minute. This page refreshes every 10 seconds.</p>"
            "<details><summary>Server status (routes, NAT, interfaces)</summary><pre id=raw>%s</pre></details>"
            "<p class=foot>l2tp-gw-web %s &middot; %s</p>"
            % (html.escape(st), VERSION, html.escape(run([GW, "version"], 10)[1])))
    return page("Sites", body, sid, msg)


def live_html_wrap(sid):
    return "<div id=live>%s</div>" % live_html(sid)


def options(pairs, current):
    return "".join("<option value='%s'%s>%s</option>" % (html.escape(v), " selected" if v == current else "", html.escape(t))
                   for v, t in pairs)


def edit_page(sid, name=None, msg=None, vals=None):
    e = html.escape
    s = vals or {}
    editing = False
    if name and not vals:
        for x in load_sites():
            if x["name"] == name and not is_server(x):
                s = x; editing = True
    elif vals and vals.get("orig"):
        editing = True
    def v(k): return e(s.get(k, ""))
    def acc(k, title, hint):      # a ticked box = allowed (the default; only "no" in the file means blocked)
        return ("<label class=check><input type=checkbox name=%s value=yes %s><span>%s<small>%s</small></span></label>"
                % (k, "" if s.get("access_" + k[4:]) == "no" else "checked", title, hint))
    acc_html = ("<fieldset><legend>What this site may reach</legend>"
                "<p class=hint>Applied at once, only for this site; the tunnels are not restarted. Un-tick to block (both directions).</p>"
                + acc("acc_internet", "The internet through this server", "Traffic that arrives from this site and leaves the server toward the internet.")
                + acc("acc_sites", "The other outgoing sites", "No traffic between this site and the other tunnels this server dials.")
                + acc("acc_clients", "The dial-in clients", "No traffic between this site and the routers that dial in.")
                + "</fieldset>")
    keep = "Leave empty to keep the current one." if editing else ""
    ph = " placeholder='unchanged'" if editing else ""
    body = ("<div class=bar><h1>%s</h1></div>"
            "<form class=form method=post action=/save autocomplete=off>"
            "<input type=hidden name=csrf value='%s'><input type=hidden name=orig value='%s'>"
            "<fieldset><legend>Router</legend>"
            "<label for=name>Site name<span class=hint>Lowercase letters, numbers and -, up to 11 characters. Used for the interface name ppp-NAME.</span></label>"
            "<input type=text id=name name=name value='%s' required maxlength=11 pattern='[a-z0-9][a-z0-9\\-]{0,10}'>"
            "<label for=host>MikroTik address<span class=hint>Public IP or DDNS hostname.</span></label>"
            "<input type=text id=host name=host value='%s' required class=mono></fieldset>"
            "<fieldset><legend>Credentials</legend>"
            "<label for=psk>IPsec secret<span class=hint>%s</span></label>"
            "<div class=pw><input type=password id=psk name=psk%s><button type=button class='btn' onclick=\"showpw('psk',this)\">Show</button></div>"
            "<label for=user>PPP username</label><input type=text id=user name=user value='%s' required>"
            "<label for=ppass>PPP password<span class=hint>%s</span></label>"
            "<div class=pw><input type=password id=ppass name=pass%s><button type=button class='btn' onclick=\"showpw('ppass',this)\">Show</button></div></fieldset>"
            "<fieldset><legend>Options</legend>"
            "<label class=check><input type=checkbox name=mppe value=yes %s><span>PPP-level encryption (MPPE), not IPsec"
            "<small>Makes this server demand MPPE inside PPP. It does NOT force IPsec: the router shows MPPE when this is on and IPsec "
            "(cbc(aes)) when IPsec is carrying the tunnel. Turn on only if the router requires MPPE. For real encryption use the IPsec setting below.</small></span></label>"
            "<label class=check><input type=checkbox name=nat value=yes %s><span>NAT traffic that leaves through this tunnel"
            "<small>Packets sent into this tunnel use this server's tunnel address as source.</small></span></label></fieldset>"
            "<fieldset><legend>Routes</legend>"
            "<label for=routes>Networks behind this router<span class=hint>Separate with commas. Metric is optional (default 100, lower wins). "
            "Added when the tunnel comes up, removed when it goes down.</span></label>"
            "<input type=text id=routes name=routes value='%s' class=mono placeholder='172.16.0.0/24 metric 2, 10.5.0.0/16'></fieldset>%s"
            "<fieldset><legend>IPsec</legend>"
            "<p class=hint>What to do when the tunnel is up but has no IPsec (plain L2TP, not encrypted). "
            "A MikroTik with use-ipsec=yes accepts that; use-ipsec=require on the router refuses it.</p>"
            "<label for=ipm>If IPsec is missing</label><select id=ipm name=ipsec_mode>%s</select>"
            "<label for=lcp>Detect a tunnel that died silently<span class=hint>This server sends a PPP keep-alive every 30 s and redials after 6 missed answers (3 min).</span></label>"
