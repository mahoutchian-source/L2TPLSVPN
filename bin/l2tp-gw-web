#!/usr/bin/env python3
# l2tp-gw-web - small web page to manage the sites of l2tp-gw
#
#   l2tp-gw-web install     create password + systemd service, start it
#   l2tp-gw-web setpass     change the login password
#   l2tp-gw-web run         run in foreground (the service does this)
#   l2tp-gw-web collect     traffic collector in foreground (the l2tp-gw-collect service does this)
#
# Settings: /etc/l2tp-gw/web.conf   (password, bind, port)
# Pages: sites, health check, per-site logs, backup/restore, alerts (Telegram) settings
# It only edits /etc/l2tp-gw/sites.conf and then runs "l2tp-gw apply".
import fcntl, html, http.server, ipaddress, json, os, re, secrets, signal, socket, socketserver, string, subprocess, sys, threading, time, traceback
from datetime import datetime, timedelta, timezone
from zoneinfo import ZoneInfo
from urllib.parse import parse_qs, urlparse

VERSION = "1.0.2"
CONF_DIR = os.environ.get("CONF_DIR", "/etc/l2tp-gw")
SITES = os.path.join(CONF_DIR, "sites.conf")
WEB_CONF = os.path.join(CONF_DIR, "web.conf")
NOTIFY_CONF = os.path.join(CONF_DIR, "notify.conf")
GW = os.environ.get("L2TP_GW", "/usr/local/bin/l2tp-gw")
UNIT = os.environ.get("UNIT_FILE", "/etc/systemd/system/l2tp-gw-web.service")
KEYS = ["host", "psk", "user", "pass", "mppe", "nat", "routes", "reconnect_every", "reconnect_at", "reconnect_window",
        "quota_gb", "quota_period", "quota_dir", "quota_warn", "ipsec_mode", "mode", "ip", "disabled",
        "access_internet", "access_clients", "access_sites", "lcp_echo"]    # (access_*: "no" = blocked; empty = allowed, not written)
OPTIONAL = set(KEYS[6:])      # written only when not empty
SERVER_SKIP = ("host", "psk", "mppe")    # a dial-in (mode = server) site has no address to dial and uses the shared IPsec secret
DIALIN_CONF = os.path.join(CONF_DIR, "dialin.conf")
LOCK = threading.Lock()
SESSIONS = {}          # session id -> {"csrf": token, "ts": last use}
FLASH = {}             # session id -> (ok, message) shown once
SESSION_TTL = 12 * 3600


# ---------- settings ----------
def read_web_conf():
    c = {"password": "", "bind": "127.0.0.1", "port": "8080", "tls": "off"}
    try:
        for line in open(WEB_CONF):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return c


def write_web_conf(c):
    os.makedirs(CONF_DIR, exist_ok=True)
    fd = os.open(WEB_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("# l2tp-gw-web settings. Restart after changes: systemctl restart l2tp-gw-web\n")
        f.write("# bind = 127.0.0.1 : only this server itself (open it with an SSH tunnel)\n")
        f.write("# tls = on : HTTPS with a self-signed certificate (the browser warns once). Then open https://ADDRESS:PORT\n")
        for k in ("password", "bind", "port", "tls"):
            f.write("%s = %s\n" % (k, c[k]))
    os.chmod(WEB_CONF, 0o600)


# ---------- sites file ----------
def load_sites():
    sites, cur = [], None
    try:
        lines = open(SITES).read().splitlines()
    except FileNotFoundError:
        return sites
    for line in lines:
        line = line.strip()
        if not line or line[0] in "#;":
            continue
        if line.startswith("[") and line.endswith("]"):
            cur = {"name": line[1:-1]}
            sites.append(cur)
        elif "=" in line and cur is not None:
            k, v = line.split("=", 1)
            cur[k.strip()] = v.strip()
    for s in sites:
        s.setdefault("mppe", "no"); s.setdefault("nat", "no"); s.setdefault("routes", "")
        s.setdefault("mode", "client")
    return sites


def is_server(s):
    return s.get("mode") == "server"


def render_sites(sites):
    out = []
    for s in sites:
        out.append("[%s]" % s["name"])
        for k in KEYS:
            v = s.get(k, "")
            if k in OPTIONAL and not v:
                continue
            if k == "mode" and v == "client":
                continue
            if is_server(s) and k in SERVER_SKIP:
                continue
            out.append("%s = %s" % (k, v))
        out.append("")
    return "\n".join(out) + "\n"


def run(cmd, timeout=180):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except Exception as e:
        return 1, str(e)


def save_all(sites, cmd="apply"):
    """validate the new list, write it, apply. returns (ok, message).
    cmd = "dialin-sync" when only dial-in clients changed: nothing is restarted, other tunnels are not touched"""
    tmp = SITES + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(render_sites(sites))
    rc, out = run([GW, "validate", tmp])
    if rc != 0:
        os.remove(tmp)
        return False, out
    bak = SITES + ".bak"
    if os.path.exists(SITES):
        with open(SITES) as a, os.fdopen(os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as b:
            b.write(a.read())
    os.replace(tmp, SITES)
    os.chmod(SITES, 0o600)
    rc, out = run([GW, cmd])
    if rc != 0:
        if os.path.exists(bak):
            os.replace(bak, SITES)
            run([GW, cmd])
        return False, "Apply failed, old settings restored.\n" + out
    return True, out


# ---------- alert settings (notify.conf is also read by l2tp-gw watch) ----------
def read_notify():
    c = {"telegram_token": "", "telegram_chat": "", "down_after_min": "5", "server_name": "", "dns_flush_min": "30", "tg_send_config": "no"}
    try:
        for line in open(NOTIFY_CONF):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                if k.strip() in c:
                    c[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return c


def write_notify(c):
    os.makedirs(CONF_DIR, exist_ok=True)
    fd = os.open(NOTIFY_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("# alert settings, edited by l2tp-gw-web or by hand\n")
        for k in ("telegram_token", "telegram_chat", "down_after_min", "server_name", "dns_flush_min", "tg_send_config"):
            f.write("%s = %s\n" % (k, c[k]))
    os.chmod(NOTIFY_CONF, 0o600)


def check_notify(c):
    """returns an error text, or None when the values look right"""
    if c["telegram_token"] and not re.fullmatch(r"[0-9]+:[A-Za-z0-9_-]+", c["telegram_token"]):
        return "The bot token looks wrong. It has the form 123456789:ABC-def..."
    if c["telegram_chat"] and not re.fullmatch(r"-?[0-9]+|@[A-Za-z0-9_]+", c["telegram_chat"]):
        return "The chat ID must be a number (it can start with -) or @channelname."
    if not re.fullmatch(r"[0-9]{1,4}", c["down_after_min"]) or not 1 <= int(c["down_after_min"]) <= 1440:
        return "Alert after (minutes) must be a number from 1 to 1440."
    if not re.fullmatch(r"[0-9]{1,4}", c["dns_flush_min"]) or int(c["dns_flush_min"]) > 1440:
        return "DNS cache flush (minutes) must be a number from 0 to 1440 (0 = never)."
    if c["tg_send_config"] not in ("yes", "no"):
        return "Unknown value for sending the settings file."
    if not re.fullmatch(r"[A-Za-z0-9 ._-]{0,40}", c["server_name"]):
        return "Server name may only contain letters, numbers, space, dot, dash and underscore."
    return None


# ---------- general settings (time zone, unit) ----------
GENERAL_CONF = os.path.join(CONF_DIR, "general.conf")
STATE_DIR = os.environ.get("STATE_DIR", "/var/lib/l2tp-gw")
TRAFFIC_DIR = os.path.join(STATE_DIR, "traffic")
SYS_NET = os.environ.get("SYS_NET", "/sys/class/net")     # tests point this to a fake folder
TZ_CHOICES = [("UTC", "UTC"), ("Asia/Tehran", "Tehran"), ("America/Toronto", "Toronto"), ("Europe/London", "London"),
              ("Europe/Berlin", "Berlin"), ("Asia/Dubai", "Dubai"), ("America/New_York", "New York"),
              ("America/Los_Angeles", "Los Angeles")]
UNITS = {"GB": 1000 ** 3, "GiB": 1024 ** 3}               # decimal like providers, or binary like MikroTik


def read_general():
    c = {"timezone": "UTC", "unit": "GB", "brand": "L2TP gateway"}
    try:
        for line in open(GENERAL_CONF):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                if k.strip() in c:
                    c[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    if c["unit"] not in UNITS:
        c["unit"] = "GB"
    return c


def write_general(c):
    os.makedirs(CONF_DIR, exist_ok=True)
    with open(GENERAL_CONF, "w") as f:
        f.write("# time zone decides where a day starts (usage reports, daily reconnect time)\n")
        f.write("timezone = %s\n" % c["timezone"])
        f.write("unit = %s\n" % c["unit"])
        f.write("brand = %s\n" % c.get("brand", "L2TP gateway"))


def get_tz(name):
    try:
        return ZoneInfo(name)
    except Exception:
        return timezone.utc


def valid_tz(name):
    try:
        ZoneInfo(name)
        return bool(re.fullmatch(r"[A-Za-z0-9_+./-]{1,64}", name))
    except Exception:
        return False


def fmt_bytes(n, unit="GB"):
    base = 1000.0 if unit == "GB" else 1024.0
    names = ["B", "KB", "MB", "GB", "TB"] if unit == "GB" else ["B", "KiB", "MiB", "GiB", "TiB"]
    v = float(n)
    i = 0
    while v >= base and i < len(names) - 1:
        v /= base
        i += 1
    return ("%d %s" % (v, names[i])) if i == 0 else ("%.2f %s" % (v, names[i]))


# ---------- traffic collector ----------
# One small service (l2tp-gw-collect) that every few seconds reads the byte counters of every
# ppp-NAME interface and keeps, on disk (so a reboot or reconnect loses nothing):
#   traffic/daily/NAME.csv   date,download_bytes,upload_bytes   (one line per day, kept forever)
#   traffic/state.json       last counters, quota counters, auto-reconnect bookkeeping
# Names: DOWNLOAD = bytes we SEND to the MikroTik (kernel tx_bytes), UPLOAD = bytes we RECEIVE (rx_bytes).
# It also does the scheduled auto reconnects and the limit (quota) warnings.
SAMPLE_EVERY = 5           # seconds between counter reads
FLUSH_EVERY = 15           # seconds between writes to disk (only when something changed)
AUTO_MIN_GAP = 1800        # same site: at least 30 min between two automatic reconnects
AUTO_GLOBAL_GAP = 180      # any two sites: at least 3 min apart, so tunnels are not all down together


def atomic_write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def read_iface(ifc):
    """(ifindex, rx_bytes, tx_bytes) of an interface, or None if it does not exist"""
    base = os.path.join(SYS_NET, ifc)
    try:
        with open(base + "/ifindex") as f:
            idx = int(f.read())
        with open(base + "/statistics/rx_bytes") as f:
            rx = int(f.read())
        with open(base + "/statistics/tx_bytes") as f:
            tx = int(f.read())
        return idx, rx, tx
    except (OSError, ValueError):
        return None


def ppp_peers():
    """{peer address: interface} of every ppp interface right now (dial-in clients have a fixed peer address)"""
    _, out = run(["ip", "-o", "-4", "addr", "show"], 10)
    m = {}
    for line in out.splitlines():
        x = re.match(r"^\d+:\s+(ppp\S*)\s+inet\s+\S+\s+peer\s+(\d+\.\d+\.\d+\.\d+)", line)
        if x:
            m[x.group(2)] = x.group(1)
    return m


def site_dev(s, peers):
    """interface of a site: ppp-NAME for a client site, the ppp interface with the fixed peer address for a dial-in site"""
    if is_server(s):
        return peers.get(s.get("ip", ""))
    return "ppp-" + s["name"]


def cycle_key(period, local):
    if period == "week":
        return local.strftime("%G-W%V")          # ISO week, Monday first
    if period == "month":
        return local.strftime("%Y-%m")
    return local.date().isoformat()


def in_window(local, window):
    """window = 'HH:MM-HH:MM' (may pass midnight); empty = always"""
    if not window:
        return True
    a, b = window.split("-")
    ma = int(a[:2]) * 60 + int(a[3:])
    mb = int(b[:2]) * 60 + int(b[3:])
    m = local.hour * 60 + local.minute
    return (ma <= m < mb) if ma <= mb else (m >= ma or m < mb)


def read_state():
    try:
        with open(os.path.join(TRAFFIC_DIR, "state.json")) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    for k in ("links", "quota", "auto"):
        st.setdefault(k, {})
    st.setdefault("global", {})
    return st


def read_daily(site, path=None):
    """{'2026-10-21': [download, upload], ...}   (path = an archived csv instead of the live one)"""
    out = {}
    try:
        with open(path or os.path.join(TRAFFIC_DIR, "daily", site + ".csv")) as f:
            for line in f:
                p = line.strip().split(",")
                if len(p) == 3 and re.fullmatch(r"\d{4}-\d{2}-\d{2}", p[0]):
                    out[p[0]] = [int(p[1]), int(p[2])]
    except (OSError, ValueError):
        pass
    return out


def quota_used(q, direction):
    return q["down"] if direction == "download" else q["up"] if direction == "upload" else q["down"] + q["up"]


# ---- event log: one JSON object per line in STATE_DIR/events.log (written by the collector and by the web page) ----
EVENTS_FILE = os.path.join(STATE_DIR, "events.log")
EVENTS_MAX_LINES = 1000          # the collector trims the file back to this many lines when it gets larger than 2x


def add_event(kind, text, ts=None):
    """kind: up | down | warn | info. Never raises (a log must not break the program)."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        line = json.dumps({"t": int(ts or time.time()), "k": kind, "m": text}, ensure_ascii=False)
        with open(EVENTS_FILE, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def read_events(limit=300):
    """newest first"""
    try:
        with open(EVENTS_FILE) as f:
            lines = f.readlines()[-limit:]
    except OSError:
        return []
    out = []
    for ln in reversed(lines):
        try:
            d = json.loads(ln)
            out.append((int(d["t"]), str(d["k"]), str(d["m"])))
        except (ValueError, KeyError, TypeError):
            continue
    return out


def trim_events():
    try:
        with open(EVENTS_FILE) as f:
            lines = f.readlines()
        if len(lines) > 2 * EVENTS_MAX_LINES:
            atomic_write(EVENTS_FILE, "".join(lines[-EVENTS_MAX_LINES:]))
    except OSError:
        pass


# memory warning levels (this server has 412 MB): warn when available RAM is below 40 MB or swap is over 60% used,
# and say "back to normal" only above 64 MB and under 40% swap (the gap stops a flapping message)
MEM_LOW_MB, MEM_OK_MB, SWAP_LOW_PCT, SWAP_OK_PCT = 40, 64, 60, 40


def mem_numbers():
    """-> (available MB, swap used percent) or None"""
    try:
        m = {}
        for line in open(os.environ.get("PROC_DIR", "/proc") + "/meminfo"):
            k, v = line.split(":", 1)
            m[k] = int(v.split()[0])
        st = m.get("SwapTotal", 0)
        return m["MemAvailable"] / 1024.0, (100.0 * (st - m.get("SwapFree", 0)) / st) if st else 0.0
    except (OSError, ValueError, KeyError):
        return None


class Collector:
    def __init__(self):
        self.up_prev = {}          # site -> was the tunnel up at the last look (for the event log)
        self.mem_low = False
        os.makedirs(os.path.join(TRAFFIC_DIR, "daily"), exist_ok=True)
        self.state = read_state()
        self.daily = {}
        self.dirty = False
        self.dirty_daily = set()
        self.first_pass = True
        self.last_flush = 0
        self.busy = set()          # sites with a reconnect running right now
        self.last_beat = 0
        self.routes = RouteSync()  # address lists / route table (see "route manager")
        self.nic = NicStats()      # traffic of the main network card (hour and day buckets)
        self.last_nic_flush = 0

    # --- storage
    def get_daily(self, site):
        if site not in self.daily:
            self.daily[site] = read_daily(site)
        return self.daily[site]

    def flush(self, now):
        for n in sorted(self.dirty_daily):
            rows = self.daily.get(n, {})
            atomic_write(os.path.join(TRAFFIC_DIR, "daily", n + ".csv"),
                         "".join("%s,%d,%d\n" % (d, v[0], v[1]) for d, v in sorted(rows.items())))
        atomic_write(os.path.join(TRAFFIC_DIR, "state.json"), json.dumps(self.state, indent=1))
        self.nic.flush()
        trim_events()
        self.dirty_daily.clear()
        self.dirty = False
        self.last_flush = now

    # --- counters
    def quota_for(self, site, period, local, now):
        key = cycle_key(period, local)
        q = self.state["quota"].get(site)
        if q is None or q.get("cycle") != key or q.get("period") != period:
            q = {"cycle": key, "period": period, "down": 0, "up": 0, "reset_at": now, "warned": False, "over": False}
            self.state["quota"][site] = q
            self.dirty = True
        return q

    def sample(self, s, now, local, peers=None):
        n = s["name"]
        period = s.get("quota_period") or "day"
        q = self.quota_for(n, period, local, now)
        dev = site_dev(s, peers if peers is not None else (ppp_peers() if is_server(s) else {}))
        cur = read_iface(dev) if dev else None
        was = self.up_prev.get(n)
        if was is not None and was != (cur is not None) and not (cur is None and s.get("disabled") == "yes"):
            word = ("connected" if cur is not None else "disconnected")
            add_event("up" if cur is not None else "down", "%s %s %s" % ("Dial-in client" if is_server(s) else "Tunnel", n, word))
        self.up_prev[n] = cur is not None
        link = self.state["links"].get(n)
        if cur is None:
            # tunnel is down: forget the counters, a new interface starts again from zero
            if link is not None:
                del self.state["links"][n]
                self.dirty = True
            return
        idx, rx, tx = cur
        if link is None and self.first_pass:
            # collector just started and knows nothing about this interface: start counting from now
            self.state["links"][n] = {"ifindex": idx, "rx": rx, "tx": tx, "since": now}
            self.dirty = True
            return
        if link is None or link["ifindex"] != idx:
            d_rx, d_tx, since = rx, tx, now          # a new interface: everything on it is new traffic
        elif rx < link["rx"] or tx < link["tx"]:
            d_rx, d_tx, since = rx, tx, link["since"]  # counters were reset
        else:
            d_rx, d_tx, since = rx - link["rx"], tx - link["tx"], link["since"]
        if link is None or (link["ifindex"], link["rx"], link["tx"], link["since"]) != (idx, rx, tx, since):
            self.state["links"][n] = {"ifindex": idx, "rx": rx, "tx": tx, "since": since}
            self.dirty = True
        if d_rx or d_tx:
            row = self.get_daily(n).setdefault(local.date().isoformat(), [0, 0])
            row[0] += d_tx            # download = sent to the MikroTik
            row[1] += d_rx            # upload   = received from the MikroTik
            q["down"] += d_tx
            q["up"] += d_rx
            self.dirty_daily.add(n)
            self.dirty = True

    def archive_orphans(self, names, now):
        """a deleted site/client must not leave its numbers behind: a new site with the same name would add to them.
        Their daily files go to an archive folder (kept, viewable on the Traffic > Archive page)."""
        d = os.path.join(TRAFFIC_DIR, "daily")
        try:
            gone = [fn[:-4] for fn in os.listdir(d) if fn.endswith(".csv") and fn[:-4] not in names]
        except OSError:
            return
        if not gone:
            return
        arch = os.path.join(TRAFFIC_DIR, "archive-" + time.strftime("%Y%m%d-%H%M%S"))
        try:
            os.makedirs(arch, exist_ok=True)
            for n in gone:
                os.replace(os.path.join(d, n + ".csv"), os.path.join(arch, n + ".csv"))
                self.daily.pop(n, None)
                self.dirty_daily.discard(n)
                add_event("info", "Reports of removed site %s archived" % n)
        except OSError:
            traceback.print_exc()

    def apply_site_reset(self, name, now):
        """one site: its daily reports go to an archive folder (not deleted) and its limit counter starts again from zero"""
        src = os.path.join(TRAFFIC_DIR, "daily", name + ".csv")
        try:
            if os.path.exists(src):
                arch = os.path.join(TRAFFIC_DIR, "archive-" + time.strftime("%Y%m%d-%H%M%S"))
                os.makedirs(arch, exist_ok=True)
                os.replace(src, os.path.join(arch, name + ".csv"))
        except OSError:
            traceback.print_exc()
        self.daily.pop(name, None)
        self.dirty_daily.discard(name)
        add_event("info", "All numbers of %s were reset (old reports archived)" % name)
        q = self.state["quota"].get(name)
        if q:
            q.update({"down": 0, "up": 0, "reset_at": now, "warned": False, "over": False})
        self.dirty = True

    def apply_resets(self, sites, now):
        for s in sites:
            flag_all = os.path.join(TRAFFIC_DIR, "reset-site." + s["name"])
            if os.path.exists(flag_all):
                self.apply_site_reset(s["name"], now)
                try:
                    os.remove(flag_all)
                except OSError:
                    pass
            flag = os.path.join(TRAFFIC_DIR, "reset." + s["name"])
            if os.path.exists(flag):
                q = self.state["quota"].get(s["name"])
                if q:
                    q.update({"down": 0, "up": 0, "reset_at": now, "warned": False, "over": False})
                    self.dirty = True
                try:
                    os.remove(flag)
                except OSError:
                    pass

    def apply_reset_all(self, now):
        """Settings > Reset all counters: daily reports go to an archive folder (not deleted), limit counters and
        the network card history start again from zero"""
        if not os.path.exists(RESET_FLAG):
            return
        arch = os.path.join(TRAFFIC_DIR, "archive-" + time.strftime("%Y%m%d-%H%M%S"))
        daily = os.path.join(TRAFFIC_DIR, "daily")
        try:
            names = [n for n in os.listdir(daily) if n.endswith(".csv")]
            if names:
                os.makedirs(arch, exist_ok=True)
                for n in names:
                    os.replace(os.path.join(daily, n), os.path.join(arch, n))
        except OSError:
            traceback.print_exc()
        self.daily.clear()
        self.dirty_daily.clear()
        add_event("info", "All counters were reset (reports archived)")
        for q in self.state["quota"].values():
            q.update({"down": 0, "up": 0, "reset_at": now, "warned": False, "over": False})
        self.nic.reset(now)
        self.nic.flush()
        self.dirty = True
        try:
            os.remove(RESET_FLAG)
        except OSError:
            pass

    def check_quota(self, sites, unit, now):
        for s in sites:
            if not s.get("quota_gb"):
                continue
            q = self.state["quota"].get(s["name"])
            if not q:
                continue
            limit = float(s["quota_gb"]) * UNITS[unit]
            used = quota_used(q, s.get("quota_dir") or "total")
            pct = used * 100.0 / limit
            warn = int(s.get("quota_warn") or 80)
            text = None
            if pct >= 100 and not q["over"]:
                q["over"] = q["warned"] = True
                text = "LIMIT REACHED: %s used %s of %s %s (%s)" % (s["name"], fmt_bytes(used, unit), s["quota_gb"], unit, q["period"])
            elif pct >= warn and not q["warned"]:
                q["warned"] = True
                text = "Limit warning: %s used %s of %s %s (%d%%, %s)" % (s["name"], fmt_bytes(used, unit), s["quota_gb"], unit, pct, q["period"])
            if text:
                self.dirty = True
                self.alert(text)

    def alert(self, text):
        add_event("warn", text)
        threading.Thread(target=run, args=([GW, "notify", text], 40), daemon=True).start()

    # --- automatic reconnect
    def check_auto(self, sites, now, local):
        for s in sites:
            n = s["name"]
            link = self.state["links"].get(n)
            if link is None or n in self.busy or is_server(s) or s.get("disabled") == "yes":
                continue            # (a dial-in client dials us; we cannot redial it)
            every = int(s.get("reconnect_every") or 0)
            at = s.get("reconnect_at") or ""
            auto = self.state["auto"].setdefault(n, {})
            reason = None
            if every and now - link["since"] >= every * 3600 and in_window(local, s.get("reconnect_window") or ""):
                reason = "up for %dh" % every
            if at:
                target = local.replace(hour=int(at[:2]), minute=int(at[3:]), second=0, microsecond=0)
                today = local.date().isoformat()
                if local >= target and auto.get("at_date") != today:
                    auto["at_date"] = today
                    self.dirty = True
                    # only if we are still close to the planned time (not after downtime of the collector)
                    if (local - target).total_seconds() <= 1800 and reason is None:
                        reason = "daily at %s" % at
            if reason is None:
                continue
            if now - auto.get("last", 0) < AUTO_MIN_GAP or now - self.state["global"].get("last_auto", 0) < AUTO_GLOBAL_GAP:
                continue            # too soon: try again on a later pass
            auto["last"] = now
            auto["reason"] = reason
            self.state["global"]["last_auto"] = now
            self.dirty = True
            self.busy.add(n)
            threading.Thread(target=self.do_reconnect, args=(n, reason), daemon=True).start()

    def do_reconnect(self, n, reason):
        rc, out = run([GW, "reconnect", n], 150)
        self.state["auto"].setdefault(n, {})["rc"] = rc
        self.dirty = True
        self.busy.discard(n)
        if rc != 0:
            self.alert("Auto reconnect of %s FAILED (%s): %s" % (n, reason, out[-200:]))

    def check_memory(self):
        """low RAM / busy swap: one warning when it starts and one message when it is over (event log + Telegram)"""
        mn = mem_numbers()
        if mn is None:
            return
        av, sw = mn
        if not self.mem_low and (av < MEM_LOW_MB or sw > SWAP_LOW_PCT):
            self.mem_low = True
            self.alert("Low memory: %d MB available, swap %d%% used" % (av, sw))
        elif self.mem_low and av >= MEM_OK_MB and sw <= SWAP_OK_PCT:
            self.mem_low = False
            add_event("info", "Memory back to normal: %d MB available, swap %d%% used" % (av, sw))

    # --- one pass
    def step(self, now):
        cfg = read_general()
        local = datetime.fromtimestamp(now, get_tz(cfg["timezone"]))
        sites = load_sites()
        names = {s["name"] for s in sites}
        for n in [k for k in self.state["links"] if k not in names]:
            del self.state["links"][n]
            self.dirty = True
        for n in [k for k in self.state["quota"] if k not in names]:
            del self.state["quota"][n]        # (the daily history files are never deleted)
            self.dirty = True
        if names:                          # (never when the site list could not be read)
            self.archive_orphans(names, now)
        self.apply_resets(sites, now)
        self.apply_reset_all(now)
        try:
            self.nic.tick(now, local)
        except Exception:
            traceback.print_exc()
        peers = ppp_peers() if any(is_server(s) for s in sites) else {}
        for s in sites:
            self.sample(s, now, local, peers)
        self.check_quota(sites, cfg["unit"], now)
        self.check_memory()
        self.check_auto(sites, now, local)
        try:
            self.routes.tick(now)
        except Exception:
            traceback.print_exc()
        self.first_pass = False
        if self.dirty and now - self.last_flush >= FLUSH_EVERY:
            self.flush(now)
        if self.nic.dirty and now - self.last_nic_flush >= 60:
            self.nic.flush()
            self.last_nic_flush = now
        if now - self.last_beat >= FLUSH_EVERY:       # "I am alive" marker for the web page
            atomic_write(os.path.join(TRAFFIC_DIR, "heartbeat"), "%d\n" % now)
            self.last_beat = now


def cmd_collect():
    col = Collector()
    add_event("info", "Traffic collector started (version %s)" % VERSION)
    stop = threading.Event()
    for sg in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sg, lambda *a: stop.set())
    while not stop.is_set():
        try:
            col.step(time.time())
        except Exception:
            traceback.print_exc()
        stop.wait(SAMPLE_EVERY)
    try:
        col.step(time.time())          # last sample, then everything to disk (clean shutdown / reboot)
        col.flush(time.time())
    except Exception:
        traceback.print_exc()


def collector_alive():
    try:
        with open(os.path.join(TRAFFIC_DIR, "heartbeat")) as f:
            return time.time() - float(f.read().strip()) < 120
    except (OSError, ValueError):
        return False


def quota_html(site, st, unit):
    """small progress bar for a site with a traffic limit"""
    if not site.get("quota_gb"):
        return ""
    e = html.escape
    q = st["quota"].get(site["name"])
    if not q:
        return "<div class=qtxt>Limit set, no data yet</div>"
    limit = float(site["quota_gb"]) * UNITS[unit]
    direction = site.get("quota_dir") or "total"
    used = quota_used(q, direction)
    pct = used * 100.0 / limit
    warn = int(site.get("quota_warn") or 80)
    cls = "over" if pct >= 100 else "near" if pct >= warn else "fine"
    when = {"day": "today", "week": "this week", "month": "this month"}[site.get("quota_period") or "day"]
    what = "" if direction == "total" else " " + direction
    return ("<div class='quota %s'><div class=qbar><span style='width:%d%%'></span></div>"
            "<div class=qtxt>%s of %s %s%s %s &middot; %d%%</div></div>"
            % (cls, min(100, int(pct)), e(fmt_bytes(used, unit)), e(site["quota_gb"]), unit, what, when, int(pct)))


def auto_text(site, st, tz):
    parts = []
    if site.get("reconnect_every") and site["reconnect_every"] != "0":
        parts.append("every %s h" % site["reconnect_every"])
    if site.get("reconnect_at"):
        parts.append("daily at %s" % site["reconnect_at"])
    if not parts:
        return ""
    a = st["auto"].get(site["name"], {})
    last = ""
    if a.get("last"):
        last = " &middot; last %s%s" % (datetime.fromtimestamp(a["last"], tz).strftime("%m-%d %H:%M"),
                                          " (failed)" if a.get("rc") else "")
    return "<div class=qtxt>Auto reconnect: %s%s</div>" % (html.escape(" + ".join(parts)), last)


# ================= route manager (core) =================
# Address lists + a table "list -> next hop -> metric", like address-list and routes in MikroTik.
#
# Files (the source of truth, they survive reboots):
#   CONF_DIR/lists.d/NAME.list   one entry per line: 1.2.3.4 | 1.2.3.0/24 | 1.2.3.1-1.2.3.50 | example.com   (# starts a comment)
#   CONF_DIR/routing.conf        rules:     NAME via IP[@site] metric N [disabled]
#                                protected: protect IP[/len]      (never routed by a list)
# The kernel routing table is only a result: our routes carry "proto 98", so only they are ever added, changed or
# removed. Routes of other origin (the per-site "routes", the system) are never touched.
#
# "via IP" means:
#   - the tunnel address (peer) of one or more sites -> all of those tunnels that are UP share the traffic (multipath);
#     if none is up the route is removed and traffic follows the normal route
#   - IP@site -> only that site's tunnel
#   - any other IP that is directly reachable on a connected network (for example the gateway of this server's own
#     network, to send a list straight to the internet instead of a tunnel)
# Longest prefix wins first (a /32 beats a /20 whatever the metric); the metric decides between equal prefixes.
#
# Safety:
#   - protected addresses are cut out of every list: this server's own networks, the cloud metadata address, the public
#     address of every site (a route to it through its own tunnel would break the tunnel), the machines that are logged
#     in right now (SSH, this web page) and anything added with "protect"
#   - an entry that equals a route of another origin (same prefix and metric) is skipped, never overwritten
#   - entries wider than /8 are refused; at most RT_MAX_ROUTES routes
RT_LISTS = os.path.join(CONF_DIR, "lists.d")
RT_RULES = os.path.join(CONF_DIR, "routing.conf")
RT_STATE = os.path.join(STATE_DIR, "routes")            # dns.json, peers.json, viewers.json, status.json, apply.lock
RT_PROTO = "98"
RT_MIN_PREFIX = 8
RT_MAX_ROUTES = 20000
RT_DNS_EVERY = 300          # seconds between DNS lookups of names used in lists
RT_DNS_KEEP = 3600          # an address that a name no longer returns stays this long (avoids flapping)
RT_DNS_MAX = 64             # addresses kept per name
RT_VIEWER_TTL = 12 * 3600
RT_FULL_EVERY = 60          # seconds between full checks of the kernel table (changes are noticed within SAMPLE_EVERY)
SYS_NET_DIR = os.environ.get("SYS_NET", "/sys/class/net")


class RtError(ValueError):
    pass


NAME_RE = re.compile(r"^[a-z0-9][a-z0-9_-]{0,31}$")
SITE_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,10}$")
HOST_RE = re.compile(r"^(?=.{4,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$", re.I)
IP_RE = re.compile(r"^\d{1,3}(\.\d{1,3}){3}$")
RULE_RE = re.compile(r"^([a-z0-9][a-z0-9_-]{0,31})\s+via\s+(\d{1,3}(?:\.\d{1,3}){3})(?:@([a-z0-9][a-z0-9-]{0,10}))?"
                     r"\s+metric\s+(\d{1,5})(?:\s+(disabled))?$")


# ---------- list entries ----------
def parse_entry(text):
    """one list line -> ("nets", [IPv4Network, ...]), ("dns", name) or ("country", "IR"). RtError with a readable message if invalid."""
    t = text.strip()
    cm = re.fullmatch(r"@country\s+([A-Za-z]{2})", t)
    if cm:
        return ("country", cm.group(1).upper())
    if t.startswith("@"):
        raise RtError("unknown directive (use  @country IR  for a country list)")
    m = re.fullmatch(r"(\S+)\s*-\s*(\S+)", t)
    try:
        if m and IP_RE.match(m.group(1)) and IP_RE.match(m.group(2)):
            a, b = ipaddress.IPv4Address(m.group(1)), ipaddress.IPv4Address(m.group(2))
            if int(a) > int(b):
                raise RtError("the range starts after it ends")
            nets = list(ipaddress.summarize_address_range(a, b))
        elif re.fullmatch(r"\d+\.\d+\.\d+\.\d+(/\d{1,2})?", t):
            nets = [ipaddress.IPv4Network(t, strict=False)]       # 1.2.3.4/24 is read as 1.2.3.0/24
        elif HOST_RE.match(t):
            return ("dns", t.lower())
        else:
            raise RtError("not an IPv4 address, network, range or DNS name")
    except RtError:
        raise
    except ValueError:
        raise RtError("not a valid IPv4 address or network")
    for n in nets:
        if n.prefixlen < RT_MIN_PREFIX:
            raise RtError("%s is too wide (nothing wider than /%d is allowed)" % (n, RT_MIN_PREFIX))
    return ("nets", nets)


def parse_list_text(text):
    """-> (entries [(kind, value, original text)], errors [str])"""
    entries, errors = [], []
    for i, line in enumerate(text.splitlines(), 1):
        t = line.split("#", 1)[0].strip()
        if not t:
            continue
        try:
            kind, val = parse_entry(t)
            entries.append((kind, val, t))
        except RtError as e:
            errors.append("line %d: %s  (%s)" % (i, e, t[:60]))
        if len(entries) + len(errors) > RT_MAX_ROUTES:
            errors.append("too many lines (the limit is %d)" % RT_MAX_ROUTES)
            break
    return entries, errors


def rt_list_names():
    try:
        return sorted(f[:-5] for f in os.listdir(RT_LISTS) if f.endswith(".list") and NAME_RE.match(f[:-5]))
    except OSError:
        return []


def rt_read_list(name):
    try:
        with open(os.path.join(RT_LISTS, name + ".list")) as f:
            return f.read()
    except OSError:
        return None


def rt_write_list(name, text):
    os.makedirs(RT_LISTS, exist_ok=True)
    atomic_write(os.path.join(RT_LISTS, name + ".list"), text.replace("\r\n", "\n").rstrip("\n") + "\n")


# ---------- rules ----------
def parse_rules_text(text):
    """-> (rules [dict], protects [str], errors [str])"""
    rules, protects, errors = [], [], []
    for i, line in enumerate(text.splitlines(), 1):
        t = line.split("#", 1)[0].strip()
        if not t:
            continue
        pm = re.match(r"^protect\s+(\S+)$", t)
        if pm:
            try:
                kind, val = parse_entry_any(pm.group(1))
                protects.append(pm.group(1))
            except RtError as e:
                errors.append("line %d: %s" % (i, e))
            continue
        m = RULE_RE.match(t)
        if not m:
            errors.append("line %d: expected  LIST via IP[@site] metric N  (%s)" % (i, t[:60]))
            continue
        try:
            ipaddress.IPv4Address(m.group(2))
        except ValueError:
            errors.append("line %d: %s is not a valid address" % (i, m.group(2)))
            continue
        metric = int(m.group(4))
        if not 1 <= metric <= 65535:
            errors.append("line %d: metric must be 1-65535" % i)
            continue
        rules.append({"list": m.group(1), "via": m.group(2), "site": m.group(3) or "", "metric": metric,
                      "disabled": bool(m.group(5))})
    return rules, protects, errors


def parse_entry_any(t):
    """like parse_entry but a protected address may be any width (a whole server network is /20 or wider)"""
    if re.fullmatch(r"\d+\.\d+\.\d+\.\d+(/\d{1,2})?", t):
        try:
            return ("nets", [ipaddress.IPv4Network(t, strict=False)])
        except ValueError:
            raise RtError("%s is not a valid address" % t)
    raise RtError("protect needs an IPv4 address or network, got: %s" % t)


def render_rules(rules, protects):
    out = ["# managed by l2tp-gw-web (Routes page). Format:  LIST via IP[@site] metric N [disabled]"]
    for r in rules:
        out.append("%s via %s%s metric %d%s" % (r["list"], r["via"], ("@" + r["site"]) if r["site"] else "",
                                                 r["metric"], " disabled" if r["disabled"] else ""))
    for p in protects:
        out.append("protect %s" % p)
    return "\n".join(out) + "\n"


def rt_read_rules_text():
    try:
        with open(RT_RULES) as f:
            return f.read()
    except OSError:
        return ""


# ---------- small state files ----------
def rt_json_read(name, default):
    try:
        with open(os.path.join(RT_STATE, name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def rt_json_write(name, obj):
    os.makedirs(RT_STATE, exist_ok=True)
    atomic_write(os.path.join(RT_STATE, name), json.dumps(obj))


def rt_note_viewer(ip):
    """the address of the machine that uses this web page: protected for a while so a list cannot cut it off"""
    if not ip or not IP_RE.match(ip):
        return
    v = rt_json_read("viewers.json", {})
    now = time.time()
    v = {k: t for k, t in v.items() if now - t < RT_VIEWER_TTL}
    if now - v.get(ip, 0) > 60:
        v[ip] = now
        rt_json_write("viewers.json", v)


def rt_dns_cache():
    return rt_json_read("dns.json", {})


def rt_dns_ips(cache, name, now):
    """addresses of a DNS name from the cache (those seen within RT_DNS_KEEP seconds)"""
    ips = (cache.get(name) or {}).get("ips", {})
    return sorted(ip for ip, ts in ips.items() if now - ts <= RT_DNS_KEEP)


# ---------- the machine: tunnels, protected addresses, kernel table ----------
def rt_tunnels(sites):
    """site name -> {"dev", "up", "peer"}; the peer address is remembered so a tunnel that is down is still recognised"""
    names = {s["name"] for s in sites}
    _, links = run(["ip", "-o", "link", "show"], 10)
    exists, up = set(), {}
    for line in links.splitlines():
        m = re.match(r"\d+:\s+(ppp[^:@\s]*)[:@].*?<([^>]*)>", line)
        if m:
            exists.add(m.group(1))
            up[m.group(1)] = "UP" in m.group(2).split(",")
    _, addrs = run(["ip", "-o", "-4", "addr", "show"], 10)
    now_peer = {}
    for line in addrs.splitlines():
        m = re.match(r"^\d+:\s+(ppp[^\s:]*)\s+inet\s+\S+\s+peer\s+(\d+\.\d+\.\d+\.\d+)", line)
        if m:
            now_peer[m.group(1)] = m.group(2)
    peers = {v: k for k, v in now_peer.items()}
    remembered = rt_json_read("peers.json", {})
    changed = False
    out = {}
    for s in sites:
        n = s["name"]
        dev = site_dev(s, peers) or ("ppp-" + n)
        if is_server(s):
            remembered[n] = s.get("ip", "")        # a dial-in client keeps the same address for good
        elif dev in now_peer and remembered.get(n) != now_peer[dev]:
            remembered[n] = now_peer[dev]
            changed = True
        out[n] = {"dev": dev, "up": bool(up.get(dev)) and dev in now_peer, "peer": remembered.get(n, "")}
    if changed:
        rt_json_write("peers.json", {k: v for k, v in remembered.items() if k in names})
    return out


def rt_protected(sites, extra, cache, now):
    """-> [(network, reason)]: addresses that no list may route"""
    items = [(ipaddress.IPv4Network("127.0.0.0/8"), "loopback"),
             (ipaddress.IPv4Network("169.254.0.0/16"), "cloud metadata and link-local")]
    _, addrs = run(["ip", "-o", "-4", "addr", "show"], 10)
    for line in addrs.splitlines():
        m = re.match(r"^\d+:\s+(\S+)\s+inet\s+(\d+\.\d+\.\d+\.\d+/\d+)", line)
        if m and not m.group(1).startswith(("ppp", "lo")):
            try:
                items.append((ipaddress.IPv4Interface(m.group(2)).network, "this server's network (%s)" % m.group(1)))
            except ValueError:
                pass
    _, xs = run(["ip", "-o", "xfrm", "state"], 10)
    for line in xs.splitlines():          # every IPsec peer (also dial-in clients, which can have any address)
        m = re.match(r"^src\s+(\d+\.\d+\.\d+\.\d+)\s+dst\s+(\d+\.\d+\.\d+\.\d+)", line)
        if m:
            for ip in m.groups():
                try:
                    items.append((ipaddress.IPv4Network(ip + "/32"), "IPsec peer"))
                except ValueError:
                    pass
    for s in sites:                       # the public address of every site: its tunnel must never be routed into itself
        h = s.get("host", "")
        if IP_RE.match(h):
            ips = [h]
        else:
            ips = rt_dns_ips(cache, h.lower(), now)
        for ip in ips:
            try:
                items.append((ipaddress.IPv4Network(ip + "/32"), "address of site %s" % s["name"]))
            except ValueError:
                pass
    _, ss = run(["ss", "-Hnt", "state", "established", "(", "sport", "=", ":22", ")"], 10)
    for line in ss.splitlines():          # machines logged in over SSH right now
        f = line.split()
        m = re.search(r"(\d+\.\d+\.\d+\.\d+):\d+$", f[-1]) if f else None
        if m:
            items.append((ipaddress.IPv4Network(m.group(1) + "/32"), "SSH session"))
    for ip, ts in rt_json_read("viewers.json", {}).items():
        if now - ts < RT_VIEWER_TTL and IP_RE.match(ip):
            items.append((ipaddress.IPv4Network(ip + "/32"), "this web page is open from here"))
    for p in extra:
        try:
            items.append((parse_entry_any(p)[1][0], "protected by you"))
        except RtError:
            pass
    seen, out = set(), []
    for n, r in items:
        if (n, r) not in seen:
            seen.add((n, r))
            out.append((n, r))
    return out


def rt_kernel():
    """-> (ours {(prefix, metric): frozenset(members)}, others {(prefix, metric)}) from "ip route"; a member is
    ("dev", D) or ("gw", G, D)"""
    _, out = run(["ip", "-4", "route", "show", "table", "main"], 30)
    blocks = []
    for line in out.splitlines():
        if line[:1].isspace():
            if blocks:
                blocks[-1] += " " + line.strip()
        elif line.strip():
            blocks.append(line.strip())
    ours, others = {}, set()
    for b in blocks:
        t = b.split()
        if not (t[0] == "default" or t[0][0].isdigit()):
            continue                                              # blackhole, local, broadcast ...
        prefix = "0.0.0.0/0" if t[0] == "default" else (t[0] if "/" in t[0] else t[0] + "/32")
        metric = int(t[t.index("metric") + 1]) if "metric" in t and t.index("metric") + 1 < len(t) else 0
        proto = t[t.index("proto") + 1] if "proto" in t and t.index("proto") + 1 < len(t) else ""
        segs = []
        if "nexthop" in t:
            cur = None
            for tok in t:
                if tok == "nexthop":
                    cur = []
                    segs.append(cur)
                elif cur is not None:
                    cur.append(tok)
        else:
            segs = [t[1:]]
        members = set()
        for sg in segs:
            dev = sg[sg.index("dev") + 1] if "dev" in sg and sg.index("dev") + 1 < len(sg) else ""
            gw = sg[sg.index("via") + 1] if "via" in sg and sg.index("via") + 1 < len(sg) else ""
            if dev:
                members.add(("gw", gw, dev) if gw else ("dev", dev))
        if proto == RT_PROTO:
            ours[(prefix, metric)] = frozenset(members)
        else:
            others.add((prefix, metric))
    return ours, others


# ---------- compute what should be in the table ----------
def rt_members(rule, tun, now):
    """-> (members [..], state, text). state: ok | down | nohop"""
    via, site = rule["via"], rule["site"]
    if site:
        t = tun.get(site)
        if not t:
            return [], "nohop", "unknown site %s" % site
        if t["peer"] and t["peer"] != via:
            return [], "nohop", "site %s has tunnel address %s, not %s" % (site, t["peer"], via)
        return ([("dev", t["dev"])], "ok", "tunnel %s" % site) if t["up"] else ([], "down", "tunnel %s is down" % site)
    owners = sorted(n for n, t in tun.items() if t["peer"] == via)
    if owners:
        up = [n for n in owners if tun[n]["up"]]
        text = "tunnel%s %s" % ("s" if len(owners) > 1 else "", ", ".join(owners))
        if up:
            return [("dev", tun[n]["dev"]) for n in up], "ok", text + (" (%d of %d up)" % (len(up), len(owners)) if len(owners) > 1 else "")
        return [], "down", text + " (down)"
    _, out = run(["ip", "-4", "route", "get", via], 10)
    m = re.match(r"^(\d+\.\d+\.\d+\.\d+)\s+dev\s+(\S+)", out.strip())
    if m and not m.group(2).startswith("ppp") and m.group(2) != "lo":
        return [("gw", via, m.group(2))], "ok", "next hop %s on %s" % (via, m.group(2))
    return [], "nohop", "%s is not a tunnel address and not on a connected network" % via


def rt_subtract(nets, protected):
    """remove the protected networks from a list of networks -> (rest, [protected nets that cut something])"""
    cut = set()
    rest = list(nets)
    for p in protected:
        nxt = []
        for n in rest:
            if not n.overlaps(p):
                nxt.append(n)
            elif p.supernet_of(n):
                cut.add(p)                         # the whole entry is inside a protected network: dropped
            else:
                cut.add(p)
                nxt.extend(n.address_exclude(p))   # a protected address inside the entry: cut out
        rest = nxt
    return rest, cut


def rt_compute(rules_text=None, list_texts=None, now=None, kernel=None):
    """Pure function: reads files and the kernel table, changes nothing.
    rules_text / list_texts (name -> text or None) replace the files, to preview a change before it is saved.
    Returns {"desired": {(prefix, metric): tuple(members)}, "rules": [report], "protected": [(net, reason)],
             "warnings": [str], "errors": [str]}"""
    now = now or time.time()
    list_texts = list_texts or {}
    sites = load_sites()
    tun = rt_tunnels(sites)
    cache = rt_dns_cache()
    text = rules_text if rules_text is not None else rt_read_rules_text()
    rules, protects, errors = parse_rules_text(text)
    warnings = []
    prot = rt_protected(sites, protects, cache, now)
    prot_nets = [n for n, _ in prot]
    ours, others = kernel if kernel else rt_kernel()
    desired, report = {}, []
    parsed = {}
    skipped_conflict = 0
    for r in rules:
        rep = {"rule": r, "prefixes": 0, "state": "ok", "text": "", "unresolved": 0, "nodata": 0, "cut": 0, "problems": []}
        report.append(rep)
        name = r["list"]
        if name not in parsed:
            txt = list_texts[name] if name in list_texts else rt_read_list(name)
            parsed[name] = parse_list_text(txt) if txt is not None else None
        if parsed[name] is None:
            rep["state"], rep["text"] = "nolist", "list %s does not exist" % name
            continue
        entries, perr = parsed[name]
        if perr:
            rep["problems"] = perr[:3]
        nets = []
        for kind, val, orig in entries:
            if kind == "nets":
                nets.extend(val)
            elif kind == "country":
                cn = rt_country_nets(val)
                if cn is None:
                    rep["nodata"] += 1
                    w = "list %s: no data for country %s yet (it is downloaded after you apply; see Country data)" % (name, val)
                    if w not in warnings:
                        warnings.append(w)
                else:
                    nets.extend(cn)
            else:
                ips = rt_dns_ips(cache, val, now)
                if not ips:
                    rep["unresolved"] += 1
                for ip in ips:
                    nets.append(ipaddress.IPv4Network(ip + "/32"))
        nets = list(ipaddress.collapse_addresses(nets))
        rest, cut = rt_subtract(nets, prot_nets)
        rest = list(ipaddress.collapse_addresses(rest))
        rep["prefixes"] = len(rest)
        rep["cut"] = len(cut)
        if cut:
            warnings.append("list %s: %d protected address(es) were cut out (%s)" % (
                name, len(cut), ", ".join(sorted(str(c) for c in cut)[:4]) + (" ..." if len(cut) > 4 else "")))
        if r["disabled"]:
            rep["state"], rep["text"] = "disabled", "switched off"
            continue
        members, state, mtext = rt_members(r, tun, now)
        rep["state"], rep["text"] = state, mtext
        if not members:
            continue
        for n in rest:
            key = (str(n), r["metric"])
            if key in others:
                skipped_conflict += 1
                continue
            desired[key] = tuple(sorted(set(desired.get(key, ())) | set(members)))
    if skipped_conflict:
        warnings.append("%d entr%s skipped: same prefix and metric as a route of another origin (a site's routes)" % (
            skipped_conflict, "y" if skipped_conflict == 1 else "ies"))
    if len(desired) > RT_MAX_ROUTES:
        errors.append("%d routes is more than the limit of %d: nothing is applied" % (len(desired), RT_MAX_ROUTES))
        desired = {}
    return {"desired": desired, "rules": report, "protected": prot, "warnings": warnings, "errors": errors,
            "ours": ours, "tunnels": tun}


# ---------- apply ----------
class rt_lock:
    """one writer at a time (the collector and the web page both may apply)"""
    def __enter__(self):
        os.makedirs(RT_STATE, exist_ok=True)
        self.f = open(os.path.join(RT_STATE, "apply.lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *a):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def rt_route_cmd(verb, key, members):
    prefix, metric = key
    if verb == "del":
        return "route del %s metric %d proto %s" % (prefix, metric, RT_PROTO)

    def hop(m):
        return "dev %s" % m[1] if m[0] == "dev" else "via %s dev %s" % (m[1], m[2])
    if len(members) == 1:
        return "route replace %s metric %d proto %s %s" % (prefix, metric, RT_PROTO, hop(members[0]))
    return "route replace %s metric %d proto %s %s" % (prefix, metric, RT_PROTO, " ".join("nexthop " + hop(m) for m in members))


def rt_diff(desired, ours):
    """-> (commands, added, changed, removed)"""
    cmds, a, c, r = [], 0, 0, 0
    for key, mem in sorted(desired.items()):
        cur = ours.get(key)
        if cur is None:
            a += 1
        elif cur != frozenset(mem):
            c += 1
        else:
            continue
        cmds.append(rt_route_cmd("replace", key, mem))
    for key in sorted(ours):
        if key not in desired:
            r += 1
            cmds.append(rt_route_cmd("del", key, ()))
    return cmds, a, c, r


def rt_apply(res):
    """make the proto-98 routes of the kernel equal to res["desired"]; only the difference is changed"""
    with rt_lock():
        ours, _ = rt_kernel()
        cmds, a, c, r = rt_diff(res["desired"], ours)
        errs = 0
        if cmds:
            p = subprocess.run(["ip", "-4", "-force", "-batch", "-"], input="\n".join(cmds) + "\n",
                               capture_output=True, text=True, timeout=120)
            errs = len([l for l in p.stderr.splitlines() if l.strip()])
        summary = {"ts": time.time(), "routes": len(res["desired"]), "added": a, "changed": c, "removed": r,
                   "errors": errs, "warnings": res["warnings"][:10], "problems": res["errors"][:10]}
        rt_json_write("status.json", summary)
        return summary


# ---------- DNS ----------
def rt_dns_names(sites):
    """DNS names that need resolving: names in the lists and DNS hosts of the sites (their address is protected)"""
    names = set()
    for n in rt_list_names():
        entries, _ = parse_list_text(rt_read_list(n) or "")
        names.update(v for k, v, _ in entries if k == "dns")
    for s in sites:
        h = s.get("host", "")
        if h and not IP_RE.match(h) and HOST_RE.match(h):
            names.add(h.lower())
    return sorted(names)


def rt_dns_refresh(now=None):
    now = now or time.time()
    cache = rt_dns_cache()
    names = rt_dns_names(load_sites())
    for name in names:
        ent = cache.setdefault(name, {"ips": {}, "ts": 0, "err": ""})
        try:
            got = {ai[4][0] for ai in socket.getaddrinfo(name, None, socket.AF_INET)}
            for ip in got:
                ent["ips"][ip] = now
            ent["err"] = ""
        except OSError as e:
            ent["err"] = str(e)[:80]              # keep the addresses we already know
        ent["ts"] = now
        ent["ips"] = dict(sorted(((ip, ts) for ip, ts in ent["ips"].items() if now - ts <= RT_DNS_KEEP),
                                 key=lambda x: -x[1])[:RT_DNS_MAX])
    rt_json_write("dns.json", {k: v for k, v in cache.items() if k in names})


# ---------- the collector calls this every pass ----------
class RouteSync:
    def __init__(self):
        self.sig = None
        self.last_full = 0
        self.last_dns = 0
        self.dns_thread = None

    def signature(self):
        parts = []
        try:
            parts.append(tuple(sorted(n for n in os.listdir(SYS_NET_DIR) if n.startswith("ppp"))))
        except OSError:
            parts.append(())
        paths = [RT_RULES, SITES, os.path.join(RT_STATE, "dns.json"), os.path.join(RT_STATE, "viewers.json"),
                 os.path.join(RT_STATE, "country.json")]
        try:
            paths += [os.path.join(RT_COUNTRY_DIR, f) for f in sorted(os.listdir(RT_COUNTRY_DIR))]
        except OSError:
            pass
        try:
            paths += [os.path.join(RT_LISTS, f) for f in sorted(os.listdir(RT_LISTS))]
        except OSError:
            pass
        for p in paths:
            try:
                st = os.stat(p)
                parts.append((p, st.st_mtime_ns, st.st_size))
            except OSError:
                parts.append((p, 0, 0))
        return parts

    def tick(self, now):
        if now - self.last_dns >= RT_DNS_EVERY and not (self.dns_thread and self.dns_thread.is_alive()):
            self.last_dns = now
            self.dns_thread = threading.Thread(target=self._dns, daemon=True)
            self.dns_thread.start()
        try:
            rt_safe_tick(now)
        except Exception:
            traceback.print_exc()
        try:
            if rt_country_due(now):
                rt_country_start()
        except Exception:
            traceback.print_exc()
        sig = self.signature()
        if sig != self.sig or now - self.last_full >= RT_FULL_EVERY:
            self.sig, self.last_full = sig, now
            try:
                rt_apply(rt_compute(now=now))
            except Exception:
                traceback.print_exc()

    def _dns(self):
        try:
            rt_dns_refresh()
        except Exception:
            traceback.print_exc()


# ---------- country lists (RIR data) ----------
# A list line "@country IR" means: every IPv4 block that the registries (RIR) delegated to that country.
# Data = the five public "delegated" files. Registration country, not geolocation (a block may be used elsewhere).
RT_COUNTRY_DIR = os.path.join(RT_STATE, "countries")          # IR.cidr = last good copy, one network per line
RT_RIR_URLS = [
    ("RIPE NCC", "https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-latest"),
    ("APNIC", "https://ftp.apnic.net/stats/apnic/delegated-apnic-latest"),
    ("ARIN", "https://ftp.arin.net/pub/stats/arin/delegated-arin-extended-latest"),
    ("LACNIC", "https://ftp.lacnic.net/pub/stats/lacnic/delegated-lacnic-latest"),
    ("AFRINIC", "https://ftp.afrinic.net/pub/stats/afrinic/delegated-afrinic-latest"),
]
RT_COUNTRY_EVERY = 7 * 86400          # refresh weekly
RT_COUNTRY_RETRY = 6 * 3600           # after a failed attempt, try again later (not at every tick)
RT_COUNTRY_MAX_BYTES = 60_000_000     # a file larger than this is refused
RT_COUNTRY_MIN_RECORDS = 500          # a registry file with fewer IPv4 records is not a real file
RT_COUNTRY_SHRINK, RT_COUNTRY_GROW = 0.5, 2.0   # a country whose size changes more than this is held for confirmation
RT_COUNTRY_MIN_OLD = 10               # (only judged when the old copy had at least this many networks)
CC_RE = re.compile(r"^[A-Za-z]{2}$")
COUNTRY_LINE_RE = re.compile(r"^\s*@country\s+([A-Za-z]{2})\s*(?:#.*)?$", re.M)


def rt_country_nets(code):
    """last good copy of a country -> [IPv4Network] or None when it was never downloaded"""
    try:
        with open(os.path.join(RT_COUNTRY_DIR, code.upper() + ".cidr")) as f:
            return [ipaddress.IPv4Network(l.strip()) for l in f if l.strip()]
    except (OSError, ValueError):
        return None


def rt_country_codes(list_texts=None):
    """country codes used by any list (list_texts: name -> text overrides, for a preview)"""
    texts = dict(list_texts or {})
    for n in rt_list_names():
        if n not in texts:
            texts[n] = rt_read_list(n)
    found = set()
    for t in texts.values():
        if t:
            found.update(m.upper() for m in COUNTRY_LINE_RE.findall(t))
    return found


def rt_rir_parse(text, codes):
    """one registry file -> {CC: [IPv4Network]} for the wanted codes. RtError when the file does not look right."""
    out = {c: [] for c in codes}
    records = 0
    seen_version = False
    for line in text.splitlines():
        if not line or line[0] == "#":
            continue
        f = line.split("|")
        if not seen_version:
            if not re.match(r"^\d(\.\d+)?$", f[0]) or len(f) < 6:
                raise RtError("the first line is not a delegated-stats header")
            seen_version = True
            continue
        if len(f) < 7 or f[5] == "summary" or f[2] != "ipv4":
            continue
        records += 1
        cc = f[1].upper()
        if cc not in out or f[6] not in ("allocated", "assigned"):
            continue
        try:
            start = ipaddress.IPv4Address(f[3])
            count = int(f[4])
            if count <= 0 or int(start) + count - 1 > 0xFFFFFFFF:
                raise ValueError
            out[cc].extend(ipaddress.summarize_address_range(start, ipaddress.IPv4Address(int(start) + count - 1)))
        except ValueError:
            raise RtError("bad record: %s" % line[:60])
    if not seen_version:
        raise RtError("the file is empty")
    if records < RT_COUNTRY_MIN_RECORDS:
        raise RtError("only %d IPv4 records, this is not a full registry file" % records)
    return out


def rt_rir_fetch(url):
    """download one registry file as text (size and time limited)"""
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": "l2tp-gw-web"})
    with urllib.request.urlopen(req, timeout=60) as r:
        data = r.read(RT_COUNTRY_MAX_BYTES + 1)
    if len(data) > RT_COUNTRY_MAX_BYTES:
        raise RtError("the file is larger than %d MB" % (RT_COUNTRY_MAX_BYTES // 1000000))
    return data.decode("ascii", "replace")


def rt_country_status():
    return rt_json_read("country.json", {})


def rt_country_update(codes=None, fetch=None, now=None, force=()):
    """Download the registry files and refresh the stored copy of every country that a list uses.
    All-or-nothing per run: if any of the five files fails, nothing is replaced (a country may be split over registries).
    A country whose size changes a lot is HELD (old copy stays) until confirmed with force=[CC].
    -> status dict (also saved)."""
    fetch = fetch or rt_rir_fetch
    now = now or time.time()
    os.makedirs(RT_STATE, exist_ok=True)
    lockf = open(os.path.join(RT_STATE, "country.lock"), "w")
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return {"busy": True}
    try:
        old = rt_country_status()
        codes = sorted(set(c.upper() for c in (codes if codes is not None else rt_country_codes())))
        st = {"ts": old.get("ts", 0), "attempt": now, "ok": False, "message": "", "countries": dict(old.get("countries", {})),
              "held": {}, "errors": []}
        if not codes:
            st.update(ok=True, message="no list uses a country")
            rt_json_write("country.json", st)
            return st
        merged = {c: [] for c in codes}
        for name, url in RT_RIR_URLS:
            try:
                part = rt_rir_parse(fetch(url), codes)
            except (RtError, OSError, ValueError) as e:
                st["errors"].append("%s: %s" % (name, e))
                continue
            for c in codes:
                merged[c].extend(part[c])
        if st["errors"]:
            st["message"] = "download failed, the old data stays (%s)" % "; ".join(st["errors"][:2])
            rt_json_write("country.json", st)
            return st
        os.makedirs(RT_COUNTRY_DIR, exist_ok=True)
        done = 0
        for c in codes:
            new = list(ipaddress.collapse_addresses(merged[c]))
            prev = rt_country_nets(c)
            if not new:
                st["errors"].append("%s: no addresses found (is the country code right?)" % c)
                continue
            if prev and len(prev) >= RT_COUNTRY_MIN_OLD and c not in force and not (
                    RT_COUNTRY_SHRINK <= len(new) / len(prev) <= RT_COUNTRY_GROW):
                st["held"][c] = {"old": len(prev), "new": len(new)}
                continue
            atomic_write(os.path.join(RT_COUNTRY_DIR, c + ".cidr"), "\n".join(str(n) for n in new) + "\n")
            st["countries"][c] = {"ts": now, "prefixes": len(new),
                                  "addresses": sum(n.num_addresses for n in new)}
            done += 1
        if st["held"] or st["errors"]:
            parts = []
            if st["held"]:
                parts.append("size changed a lot for %s: kept the old copy, please confirm" % ", ".join(sorted(st["held"])))
            parts.extend(st["errors"][:3])
            st["message"] = "; ".join(parts)
        else:
            st["ok"] = True
            st["ts"] = now
            st["message"] = "updated %d countr%s" % (done, "y" if done == 1 else "ies")
        rt_json_write("country.json", st)
        return st
    finally:
        lockf.close()


COUNTRY_THREAD = {"t": None}


def rt_country_start(force=()):
    """run an update in the background, then re-apply the routes. False when one is already running."""
    t = COUNTRY_THREAD["t"]
    if t and t.is_alive():
        return False

    def job():
        try:
            st = rt_country_update(force=force)
            if not st.get("busy"):
                rt_apply(rt_compute())
        except Exception:
            traceback.print_exc()
    COUNTRY_THREAD["t"] = threading.Thread(target=job, daemon=True)
    COUNTRY_THREAD["t"].start()
    return True


def rt_country_due(now):
    """True when a list uses a country that has no data yet, or the data is older than a week (and not tried lately)"""
    codes = rt_country_codes()
    if not codes:
        return False
    st = rt_country_status()
    if now - st.get("attempt", 0) < RT_COUNTRY_RETRY:
        return False
    return any(rt_country_nets(c) is None for c in codes) or now - st.get("ts", 0) >= RT_COUNTRY_EVERY


# ---------- safe mode (automatic undo) ----------
# Before a change is applied a snapshot of all rules and lists is stored. The change must be confirmed (Keep) within
# RT_SAFE_SECONDS, otherwise the collector service - a separate process, so it works even if you lost the connection to
# this page - puts the snapshot back. Only rules and lists are snapshotted (country data is never changed by a change).
RT_SAFE_SECONDS = 60


class rt_safe_lock:
    """serialises snapshot / keep / undo / timeout between the web page and the collector"""
    def __enter__(self):
        os.makedirs(RT_STATE, exist_ok=True)
        self.f = open(os.path.join(RT_STATE, "safe.lock"), "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)

    def __exit__(self, *a):
        self.f.close()


def rt_safe_pending():
    snap = rt_json_read("safe.json", None)
    return snap if isinstance(snap, dict) and "deadline" in snap else None


def rt_safe_snapshot(title, now=None):
    """caller holds rt_safe_lock"""
    now = now or time.time()
    rules = rt_read_rules_text() if os.path.exists(RT_RULES) else None
    lists = {n: rt_read_list(n) or "" for n in rt_list_names()}
    rt_json_write("safe.json", {"deadline": now + RT_SAFE_SECONDS, "title": title, "rules": rules, "lists": lists})


def rt_safe_restore(snap):
    """put the snapshot back (caller holds rt_safe_lock)"""
    if snap["rules"] is None:
        try:
            os.remove(RT_RULES)
        except OSError:
            pass
    else:
        atomic_write(RT_RULES, snap["rules"])
    for n in set(rt_list_names()) - set(snap["lists"]):
        try:
            os.remove(os.path.join(RT_LISTS, n + ".list"))
        except OSError:
            pass
    for n, t in snap["lists"].items():
        rt_write_list(n, t)


def rt_safe_end(kind, reason="", now=None):
    """kind: "keep" or "revert". -> True when there was a pending change"""
    now = now or time.time()
    with rt_safe_lock():
        snap = rt_safe_pending()
        if not snap:
            return False
        if kind == "revert":
            rt_safe_restore(snap)
        try:
            os.remove(os.path.join(RT_STATE, "safe.json"))
        except OSError:
            pass
        rt_json_write("safe_last.json", {"ts": now, "title": snap.get("title", ""), "result": kind, "reason": reason})
    if kind == "revert":
        rt_apply(rt_compute())
    return True


def rt_safe_tick(now):
    snap = rt_safe_pending()
    if snap and now >= snap["deadline"]:
        rt_safe_end("revert", "not confirmed in time", now)


# ---------- live status ----------
def live_status():
    _, br = run(["ip", "-br", "a"], 10)
    rc, ipsec = run(["ipsec", "status"], 10)
    if rc != 0:
        ipsec = None          # strongSwan not answering: unknown, not "no IPsec"
    ppp = {}
    by_ip = {s.get("ip"): s["name"] for s in load_sites() if is_server(s) and s.get("ip")}
    for line in br.splitlines():
        p = line.split()
        if p and p[0].startswith("ppp-"):
            ppp[p[0][4:]] = " ".join(p[2:])
        elif p and p[0].startswith("ppp"):
            # a dial-in client: ppp0, ppp1... found by its fixed address (the peer address of the interface)
            m = re.search(r"peer\s+(\d+\.\d+\.\d+\.\d+)", " ".join(p[2:]))
            if m and m.group(1) in by_ip:
                ppp[by_ip[m.group(1)]] = " ".join(p[2:])
    return ppp, ipsec


# ---------- html ----------
CSS = """
/* ---- design tokens. Dark is the default; light follows the system or the button in the side bar ---- */
:root{--bg:#0c121c;--side:#0a0f18;--panel:#121a28;--raised:#182235;--line:#223048;--line2:#2e3f5e;
 --ink:#e6ecf5;--mute:#8a99b1;--accent:#8ba3ff;--accent-ink:#0a1230;--accent-soft:rgba(139,163,255,.14);
 --ok:#3ccf91;--warn:#f0b04a;--bad:#ff6b6b;--chip:#1b2740;--code:#080d15;--code-ink:#c9d6e8;
