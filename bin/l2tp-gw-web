            "Routes made here are marked <code>proto 98</code> in <code>ip route</code>; routes of the sites are never changed.</p>"
            % (st or "Nothing applied yet", warn, rules_html, lists_html, country_html, prot_html))
    return page("Routes", body, sid, msg, "/routes")


def list_edit_page(sid, name, text=None, errors=None, new=False):
    e = html.escape
    if text is None:
        text = rt_read_list(name) or "" if name else ""
    err = "<div class=warnbox>%s</div>" % "<br>".join(e(x) for x in errors) if errors else ""
    namefield = ("<input type=text id=ln name=name value='%s' class=mono placeholder='iran'>" % e(name or "")) if new else (
        "<input type=hidden name=name value='%s'><b class=mono>%s</b>" % (e(name), e(name)))
    body = ("<div class=bar><h1>%s</h1></div>%s<form class=form method=post action=/routes/list/save style='max-width:720px'>"
            "<input type=hidden name=csrf value='%s'><input type=hidden name=new value='%s'>"
            "<label for=ln>List name<span class=hint>Lowercase letters, numbers, - and _ (up to 32).</span></label>%s"
            "<label for=lt>Entries<span class=hint>One per line: an address (1.2.3.4), a network (1.2.3.0/24), a range (1.2.3.1-1.2.3.50) "
            "a DNS name (example.com, looked up every 5 minutes, IPv4 only) or a whole country (@country IR). Text after # is a comment. Nothing wider than /8.</span></label>"
            "<textarea id=lt name=text spellcheck=false style='min-height:320px'>%s</textarea>"
            "<p style='margin-top:16px'><button class='btn pri'>Review change</button> <a class=btn href=/routes>Cancel</a></p></form>"
            % ("New list" if new else "Edit list", err, e(csrf_of(sid)), "1" if new else "", namefield, e(text)))
    return page("List", body, sid, None, "/routes")


def stage(sid, title, rules_text=None, lists=None):
    PENDING[sid] = {"title": title, "rules": rules_text, "lists": lists or {}}


def review_page(sid):
    e = html.escape
    p = PENDING.get(sid)
    if not p:
        return page("Review", "<p>Nothing to review. <a href=/routes>Back to routes</a></p>", sid, None, "/routes")
    res = rt_compute(rules_text=p["rules"], list_texts=p["lists"])
    cmds, a, c, r = rt_diff(res["desired"], res["ours"])
    blocking = bool(res["errors"])
    sample = "".join("<div class=mono>%s</div>" % e(x.replace("route replace ", "+ ").replace("route del ", "- ")) for x in cmds[:14])
    if len(cmds) > 14:
        sample += "<div class=none>... and %d more</div>" % (len(cmds) - 14)
    rows = ""
    for rep in res["rules"]:
        rr = rep["rule"]
        rows += "<tr><td><b>%s</b></td><td class=mono>%s%s metric %d</td><td>%d</td><td>%s</td></tr>" % (
            e(rr["list"]), e(rr["via"]), e("@" + rr["site"]) if rr["site"] else "", rr["metric"], rep["prefixes"], rt_state_html(rep))
    warn = ""
    if res["warnings"] or res["errors"]:
        warn = "<div class=warnbox>%s</div>" % "<br>".join(e(w) for w in res["errors"] + res["warnings"])
    csrf = e(csrf_of(sid))
    alive = collector_alive()
    safe_box = ("<label style='display:block;margin:0 0 12px'><input type=checkbox name=safe value=1 %s> "
                "<b>Safe mode</b> &mdash; undo this change automatically after %d seconds unless I press Keep%s</label>"
                % ("checked" if alive else "disabled", RT_SAFE_SECONDS,
                   "" if alive else " <span class='rtst warn'>(not available: the collector service is not running)</span>"))
    body = ("<div class=bar><h1>Review: %s</h1></div>%s"
            "<div class=card><h2>What will change in the routing table</h2>"
            "<div class=tot><div><b>Added</b>%d</div><div><b>Changed</b>%d</div><div><b>Removed</b>%d</div>"
            "<div><b>Total after</b>%d</div></div>%s</div>"
            "<div class=card><h2>Rules after this change</h2><table class=rt>%s</table></div>"
            "<form method=post action=/routes/confirm style='display:inline'><input type=hidden name=csrf value='%s'>"
            "%s<button class='btn pri' data-busy='Applying...'%s>Apply</button></form> "
            "<form method=post action=/routes/cancel style='display:inline'><input type=hidden name=csrf value='%s'><button class=btn>Cancel</button></form>"
            % (e(p["title"]), warn, a, c, r, len(res["desired"]), sample or "<div class=none>The routing table does not change.</div>",
               rows or "<tr><td class=none>No rules.</td></tr>", csrf, safe_box, " disabled" if blocking else "", csrf))
    return page("Review change", body, sid, None, "/routes")


def routes_commit(sid, safe=False):
    """write the staged change, then make the kernel match. -> (ok, message)
    safe: take a snapshot first; the change is undone automatically unless it is confirmed in time"""
    p = PENDING.get(sid)
    if not p:
        return False, "Nothing to apply (the review expired)."
    if rt_safe_pending():
        return False, "The previous change is still waiting for your confirmation. Press Keep or Undo first."
    PENDING.pop(sid, None)
    safe_note = ""
    if safe and not collector_alive():
        safe, safe_note = False, " Safe mode was NOT used: the collector service is not running, so nothing could undo it."
    with LOCK, rt_safe_lock():
        if safe:
            rt_safe_snapshot(p["title"])
        if p["rules"] is not None:
            atomic_write(RT_RULES, p["rules"])
        for name, text in p["lists"].items():
            if text is None:
                try:
                    os.remove(os.path.join(RT_LISTS, name + ".list"))
                except OSError:
                    pass
            else:
                rt_write_list(name, text)
        s = rt_apply(rt_compute())
        fetching = any(rt_country_nets(c) is None for c in rt_country_codes()) and rt_country_start()
    if s["errors"]:
        return False, "Saved, but %d route command(s) failed. See the Routes page." % s["errors"]
    return True, "%s: done. %d routes are in place.%s%s%s" % (p["title"], s["routes"],
        " Country data is being downloaded; the routes follow automatically." if fetching else "",
        (" It is undone automatically in %d s unless you press Keep." % RT_SAFE_SECONDS) if safe else "", safe_note)


def routes_post(h, sid, path, f):
    """POST handlers of the Routes page. Returns True when the path was handled."""
    rules, protects, _ = parse_rules_text(rt_read_rules_text())
    names = rt_list_names()
    if path == "/routes/list/save":
        name, text, new = f.get("name", "").strip().lower(), f.get("text", ""), f.get("new") == "1"
        if not NAME_RE.match(name):
            h.send(200, list_edit_page(sid, name, text, ["The name must be lowercase letters, numbers, - or _ (1-32 characters)."], new))
            return True
        if new and name in names:
            h.send(200, list_edit_page(sid, name, text, ["A list with this name already exists."], new))
            return True
        _, errs = parse_list_text(text)
        if errs:
            h.send(200, list_edit_page(sid, name, text, errs[:12], new))
            return True
        stage(sid, "List %s" % name, None, {name: text})
        h.redirect("/routes/review")
    elif path == "/routes/list/delete":
        name = f.get("name", "")
        used = [r for r in rules if r["list"] == name]
        if used:
            FLASH[sid] = (False, "List %s is used by %d rule(s). Delete those rules first." % (name, len(used)))
            h.redirect("/routes")
        else:
            stage(sid, "Delete list %s" % name, None, {name: None})
            h.redirect("/routes/review")
    elif path == "/routes/rule/add":
        lst, via, metric = f.get("list", "").strip(), f.get("via", "").strip(), f.get("metric", "").strip()
        cand = "%s via %s metric %s" % (lst, via, metric)
        if lst not in names:
            FLASH[sid] = (False, "Choose a list first (create one with New list).")
        elif not RULE_RE.match(cand) or not 1 <= int(metric) <= 65535:
            FLASH[sid] = (False, "Next hop looks like 172.17.192.3 or 172.17.192.3@site, and the metric is a number 1-65535.")
        else:
            m = RULE_RE.match(cand)
            rules.append({"list": lst, "via": m.group(2), "site": m.group(3) or "", "metric": int(m.group(4)), "disabled": False})
            stage(sid, "Add rule: %s via %s" % (lst, via), render_rules(rules, protects))
            return h.redirect("/routes/review") or True
        h.redirect("/routes")
    elif path in ("/routes/rule/delete", "/routes/rule/toggle"):
        target = f.get("rule", "").strip()
        idx = next((i for i, r in enumerate(rules) if "%s via %s%s metric %d%s" % (
            r["list"], r["via"], ("@" + r["site"]) if r["site"] else "", r["metric"], " disabled" if r["disabled"] else "") == target), None)
        if idx is None:
            FLASH[sid] = (False, "That rule changed in the meantime. Reload the page.")
            h.redirect("/routes")
        else:
            if path.endswith("delete"):
                del rules[idx]
                title = "Delete rule: %s" % target
            else:
                rules[idx]["disabled"] = not rules[idx]["disabled"]
                title = "%s rule: %s" % ("Turn off" if rules[idx]["disabled"] else "Turn on", target.replace(" disabled", ""))
            stage(sid, title, render_rules(rules, protects))
            h.redirect("/routes/review")
    elif path == "/routes/protect":
        lines = [l.split("#", 1)[0].strip() for l in f.get("text", "").splitlines()]
        lines = [l for l in lines if l]
        bad = []
        for l in lines:
            try:
                parse_entry_any(l)
            except RtError:
                bad.append(l)
        if bad:
            FLASH[sid] = (False, "Not an IPv4 address or network: " + ", ".join(bad[:4]))
            h.redirect("/routes")
        else:
            stage(sid, "Protected addresses", render_rules(rules, lines))
            h.redirect("/routes/review")
    elif path in ("/routes/country/update", "/routes/country/accept"):
        held = list(rt_country_status().get("held", {})) if path.endswith("accept") else []
        if rt_country_start(force=held):
            FLASH[sid] = (True, "Downloading the registry files. This takes up to a minute; reload the page to see the result.")
        else:
            FLASH[sid] = (False, "An update is already running.")
        h.redirect("/routes")
    elif path == "/routes/confirm":
        FLASH[sid] = routes_commit(sid, f.get("safe") == "1")
        h.redirect("/routes")
    elif path in ("/routes/safe/keep", "/routes/safe/undo"):
        keep = path.endswith("keep")
        if rt_safe_end("keep" if keep else "revert", "" if keep else "undone by you"):
            FLASH[sid] = (True, "Change kept." if keep else "Change undone.")
        else:
            FLASH[sid] = (False, "Nothing was waiting (it may have been undone already).")
        h.redirect("/routes")
    elif path == "/routes/cancel":
        PENDING.pop(sid, None)
        h.redirect("/routes")
    else:
        return False
    return True



# ---------- http ----------
class H(http.server.BaseHTTPRequestHandler):
    timeout = 30                 # a stalled connection (also a stalled TLS handshake) is dropped after 30 s
    server_version = "l2tp-gw-web"

    def log_message(self, *a):
        pass

    def send(self, code, data, headers=(), ctype="text/html; charset=utf-8"):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy", "default-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, to, headers=()):
        self.send_response(303)
        self.send_header("Location", to)
        for k, v in headers:
            self.send_header(k, v)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def sid(self):
        now = time.time()
        for k in [k for k, v in SESSIONS.items() if now - v["ts"] > SESSION_TTL]:
            SESSIONS.pop(k, None)
        for part in self.headers.get("Cookie", "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == "sid" and v in SESSIONS:
                SESSIONS[v]["ts"] = now
                return v
        return None

    def form(self, limit=100000):
        n = int(self.headers.get("Content-Length", "0") or 0)
        if n > limit:
            return {}
        d = parse_qs(self.rfile.read(n).decode("utf-8", "replace"), keep_blank_values=True)
        return {k: v[0] for k, v in d.items()}

    def json(self, obj, code=200):
        self.send(code, json.dumps(obj).encode(), ctype="application/json")

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        sid = self.sid()
        if not sid:
            if u.path in ("/live", "/ping"):
                return self.json({"text": "Session expired"}, 401)
            return self.send(200, login_page())
        if u.path == "/":
            return self.send(200, dash_page(sid, FLASH.pop(sid, None)))
        if u.path == "/sites":
            return self.send(200, main_page(sid, FLASH.pop(sid, None)))
        if u.path == "/live":
            if q.get("page", [""])[0] == "dialin":
                return self.json({"html": dialin_list_html(sid), "raw": ""})
            if q.get("page", [""])[0] == "dash":
                return self.json({"html": dash_html(sid), "raw": ""})
            _, st = run([GW, "status"], 30)
            return self.json({"html": live_html(sid), "raw": st})
        if u.path == "/dialin":
            return self.send(200, dialin_page(sid, FLASH.pop(sid, None)))
        if u.path == "/dialin/edit":
            return self.send(200, dialin_edit_page(sid, q.get("name", [None])[0]))
        if u.path == "/dialin/howto":
            return self.send(200, dialin_howto_page(sid, q.get("name", [""])[0]))
        if u.path == "/ping":
            return self.json({"text": self.do_ping(q.get("name", [""])[0])})
        if u.path == "/edit":
            return self.send(200, edit_page(sid, q.get("name", [None])[0]))
        if u.path == "/check":
            return self.send(200, check_page(sid, FLASH.pop(sid, None)))
        if u.path == "/logs":
            return self.send(200, logs_page(sid, q.get("name", [""])[0], 200))
        if u.path == "/backup":
            return self.send(200, backup_page(sid, FLASH.pop(sid, None)))
        if u.path == "/backup/auto":
            fn = (parse_qs(u.query).get("f") or [""])[0]
            fp = os.path.join(AUTOBACKUP_DIR, fn)
            if not (AUTO_RE.fullmatch(fn) and os.path.isfile(fp)):
                return self.send(404, b"not found", [], "text/plain; charset=utf-8")
            return self.send(200, open(fp, "rb").read(), [("Content-Disposition", 'attachment; filename="l2tp-gw-%s"' % fn)], "text/plain; charset=utf-8")
        if u.path == "/backup/download":
            try:
                data = open(SITES, "rb").read()
            except FileNotFoundError:
                data = b""
            try:                  # the dial-in settings (with the IPsec secret) travel in the same file after a marker line
                data += b"#--dialin-settings--\n" + open(DIALIN_CONF, "rb").read()
            except FileNotFoundError:
                pass
            fn = "l2tp-gw-sites-%s.conf" % time.strftime("%Y%m%d-%H%M%S")
            return self.send(200, data, [("Content-Disposition", 'attachment; filename="%s"' % fn)], "text/plain; charset=utf-8")
        if u.path == "/settings":
            return self.send(200, settings_page(sid, FLASH.pop(sid, None)))
        if u.path == "/traffic":
            return self.send(200, traffic_page(sid, FLASH.pop(sid, None)))
        if u.path == "/routes":
            rt_note_viewer(self.client_address[0])
            return self.send(200, routes_page(sid, FLASH.pop(sid, None)))
        if u.path == "/routes/list":
            if q.get("new", [""])[0]:
                return self.send(200, list_edit_page(sid, "", "", None, True))
            nm = q.get("name", [""])[0]
            if nm not in rt_list_names():
                FLASH[sid] = (False, "Unknown list.")
                return self.redirect("/routes")
            return self.send(200, list_edit_page(sid, nm))
        if u.path == "/routes/review":
            return self.send(200, review_page(sid))
        if u.path == "/events":
            try:
                pn = int((q.get("p") or ["1"])[0])
            except ValueError:
                pn = 1
            return self.send(200, events_page(sid, FLASH.pop(sid, None), pn))
        if u.path == "/traffic/archive":
            return self.send(200, archive_page(sid))
        if u.path == "/traffic/archive/csv":
            q = parse_qs(u.query)
            d, n = (q.get("d") or [""])[0], (q.get("n") or [""])[0]
            fp = os.path.join(TRAFFIC_DIR, d, n + ".csv")
            if not (ARCH_RE.fullmatch(d) and NAME_RE.fullmatch(n) and os.path.isfile(fp)):
                return self.send(404, b"not found", [], "text/plain; charset=utf-8")
            out = ["date,download_bytes,upload_bytes"] + ["%s,%d,%d" % (k, v[0], v[1]) for k, v in sorted(read_daily(n, fp).items())]
            return self.send(200, ("\n".join(out) + "\n").encode(),
                             [("Content-Disposition", 'attachment; filename="%s-%s.csv"' % (n, d))], "text/csv; charset=utf-8")
        if u.path == "/traffic/csv":
            out = ["site,date,download_bytes,upload_bytes"]
            try:
                files = sorted(os.listdir(os.path.join(TRAFFIC_DIR, "daily")))
            except OSError:
                files = []
            for fn in files:
                if fn.endswith(".csv"):
                    for d, v in sorted(read_daily(fn[:-4]).items()):
                        out.append("%s,%s,%d,%d" % (fn[:-4], d, v[0], v[1]))
            return self.send(200, ("\n".join(out) + "\n").encode(),
                             [("Content-Disposition", 'attachment; filename="l2tp-gw-traffic.csv"')], "text/csv; charset=utf-8")
        if u.path == "/speed":
            links = {}
            peers = ppp_peers()
            for s in load_sites():
                dev = site_dev(s, peers)
                c = read_iface(dev) if dev else None
                if c:
                    links[s["name"]] = {"rx": c[1], "tx": c[2]}
            nd = main_nic()
            nc = nic_counters(nd) if nd else None
            if nc:       # the page shows "tx" as the download arrow (what the MikroTik receives); for the card it is what we receive
                links["__nic"] = {"rx": nc[1], "tx": nc[0]}
            return self.json({"t": time.time(), "links": links})
        self.send(404, page("Not found", "<p>Page not found. <a href=/sites>Back to sites</a></p>", sid))

    def do_ping(self, name):
        site = next((s for s in load_sites() if s["name"] == name), None)
        if site is None:
            return "Unknown site"
        dev = site_dev(site, ppp_peers())
        _, br = run(["ip", "-br", "a"], 10)
        m = re.search(r"^%s\s.*\speer\s+([0-9.]+)" % re.escape(dev), br, re.M) if dev else None
        if not m:
            return "%s: tunnel is not connected" % name
        rc, out = run(["ping", "-c", "3", "-W", "2", "-I", dev, m.group(1)], 20)
        tail = [l for l in out.splitlines() if "packets transmitted" in l or "rtt" in l]
        return "%s → %s\n%s" % (name, m.group(1), "\n".join(tail) or out[-200:])

    def do_POST(self):
        u = urlparse(self.path)
        f = self.form(1000000 if u.path == "/routes/list/save" else 100000)
        if u.path == "/login":
            c = read_web_conf()
            ip, now = self.client_address[0], time.time()
            wait = login_locked(ip, now)
            if wait:
                return self.send(429, login_page((False, "Too many wrong passwords. Try again in %d minute(s)." % ((wait + 59) // 60))))
            if c["password"] and same_secret(f.get("password", ""), c["password"]):
                LOGIN_FAILS.pop(ip, None)
                sid = secrets.token_urlsafe(32)
                SESSIONS[sid] = {"csrf": secrets.token_urlsafe(24), "ts": time.time()}
                rt_note_viewer(self.client_address[0])        # this machine must never be cut off by a route list
                return self.redirect("/", [("Set-Cookie", "sid=%s; HttpOnly; SameSite=Strict; Path=/%s" % (sid, "; Secure" if WEB_TLS["on"] else ""))])
            login_failed(ip, now)
            time.sleep(1.5)
            return self.send(200, login_page((False, "Wrong password. Try again.")))
        sid = self.sid()
        if not sid or not same_secret(f.get("csrf", ""), csrf_of(sid)):
            return self.send(403, login_page((False, "Session expired. Log in again.")))
        if u.path == "/logout":
            SESSIONS.pop(sid, None)
            return self.redirect("/", [("Set-Cookie", "sid=; Max-Age=0; Path=/")])
        if u.path == "/delete":
            name = f.get("name", "")
            with LOCK:
                cur = load_sites()
                if any(s["name"] == name and is_server(s) for s in cur):
                    FLASH[sid] = (False, "That is a dial-in client. Delete it on the Dial-in page.")
                    return self.redirect("/sites")
                ok, out = save_all([s for s in cur if s["name"] != name])
            if ok:
                add_event("info", "Site %s deleted" % name)
            FLASH[sid] = (ok, ("Deleted " + name) if ok else out)
            return self.redirect("/sites")
        if u.path == "/save":
            return self.save(sid, f)
        if u.path == "/dialin/settings":
            return self.dialin_settings(sid, f)
        if u.path == "/dialin/save":
            return self.dialin_save(sid, f)
        if u.path in ("/dialin/delete", "/dialin/toggle", "/dialin/disconnect"):
            return self.dialin_change(sid, f, u.path.rsplit("/", 1)[1])
        if u.path == "/reconnect":
            name = f.get("name", "")
            with LOCK:
                if any(s["name"] == name and not is_server(s) and s.get("disabled") == "yes" for s in load_sites()):
                    FLASH[sid] = (False, "%s is switched off. Switch it on first." % name)
                elif any(s["name"] == name and not is_server(s) for s in load_sites()):
                    rc, out = run([GW, "reconnect", name], 120)
                    FLASH[sid] = (rc == 0, ("Reconnecting %s. It can take up to a minute to come back." % name) if rc == 0 else out)
                else:
                    FLASH[sid] = (False, "Unknown site.")
            return self.redirect("/sites")
        if u.path == "/toggle":
            name = f.get("name", "")
            with LOCK:
                sites = load_sites()
                cur = next((x for x in sites if x["name"] == name and not is_server(x)), None)
                if cur is None:
                    FLASH[sid] = (False, "Unknown site.")
                    return self.redirect("/sites")
                cur["disabled"] = "" if cur.get("disabled") == "yes" else "yes"
                ok, out = save_all(sites, "site-sync")       # only this site is touched, other tunnels keep running
            word = "off" if cur.get("disabled") == "yes" else "on"
            if ok:
                add_event("info", "Site %s switched %s" % (name, word))
            FLASH[sid] = (ok, ("Switched %s %s. Other tunnels were not touched." % (word, name)) if ok else out)
            return self.redirect("/sites")
        if u.path == "/restore":
            return self.restore(sid, f)
        if u.path == "/settings":
            c = read_notify()
            new = {"telegram_token": f.get("telegram_token", "").strip() or c["telegram_token"],
                   "telegram_chat": f.get("telegram_chat", "").strip(),
                   "down_after_min": f.get("down_after_min", "").strip(),
                   "server_name": f.get("server_name", "").strip(),
                   "dns_flush_min": f.get("dns_flush_min", "").strip(),
                   "tg_send_config": "yes" if f.get("tg_send_config") == "yes" else "no"}
            err = check_notify(new)
            if err:
                return self.send(200, settings_page(sid, (False, err), dict(new, telegram_token=c["telegram_token"])))
            write_notify(new)
            FLASH[sid] = (True, "Alert settings saved.")
            return self.redirect("/settings")
        if u.path.startswith("/routes/") and routes_post(self, sid, u.path, f):
            return
        if u.path == "/traffic/reset":
            name = f.get("name", "")
            if any(s["name"] == name for s in load_sites()) and f.get("all"):
                os.makedirs(TRAFFIC_DIR, exist_ok=True)
                open(os.path.join(TRAFFIC_DIR, "reset-site." + name), "w").close()
                FLASH[sid] = (True, "All numbers of %s will be reset within a few seconds. Old daily reports are moved to an archive folder, not deleted." % name)
            elif any(s["name"] == name for s in load_sites()):
                os.makedirs(TRAFFIC_DIR, exist_ok=True)
                open(os.path.join(TRAFFIC_DIR, "reset." + name), "w").close()
                FLASH[sid] = (True, "Limit counter of %s will be reset within a few seconds. Reports are kept." % name)
            else:
                FLASH[sid] = (False, "Unknown site.")
            return self.redirect("/traffic")
        if u.path == "/settings/general":
            tzname = f.get("tz_custom", "").strip() if f.get("tz_choice") == "__custom__" else f.get("tz_choice", "")
            if not valid_tz(tzname):
                FLASH[sid] = (False, "Unknown time zone name. Use a name like Europe/London.")
            elif f.get("unit") not in UNITS:
                FLASH[sid] = (False, "Unknown unit.")
            else:
                brand = " ".join(f.get("brand", "").split())[:40] or "L2TP gateway"
                write_general({"timezone": tzname, "unit": f["unit"], "brand": brand})
                FLASH[sid] = (True, "Saved. Name: %s, time zone: %s, unit: %s." % (brand, tzname, f["unit"]))
            return self.redirect("/settings")
        if u.path == "/settings/password":
            c = read_web_conf()
            ip, now = self.client_address[0], time.time()
            wait = login_locked(ip, now)
            if wait:
                FLASH[sid] = (False, "Too many wrong passwords. Try again in %d minute(s)." % ((wait + 59) // 60))
            elif not (c["password"] and same_secret(f.get("current", ""), c["password"])):
                login_failed(ip, now)
                time.sleep(1.5)
                FLASH[sid] = (False, "The current password is wrong. Nothing was changed.")
            elif f.get("new1", "") != f.get("new2", ""):
                FLASH[sid] = (False, "The two new passwords are different. Nothing was changed.")
            elif not re.fullmatch(r"[^\s]{8,100}", f.get("new1", "")):
                FLASH[sid] = (False, "The new password needs 8 to 100 characters, without spaces.")
            else:
                c["password"] = f["new1"]
                write_web_conf(c)
                for k in [k for k in SESSIONS if k != sid]:          # every other open session must log in again
                    SESSIONS.pop(k, None)
                add_event("info", "Panel password changed (from %s)" % ip)
                FLASH[sid] = (True, "Password changed. Use the new one next time you log in.")
            return self.redirect("/settings")
        if u.path == "/settings/test":
            rc, out = run([GW, "notify-test"], 40)
            FLASH[sid] = (rc == 0, out or ("Test message sent." if rc == 0 else "Failed."))
            return self.redirect("/" if f.get("back") == "/" else "/settings")
        if u.path == "/settings/reset-stats":
            with open(RESET_FLAG, "w") as fh:          # the collector does the work (it owns the files)
                fh.write("%d\n" % time.time())
            FLASH[sid] = (True, "Reset requested. It takes effect within a few seconds." if collector_alive()
                          else "Reset requested, but the traffic collector is not running. It happens when the collector starts.")
            return self.redirect("/settings")
        self.send(404, page("Not found", "<p>Page not found. <a href=/sites>Back to sites</a></p>", sid))

    def restore(self, sid, f):
        content = f.get("content", "").replace("\r\n", "\n")
        if not content.strip():
            return self.send(200, backup_page(sid, (False, "Paste the file content or choose a file first.")))
        tmp = os.path.join(CONF_DIR, "restore.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(content if content.endswith("\n") else content + "\n")
        try:
            with LOCK:
                rc, out = run([GW, "restore", tmp])
        finally:
            try:
                os.remove(tmp)
            except OSError:
                pass
        if rc != 0:
            return self.send(200, backup_page(sid, (False, out), content))
        FLASH[sid] = (True, "Restored. The VPN services restarted; tunnels reconnect within a minute.")
        return self.redirect("/sites")

    # ---- dial-in handlers
    def dialin_note(self, out):
        """text for the green/red message after a light change; passes on the 'run apply' hint when there is one"""
        hint = [l for l in out.splitlines() if l.startswith("RESTART-NEEDED")]
        return "Saved. " + (hint[0] if hint else "No tunnel was interrupted.")

    def dialin_settings(self, sid, f):
        old = read_dialin()
        new = dict(old)
        new["enabled"] = "yes" if f.get("enabled") else "no"
        new["public_ip"] = f.get("public_ip", "").strip()
        new["pool"] = f.get("pool", "").strip() or "10.99.99.0/24"
        new["local"] = f.get("local", "").strip()
        psk = f.get("psk", "").strip()
        if psk:
            new["psk"] = psk
        elif new["enabled"] == "yes" and not old["psk"]:
            new["psk"] = gen_secret(20)           # first time on: a random secret is made (see it on the Setup page of a client)
        if any(("\n" in x or "\r" in x) for x in new.values()):
            return self.send(200, dialin_page(sid, (False, "Line breaks are not allowed in any field."), new))
        try:
            ipaddress.IPv4Network(new["pool"], strict=False)
        except ValueError:
            return self.send(200, dialin_page(sid, (False, "The address pool must look like 10.99.99.0/24."), new))
        with LOCK:
            try:
                bak = open(DIALIN_CONF, "rb").read()
            except FileNotFoundError:
                bak = None
            write_dialin(new)
            if not os.path.exists(SITES):
                FLASH[sid] = (True, "Settings saved. They are applied when the first site exists.")
                return self.redirect("/dialin")
            rc, out = run([GW, "validate", SITES])
            applied = False
            if rc == 0:
                rc, out = run([GW, "apply"])
                applied = True
            if rc != 0:
                if bak is None:
                    try:
                        os.remove(DIALIN_CONF)
                    except OSError:
                        pass
                else:
                    with os.fdopen(os.open(DIALIN_CONF, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as fh:
                        fh.write(bak)
                if applied:
                    run([GW, "apply"])            # put the services back to the old settings
                return self.send(200, dialin_page(sid, (False, "Not applied, old settings restored.\n" + out), new))
        FLASH[sid] = (True, "Dial-in settings saved and applied. Tunnels reconnect within about a minute.")
        return self.redirect("/dialin")

    def dialin_save(self, sid, f):
        new = {"name": f.get("name", "").strip(), "mode": "server"}
        for k in ("user", "pass", "ip", "routes", "quota_gb", "quota_period", "quota_dir", "quota_warn"):
            new[k] = f.get(k, "").strip()
        new["nat"] = "yes" if f.get("nat") else "no"
        for k in ("internet", "clients", "sites"):       # ticked = allowed (empty, not written), un-ticked = "no"
            new["access_" + k] = "" if f.get("acc_" + k) else "no"
        if not new["quota_gb"]:
            new["quota_period"] = new["quota_dir"] = new["quota_warn"] = ""
        orig = f.get("orig", "")
        keep = dict(new, orig=orig)
        if any(("\n" in x or "\r" in x) for x in new.values()):
            return self.send(200, dialin_edit_page(sid, msg=(False, "Line breaks are not allowed in any field."), vals=keep))
        with LOCK:
            sites = load_sites()
            old = next((s for s in sites if s["name"] == orig and is_server(s)), None) if orig else None
            if orig and old is None:
                return self.send(200, dialin_edit_page(sid, msg=(False, "That client does not exist any more."), vals=keep))
            if new["name"] != orig and any(s["name"] == new["name"] for s in sites):
                return self.send(200, dialin_edit_page(sid, msg=(False, "A site named %s already exists." % new["name"]), vals=keep))
            if old is not None:
                if old.get("disabled"):
                    new["disabled"] = old["disabled"]
                sites[sites.index(old)] = new
            else:
                sites.append(new)
            ok, out = save_all(sites, "dialin-sync")
        if not ok:
            return self.send(200, dialin_edit_page(sid, msg=(False, out), vals=keep))
        FLASH[sid] = (True, self.dialin_note(out))
        return self.redirect("/dialin" if old is not None else "/dialin/howto?name=" + new["name"])

    def dialin_change(self, sid, f, what):
        name = f.get("name", "")
        with LOCK:
            sites = load_sites()
            cur = next((s for s in sites if s["name"] == name and is_server(s)), None)
            if cur is None:
                FLASH[sid] = (False, "Unknown dial-in client.")
                return self.redirect("/dialin")
            if what == "delete":
                sites.remove(cur)
            elif what == "toggle":
                cur["disabled"] = "" if cur.get("disabled") == "yes" else "yes"
            elif what == "disconnect":
                rc, out = run([GW, "disconnect", name], 30)
                FLASH[sid] = (rc == 0, out)
                return self.redirect("/dialin")
            ok, out = save_all(sites, "dialin-sync")
        if ok:
            add_event("info", {"delete": "Dial-in client %s deleted", "toggle": "Dial-in client %s switched off/on"}.get(what, "Dial-in client %s changed") % name)
        FLASH[sid] = (ok, self.dialin_note(out) if ok else out)
        return self.redirect("/dialin")

    def save(self, sid, f):
        new = {"name": f.get("name", "").strip()}
        for k in ("host", "user", "routes"):
            new[k] = f.get(k, "").strip()
        new["mppe"] = "yes" if f.get("mppe") else "no"
        new["nat"] = "yes" if f.get("nat") else "no"
        for k in ("internet", "sites", "clients"):       # ticked = allowed (empty, not written), un-ticked = "no"
            new["access_" + k] = "" if f.get("acc_" + k) else "no"
        for k in ("reconnect_every", "reconnect_at", "reconnect_window", "quota_gb", "quota_period", "quota_dir", "quota_warn"):
            new[k] = f.get(k, "").strip()
        new["ipsec_mode"] = f.get("ipsec_mode", "heal").strip()
        if new["ipsec_mode"] == "heal":               # the default is not written to the file
            new["ipsec_mode"] = ""
        new["lcp_echo"] = "off" if f.get("lcp_echo", "on").strip() == "off" else ""    # on = default, not written
        if not new["quota_gb"]:                       # no limit: the other limit settings mean nothing
            new["quota_period"] = new["quota_dir"] = new["quota_warn"] = ""
        orig = f.get("orig", "")
        with LOCK:
            sites = load_sites()
            old = next((s for s in sites if s["name"] == orig), None) if orig else None
            if old is not None and is_server(old):
                return self.send(200, edit_page(sid, msg=(False, "That is a dial-in client. Edit it on the Dial-in page.")))
            if old is not None and old.get("disabled"):
                new["disabled"] = old["disabled"]          # editing a switched-off site does not switch it on
            new["psk"] = f.get("psk", "") or (old or {}).get("psk", "")
            new["pass"] = f.get("pass", "") or (old or {}).get("pass", "")
            keep = dict(new, orig=orig)
            if any(("\n" in x or "\r" in x) for x in new.values()):
                return self.send(200, edit_page(sid, msg=(False, "Line breaks are not allowed in any field."), vals=keep))
            if not new["psk"] or not new["pass"]:
                return self.send(200, edit_page(sid, msg=(False, "Enter the IPsec secret and the PPP password."), vals=keep))
            if new["name"] != orig and any(s["name"] == new["name"] for s in sites):
                return self.send(200, edit_page(sid, msg=(False, "A site named %s already exists." % new["name"]), vals=keep))
            only_access = False
            if old is not None:
                # same site, only the "what may it reach" boxes differ -> no tunnel needs a restart
                same = lambda k: (old.get(k, "") or "") == (new.get(k, "") or "")
                only_access = all(same(k) for k in KEYS if not k.startswith("access_") and k not in ("disabled", "mode"))
                sites[sites.index(old)] = new
            else:
                sites.append(new)
            ok, out = save_all(sites, "site-sync" if only_access else "apply")
        if not ok:
            return self.send(200, edit_page(sid, msg=(False, out), vals=keep))
        FLASH[sid] = (True, "Saved and applied: " + new["name"])
        return self.redirect("/sites")


WEB_CERT = os.path.join(CONF_DIR, "web.crt")
WEB_KEY = os.path.join(CONF_DIR, "web.key")
WEB_TLS = {"on": False}          # set by cmd_run; the cookie then gets the Secure flag
LOGIN_FAILS = {}                 # client address -> times of recent wrong passwords
LOGIN_MAX, LOGIN_WINDOW, LOGIN_LOCK = 5, 600, 300     # 5 wrong passwords in 10 minutes lock that address for 5 minutes


def login_locked(ip, now):
    """-> seconds still locked (0 = free to try). Also forgets old failures."""
    t = [x for x in LOGIN_FAILS.get(ip, []) if now - x < LOGIN_WINDOW]
    if t:
        LOGIN_FAILS[ip] = t
    else:
        LOGIN_FAILS.pop(ip, None)
    if len(t) >= LOGIN_MAX:
        return max(0, int(LOGIN_LOCK - (now - t[-1])))
    return 0


def login_failed(ip, now):
    LOGIN_FAILS.setdefault(ip, []).append(now)
    if len(LOGIN_FAILS) > 2000:                      # never grow without limit
        for k in sorted(LOGIN_FAILS, key=lambda k: LOGIN_FAILS[k][-1])[:1000]:
            del LOGIN_FAILS[k]


def web_cert():
    """make the self-signed certificate once (10 years). Only the owner can read the key."""
    if os.path.exists(WEB_CERT) and os.path.exists(WEB_KEY):
        return
    os.makedirs(CONF_DIR, exist_ok=True)
    rc, out = run(["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-days", "3650", "-subj", "/CN=l2tp-gw",
                   "-keyout", WEB_KEY, "-out", WEB_CERT], 60)
    if rc != 0:
        sys.exit("Could not create the certificate (is openssl installed? apt install openssl): " + out[-200:])
    os.chmod(WEB_KEY, 0o600)


class Srv(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    ctx = None                   # TLS context when HTTPS is on

    def get_request(self):
        sock, addr = self.socket.accept()
        if self.ctx:
            # the handshake happens later, in the connection's own thread, under the handler timeout:
            # a client that stalls cannot block the other visitors
            sock = self.ctx.wrap_socket(sock, server_side=True, do_handshake_on_connect=False)
        return sock, addr

    def handle_error(self, request, client_address):
        # scanners, plain HTTP on the HTTPS port, dropped connections: normal on the internet, not worth a traceback
        import ssl
        if isinstance(sys.exc_info()[1], (ssl.SSLError, ConnectionError, TimeoutError, OSError)):
            return
        super().handle_error(request, client_address)


# ---------- commands ----------
def cmd_run():
    c = read_web_conf()
    if not c["password"]:
        sys.exit("No password set. Run: l2tp-gw-web install")
    srv = Srv((c["bind"], int(c["port"])), H)
    if c.get("tls", "off").lower() == "on":
        import ssl
        web_cert()
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(WEB_CERT, WEB_KEY)
        srv.ctx = ctx
        WEB_TLS["on"] = True
    srv.serve_forever()


def cmd_setpass():
    import getpass
    p = getpass.getpass("New password (min 8 chars): ")
    if len(p) < 8 or p != getpass.getpass("Again: "):
        sys.exit("Not changed (too short or different).")
    c = read_web_conf(); c["password"] = p; write_web_conf(c)
    run(["systemctl", "restart", "l2tp-gw-web"], 30)
    print("Password changed.")


def cmd_install():
    if os.geteuid() != 0:
        sys.exit("Run as root (sudo -i)")
    c = read_web_conf()
    new = not c["password"]
    if new:
        c["password"] = secrets.token_urlsafe(12)
    write_web_conf(c)
    path = os.path.abspath(sys.argv[0])
    with open(UNIT, "w") as f:
        f.write("[Unit]\nDescription=l2tp-gw web page\nAfter=network.target\n\n[Service]\n"
                "ExecStart=/usr/bin/python3 %s run\nRestart=always\n\n[Install]\nWantedBy=multi-user.target\n" % path)
    # second service: traffic statistics, auto reconnect, limit warnings (see "traffic collector" above)
    # it starts after xl2tpd, so at shutdown it stops BEFORE xl2tpd and can still read the last counters
    with open(os.path.join(os.path.dirname(UNIT), "l2tp-gw-collect.service"), "w") as f:
        f.write("[Unit]\nDescription=l2tp-gw traffic collector\nAfter=network.target xl2tpd.service\n\n[Service]\n"
                "ExecStart=/usr/bin/python3 %s collect\nRestart=always\nTimeoutStopSec=20\n\n[Install]\nWantedBy=multi-user.target\n" % path)
    run(["systemctl", "daemon-reload"], 30)
    rc, out = run(["systemctl", "enable", "--now", "l2tp-gw-web", "l2tp-gw-collect"], 30)
    run(["systemctl", "restart", "l2tp-gw-web", "l2tp-gw-collect"], 30)
    print("Web page installed. Listening on %s:%s" % (c["bind"], c["port"]))
    print("Traffic collector installed (statistics, auto reconnect, limit warnings).")
    if new:
        print("Login password: %s   (change later: l2tp-gw-web setpass)" % c["password"])
    if rc != 0:
        print(out)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    {"run": cmd_run, "collect": cmd_collect, "install": cmd_install, "setpass": cmd_setpass}.get(cmd, lambda: print("\n".join(l[2:] for l in open(__file__).read().splitlines()[1:7])))()
