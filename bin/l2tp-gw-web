        held = cst.get("held", {}).get(c)
        crow += "<tr><td class=mono><b>%s</b></td><td>%s</td><td>%s</td></tr>" % (
            e(c), ("%d networks, %s addresses" % (info["prefixes"], format(info["addresses"], ","))) if info else "<span class='rtst warn'>no data yet</span>",
