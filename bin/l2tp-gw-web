            "<div class=two><div><label for=qdir>Counts</label><select id=qdir name=quota_dir>%s</select></div>"
            "<div><label for=qwarn>Warn at (%% of the limit)</label>"
            "<input type=text id=qwarn name=quota_warn value='%s' class=mono placeholder='80'></div></div></fieldset>"
            "<p style='margin-top:22px'><button class='btn pri' data-busy='Applying, please wait...'>Save and apply</button> "
            "<a class=btn href=/sites>Cancel</a></p></form>"
            % ("Edit site" if editing else "Add site", e(csrf_of(sid)), e(s.get("orig", s.get("name", "") if editing else "")),
               v("name"), v("host"), keep, ph, v("user"), keep, ph,
               "checked" if s.get("mppe") == "yes" else "", "checked" if s.get("nat") == "yes" else "", v("routes"), acc_html,
               options([("heal", "Alert and repair automatically (recommended)"),
                        ("allow", "Allow without IPsec (no alerts, no repair)"),
                        ("require", "Require IPsec (repair quickly, never leave it plain)")], s.get("ipsec_mode") or "heal"),
               options([("on", "On (recommended)"), ("off", "Off")], s.get("lcp_echo") or "on"),
               v("reconnect_every"), v("reconnect_at"), v("reconnect_window"), v("quota_gb"),
               options([("day", "day"), ("week", "week (Monday-Sunday)"), ("month", "month")], s.get("quota_period") or "day"),
               options([("total", "download + upload"), ("download", "download only"), ("upload", "upload only")], s.get("quota_dir") or "total"),
               v("quota_warn")))
    return page("Edit site" if editing else "Add site", body, sid, msg)


# ================= dial-in (this server is the L2TP SERVER; routers without a public address dial in) =================
# Shared settings live in CONF_DIR/dialin.conf (enabled, public_ip, psk, pool, local); every client is a site with
# "mode = server" in sites.conf. A change to one client uses "l2tp-gw dialin-sync" (nothing restarts). A change of the
# shared settings uses "l2tp-gw apply" (xl2tpd and strongSwan restart: all tunnels reconnect within a minute).
def read_dialin():
    c = {"enabled": "no", "public_ip": "", "psk": "", "pool": "10.99.99.0/24", "local": ""}
    try:
        for line in open(DIALIN_CONF):
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                if k.strip() in c:
                    c[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    return c


def write_dialin(c):
    os.makedirs(CONF_DIR, exist_ok=True)
    tmp = DIALIN_CONF + ".new"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("# l2tp-gw dial-in settings (written by l2tp-gw-web). Contains the IPsec secret: keep it private.\n")
        for k in ("enabled", "public_ip", "psk", "pool", "local"):
            if c.get(k) or k in ("enabled", "pool"):
                f.write("%s = %s\n" % (k, c.get(k, "")))
    os.replace(tmp, DIALIN_CONF)
    os.chmod(DIALIN_CONF, 0o600)


def gen_secret(n=16):
    a = string.ascii_letters + string.digits
    return "".join(secrets.choice(a) for _ in range(n))


def dialin_local_ip(c):
    if c.get("local"):
        return c["local"]
    base = c["pool"].split("/")[0].split(".")          # same rule as l2tp-gw: network address + 1
    try:
        base[3] = str(int(base[3]) + 1)
    except (IndexError, ValueError):
        return ""
    return ".".join(base)


def dialin_next_ip(c, sites):
    """first free client address of the pool ('' when the pool is full or not valid)"""
    try:
        net = ipaddress.IPv4Network(c["pool"], strict=False)
    except ValueError:
        return ""
    used = {s.get("ip") for s in sites if is_server(s)} | {dialin_local_ip(c)}
    for h in net.hosts():
        if str(h) not in used:
            return str(h)
    return ""


def dialin_listening():
    """True when something listens on UDP 1701 (xl2tpd), None when ss cannot tell"""
    rc, out = run(["ss", "-Hlun"], 10)
    if rc != 0:
        return None
    return bool(re.search(r"[:.]1701\s", out))


def dialin_list_html(sid):
    """the client list: refreshed every 10 seconds like the Sites page"""
    e = html.escape
    ppp, _ = live_status()
    st, gen = read_state(), read_general()
    unit = gen["unit"]
    tz = get_tz(gen["timezone"])
    today = datetime.now(tz).date().isoformat()
    clients = [s for s in load_sites() if is_server(s)]
    csrf = e(csrf_of(sid))
    if not clients:
        return ("<div class=list><div class=empty><p><b>No dial-in clients yet</b></p>"
                "<p>Add a router that should dial in to this server.</p>"
                "<a class='btn pri' href=/dialin/edit>Add client</a></div></div>")
    rows, up_n = "", 0
    for s in clients:
        n = s["name"]
        off = s.get("disabled") == "yes"
        up = n in ppp and not off
        if up:
            up_n += 1
        cls, txt = ("down", "Disabled") if off else ("up", "Connected") if up else ("half", "Waiting for the router to dial in")
        link = st["links"].get(n)
        since = ""
        if up and link:
            mins = int((time.time() - link["since"]) // 60)
            since = "up %dh %02dm" % (mins // 60, mins % 60)
        dl = read_daily(n).get(today, [0, 0])
        extra = ("<div class='speed mono' data-speed='%s'>&darr; - &nbsp;&uarr; -</div>" % e(n)) if up else ""
        extra += "<div class=qtxt>today &darr; %s &uarr; %s</div>" % (e(fmt_bytes(dl[0], unit)), e(fmt_bytes(dl[1], unit)))
        extra += quota_html(s, st, unit)
        chips = "".join("<span class='chip mono'>%s</span>" % e(r.strip()) for r in s.get("routes", "").split(",") if r.strip())
        tags = "<span class='chip tag'>NAT</span>" if s.get("nat") == "yes" else ""
        for k, label in (("internet", "no internet"), ("clients", "no other clients"), ("sites", "no outgoing sites")):
            if s.get("access_" + k) == "no":
                tags += "<span class='chip tag'>%s</span>" % label
        rows += ("<div class=row><div class='rail %s'></div>"
                 "<div><div class=name>%s</div><div class='host mono'>%s &middot; %s</div></div>"
                 "<div><div class='state %s'>%s</div><div class='addr mono'>%s</div>%s</div>"
                 "<div class=chips>%s%s</div>"
                 "<div class=acts>"
                 "<button class='btn sm' onclick=\"ping('%s',this)\"%s>Ping</button>"
                 "<form method=post action=/dialin/disconnect onsubmit=\"return confirm('End the live session of %s? The router may dial in again.')\">"
                 "<input type=hidden name=csrf value='%s'><input type=hidden name=name value='%s'><button class='btn sm'%s>Disconnect</button></form>"
                 "<form method=post action=/dialin/toggle><input type=hidden name=csrf value='%s'><input type=hidden name=name value='%s'>"
                 "<button class='btn sm'>%s</button></form>"
                 "<a class='btn sm' href='/dialin/howto?name=%s'>Setup</a>"
                 "<a class='btn sm' href='/dialin/edit?name=%s'>Edit</a>"
                 "<form method=post action=/dialin/delete onsubmit=\"return confirm('Delete client %s?')\">"
                 "<input type=hidden name=csrf value='%s'><input type=hidden name=name value='%s'><button class='btn sm del'>Delete</button></form>"
                 "</div></div>"
                 % (cls, e(n), e(s.get("user", "")), e(s.get("ip", "")), cls, txt,
                    e(ppp.get(n, "").replace(" peer ", " → ").replace("/32", "")) if up else since, extra,
                    chips or "<span class=none>No routes</span>", tags,
                    e(n), "" if up else " disabled title='Not connected'", e(n), csrf, e(n), "" if up else " disabled",
                    csrf, e(n), "Enable" if off else "Disable", e(n), e(n), e(n), csrf, e(n)))
    return ("<div class=sum style='margin-bottom:8px'>%d of %d clients connected</div><div class=list>%s</div>"
            % (up_n, len(clients), rows))


