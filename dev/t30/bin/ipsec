#!/bin/bash
# like t27's stub, but when ipsec.seq exists the first "status" prints ipsec.status and every later one ipsec.status2
D=$(dirname $0)/..
case "$1" in
 status) [ -f $D/ipsec.fail ] && exit 2
   if [ -f $D/ipsec.seq ]; then n=$(cat $D/ipsec.calls 2>/dev/null || echo 0); echo $((n+1)) > $D/ipsec.calls; if [ "$n" = 0 ]; then cat $D/ipsec.status; else cat $D/ipsec.status2; fi
   else cat $D/ipsec.status; fi;;
 statusall) cat $D/ipsec.status;;
 up|down) echo "ipsec $*" >> $D/calls; echo "connection '$2' established successfully";;
esac
